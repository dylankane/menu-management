# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Each client gets their own PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/restaurant_menu"

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"       # "development" | "production"
PORT=3000

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# Generate a strong random secret for each client: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"         # Token lifetime — adjust per client preference

# ─── CLIENT BRANDING ──────────────────────────────────────────────────────────
# Shown in the browser tab, admin header, and customer menu page
RESTAURANT_NAME="My Restaurant"

# Full public URL of this instance (no trailing slash).
# Used for QR code generation and absolute links.
APP_URL="http://localhost:3000"

# ─── FILE UPLOADS ─────────────────────────────────────────────────────────────
# Max image size in bytes (default 5MB)
MAX_UPLOAD_SIZE=5242880
# Saved under public/uploads — relative to project root
UPLOAD_DIR="public/uploads"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Since admin + menu are served by the same Express app this is usually unused,
# but set it if you embed the menu on an external site.
CORS_ORIGINS="http://localhost:3000"

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
# Requests per window per IP on API routes
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100

