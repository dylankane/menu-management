<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= restaurantName %> - Menu</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/menu.css">
</head>
<body>
  <div class="menu-container">
    <header class="menu-header">
      <h1 class="restaurant-name">Lumière</h1>
      <p class="menu-subtitle">Cuisine Française Contemporaine</p>
      <div class="menu-divider"></div>
    </header>

    <% if (categories && categories.length > 0) { %>
      <nav id="categoryNav" class="category-nav">
        <div class="category-nav-inner">
          <% categories.forEach((category, index) => { %>
            <% const categoryTrans = pickT(category.translations); %>
            <a href="#category-<%= category.id %>" class="category-nav-link<%= index === 0 ? ' active' : '' %>" data-category="<%= category.id %>">
              <%= categoryTrans.name || 'Category' %>
            </a>
          <% }); %>
        </div>
      </nav>
    <% } %>

    <main class="menu-content">
      <% if (categories && categories.length > 0) { %>
        <% categories.forEach(category => { %>
          <% const categoryTrans = pickT(category.translations); %>
          <section class="category-section" id="category-<%= category.id %>">
            <div class="category-header">
              <h2 class="category-title"><%= categoryTrans.name || 'Category' %></h2>
              <% if (categoryTrans.description) { %>
                <p class="category-description"><%= categoryTrans.description %></p>
              <% } %>
            </div>

            <% if (category.menu_item_categories && category.menu_item_categories.length > 0) { %>
              <div class="menu-items-grid">
                <% category.menu_item_categories.forEach(mic => { %>
                  <% if (mic.menu_item && mic.menu_item.is_available) { %>
                    <%- include('../partials/menu-item', { 
                      item: mic.menu_item, 
                      pickT: pickT,
                      lang: lang 
                    }) %>
                  <% } %>
                <% }); %>
              </div>
            <% } %>

            <% if (category.children && category.children.length > 0) { %>
              <% category.children.forEach(subcategory => { %>
                <% const subTrans = pickT(subcategory.translations); %>
                <% if (subcategory.menu_item_categories && subcategory.menu_item_categories.length > 0) { %>
                  <div class="subcategory-section">
                    <div class="subcategory-header">
                      <h3 class="subcategory-title"><%= subTrans.name || 'Subcategory' %></h3>
                      <% if (subTrans.description) { %>
                        <p class="subcategory-description"><%= subTrans.description %></p>
                      <% } %>
                    </div>
                    <div class="menu-items-grid">
                      <% subcategory.menu_item_categories.forEach(mic => { %>
                        <% if (mic.menu_item && mic.menu_item.is_available) { %>
                          <%- include('../partials/menu-item', { 
                            item: mic.menu_item, 
                            pickT: pickT,
                            lang: lang 
                          }) %>
                        <% } %>
                      <% }); %>
                    </div>
                  </div>
                <% } %>
              <% }); %>
            <% } %>
          </section>
        <% }); %>
      <% } else { %>
        <div class="category-section">
          <div class="category-header">
            <p class="category-description">Menu coming soon...</p>
          </div>
        </div>
      <% } %>
    </main>

    <footer class="menu-footer">
      <p class="menu-footer-text">Bon Appétit</p>
    </footer>
  </div>

  <div id="imageModal" class="image-modal">
    <button class="image-modal-close" aria-label="Close">&times;</button>
    <div class="image-modal-content">
      <img id="modalImage" class="image-modal-img" src="" alt="">
    </div>
  </div>

  <script src="/js/menu.js"></script>
</body>
</html>
