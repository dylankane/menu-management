<!-- Mobile top bar (hidden on desktop) -->
<div class="mobile-bar">
  <button class="mobile-bar__hamburger" onclick="openSidebar()" aria-label="Open navigation">
    <span></span><span></span><span></span>
  </button>
  <span class="mobile-bar__name"><%= restaurantName %></span>
  <%- include('./lang-selector') %>
</div>

<!-- Sidebar overlay (shown on mobile when sidebar is open) -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Fixed left sidebar navigation -->
<aside class="sidebar bg-dark">
  <div class="sidebar__header">
    <img src="/media/logo-light.png" alt="<%= restaurantName %>" class="sidebar__logo">
    <h1 class="sidebar__restaurant-name"><%= restaurantName %></h1>
    <p class="sidebar__label">Admin Dashboard</p>
  </div>

  <nav class="sidebar__nav">

    <a href="/admin" class="sidebar__link <%= current === 'dashboard' ? 'sidebar__link--active' : '' %>">
      <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#dashboard"></use></svg>
      Dashboard
    </a>

    <% if (features.menu) { %>
    <hr />

    <!-- ── MENU ─────────────────────────────────────────────────────── -->
    <div class="sidebar__section" id="section-menu">
      <button class="sidebar__section-title" onclick="toggleSection('section-menu')">
        <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#menu-items"></use></svg>
        <span>Menu</span>
        <svg class="icon sidebar__section-chevron"><use href="/icons/sprite.svg#chevron-down"></use></svg>
      </button>
      <div class="sidebar__section-links">
        <a href="/admin/builder" class="sidebar__link <%= current === 'builder' ? 'sidebar__link--active' : '' %>">
          <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#menu-builder"></use></svg>
          Builder
        </a>
        <a href="/admin/menu-items" class="sidebar__link <%= current === 'menu-items' ? 'sidebar__link--active' : '' %>">
          <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#menu-items"></use></svg>
          Menu Items
        </a>
        <a href="/admin/set-menus" class="sidebar__link <%= current === 'set-menus' ? 'sidebar__link--active' : '' %>">
          <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#set-menus"></use></svg>
          Set Menus
        </a>
        <a href="/admin/tags" class="sidebar__link <%= current === 'tags' ? 'sidebar__link--active' : '' %>">
          <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#tags"></use></svg>
          Allergens &amp; Dietary
        </a>
        <a href="/menu" target="_blank" class="sidebar__link">
          <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#eye"></use></svg>
          Preview Menu
        </a>
      </div>
    </div>
    <% } %>

    <!-- ── RESTAURANT HUB ──────────────────────────────────────────── -->
    <% if (features.restaurantHub) { %>
    <a href="/admin/restaurant" class="sidebar__section-title <%= current === 'restaurant' ? 'sidebar__section-title--active' : '' %>">
      <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#building"></use></svg>
      <span>Restaurant Hub</span>
    </a>
    <% } %>

    <!-- ── GOURMET CLUB ───────────────────────────────────────────── -->
    <% if (features.gourmetClub) { %>
    <div class="sidebar__section" id="section-gourmet-club">
      <button class="sidebar__section-title" onclick="toggleSection('section-gourmet-club')">
        <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#star"></use></svg>
        <span>Gourmet Club</span>
        <svg class="icon sidebar__section-chevron"><use href="/icons/sprite.svg#chevron-down"></use></svg>
      </button>
      <div class="sidebar__section-links">
        <a href="/admin/gourmet-club" class="sidebar__link <%= current === 'gourmet-club-dashboard' ? 'sidebar__link--active' : '' %>">
          <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#dashboard"></use></svg>
          Overview
        </a>
        <a href="/admin/gourmet-club/members" class="sidebar__link <%= current === 'members' ? 'sidebar__link--active' : '' %>">
          <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#users"></use></svg>
          Members
        </a>
      </div>
    </div>
    <% } %>

    <hr />

    <a href="/admin/settings" class="sidebar__link <%= current === 'settings' ? 'sidebar__link--active' : '' %>">
      <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#settings"></use></svg>
      Settings
    </a>
    <a href="/admin/profile" class="sidebar__link <%= current === 'profile' ? 'sidebar__link--active' : '' %>">
      <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#user"></use></svg>
      Profile
    </a>
    <% if (user.role === 'super_admin') { %>
    <a href="/admin/config" class="sidebar__link <%= current === 'config' ? 'sidebar__link--active' : '' %>">
      <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#lock"></use></svg>
      Config
    </a>
    <% } %>
    <a href="/admin/logout" class="sidebar__link sidebar__link--danger">
      <svg class="icon sidebar__icon"><use href="/icons/sprite.svg#logout"></use></svg>
      Logout
    </a>

  </nav>

  <div class="sidebar__footer">
    <p class="sidebar__footer-label">Logged in as</p>
    <p class="sidebar__footer-name"><%= user.name || user.email %></p>
  </div>
</aside>

<script>
  const SIDEBAR_SECTIONS = [<%- features.menu ? "'section-menu'" : '' %>, <%- features.gourmetClub ? "'section-gourmet-club'" : '' %>].filter(Boolean);

  const SECTION_PAGES = {
    'section-menu':         ['builder', 'menu-items', 'set-menus', 'tags'],
    'section-gourmet-club': ['gourmet-club-dashboard', 'members'],
  };

  const CURRENT_PAGE = '<%= current %>';

  function openSidebar() {
    document.querySelector('.sidebar').classList.add('sidebar--open');
    document.getElementById('sidebarOverlay').classList.add('sidebar-overlay--visible');
    document.body.classList.add('sidebar-open');
  }

  function closeSidebar() {
    document.querySelector('.sidebar').classList.remove('sidebar--open');
    document.getElementById('sidebarOverlay').classList.remove('sidebar-overlay--visible');
    document.body.classList.remove('sidebar-open');
  }

  function toggleSection(id) {
    document.getElementById(id).classList.toggle('sidebar__section--collapsed');
  }

  (function initSidebarSections() {
    SIDEBAR_SECTIONS.forEach(id => {
      const isActive = (SECTION_PAGES[id] || []).includes(CURRENT_PAGE);
      document.getElementById(id).classList.toggle('sidebar__section--collapsed', !isActive);
    });
  })();
</script>
