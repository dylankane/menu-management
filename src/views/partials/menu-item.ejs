<% 
  const itemTrans = pickT(item.translations);
  const itemName = itemTrans.name || 'Menu Item';
  const itemDescription = itemTrans.description || '';
  const itemPublicNotes = itemTrans.public_notes || '';
  
  const finalPrice = item.has_discount 
    ? (item.discount_type === 'percent' 
        ? parseFloat(item.price) * (1 - parseFloat(item.discount_value) / 100)
        : parseFloat(item.price) - parseFloat(item.discount_value))
    : parseFloat(item.price);
%>

<article class="menu-item" data-item-id="<%= item.id %>">
  <div class="menu-item-header">
    <h4 class="menu-item-name"><%= itemName %></h4>
    <span class="menu-item-price">€<%= finalPrice.toFixed(2) %></span>
  </div>
  
  <% if (itemDescription) { %>
    <p class="menu-item-description"><%= itemDescription %></p>
  <% } %>
  
  <% if (itemPublicNotes) { %>
    <div class="public-notes"><%= itemPublicNotes %></div>
  <% } %>
  
  <% if ((item.allergens && item.allergens.length > 0) || (item.dietary && item.dietary.length > 0) || item.is_special) { %>
    <div class="menu-item-tags">
      <% if (item.is_special) { %>
        <span class="tag tag-special">Chef's Special</span>
      <% } %>
      
      <% if (item.dietary && item.dietary.length > 0) { %>
        <% item.dietary.forEach(d => { %>
          <% const dietaryTrans = pickT(d.dietary_tag.translations); %>
          <span class="tag tag-dietary"><%= dietaryTrans.name || 'Dietary' %></span>
        <% }); %>
      <% } %>
      
      <% if (item.allergens && item.allergens.length > 0) { %>
        <% item.allergens.forEach(a => { %>
          <% const allergenTrans = pickT(a.allergen.translations); %>
          <span class="tag tag-allergen"><%= allergenTrans.name || 'Allergen' %></span>
        <% }); %>
      <% } %>
    </div>
  <% } %>
  
  <% if (item.image_url) { %>
    <button 
      class="menu-item-image-trigger" 
      data-image="<%= item.image_url %>"
      data-name="<%= itemName %>"
      data-description="<%= itemDescription %>"
      type="button"
    >
      image
    </button>
  <% } %>
</article>
