<%
  // item.translations is the full array; pickT is passed from the route helper
  const tr = pickT(item.translations);
  const name = tr.name || '';
  const desc = tr.description || '';

  // Calculate discounted price if applicable
  let displayPrice = Number(item.price);
  let originalPrice = null;
  if (item.has_discount && item.discount_value) {
    originalPrice = displayPrice;
    if (item.discount_type === 'percent') {
      displayPrice = displayPrice * (1 - Number(item.discount_value) / 100);
    } else {
      displayPrice = displayPrice - Number(item.discount_value);
    }
    displayPrice = Math.max(0, displayPrice);
  }
%>
<div class="menu-item">
  <div class="menu-item__inner">

    <% if (item.image_url) { %>
      <img src="<%= item.image_url %>" alt="<%= name %>" class="menu-item__image" />
    <% } %>

    <div class="menu-item__body">
      <div class="menu-item__top">
        <div class="menu-item__info">
          <h4 class="menu-item__name">
            <%= name %>
            <% if (item.is_special) { %><span class="menu-item__special">⭐</span><% } %>
          </h4>
          <% if (desc) { %>
            <p class="menu-item__desc"><%= desc %></p>
          <% } %>
        </div>

        <div class="menu-item__price">
          <% if (originalPrice !== null) { %>
            <p class="menu-item__price-original">€<%= originalPrice.toFixed(2) %></p>
            <p class="menu-item__price-current">€<%= displayPrice.toFixed(2) %></p>
          <% } else { %>
            <p class="menu-item__price-current">€<%= displayPrice.toFixed(2) %></p>
          <% } %>
        </div>
      </div>

      <%
        const hasTags = (item.dietary && item.dietary.length > 0) ||
                        (item.allergens && item.allergens.length > 0);
      %>
      <% if (hasTags) { %>
        <div class="menu-item__tags">
          <% if (item.dietary) { item.dietary.forEach(d => {
            const dT = pickT(d.dietary_tag.translations);
          %>
            <span class="menu-tag menu-tag--dietary"><%= dT.name || '' %></span>
          <% }) } %>
          <% if (item.allergens) { item.allergens.forEach(a => {
            const aT = pickT(a.allergen.translations);
          %>
            <span class="menu-tag menu-tag--allergen" title="Contains: <%= aT.name || '' %>">
              <%= aT.name || '' %>
            </span>
          <% }) } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
