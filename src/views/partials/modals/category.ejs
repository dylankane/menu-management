<!-- ── Add / Edit Category Modals ──────────────────────────────────────────── -->
<!-- Requires in scope: langs, primary, categories                             -->

<!-- Add Category Modal (also used for subcategories via addCatParentId)  -->
<div id="addCatModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title" id="addCatModalTitle">Add Category</h3>
      <button onclick="closeModal('addCatModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="addCatParentId" value="" />
      <div id="addSubWarning" class="alert alert--warning hidden">
        <svg class="icon" style="width:1rem;height:1rem;flex-shrink:0;"><use href="/icons/sprite.svg#warning"></use></svg>
        <span>This category has items assigned directly. Adding a subcategory will strand those items — move them to a subcategory afterwards.</span>
      </div>
      <div data-lang-container>
        <div class="lang-tabs">
          <% langs.forEach((lang, i) => { %>
            <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
              data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
              <%= lang.toUpperCase() %>
            </button>
          <% }) %>
        </div>
        <% langs.forEach((lang, i) => { %>
          <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
            <div class="form-group">
              <label class="form-label">Name (<%= lang.toUpperCase() %>)</label>
              <input type="text" id="addCatName_<%= lang %>" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label">Description (<%= lang.toUpperCase() %>)</label>
              <input type="text" id="addCatDesc_<%= lang %>" class="form-input" placeholder="Optional" />
            </div>
          </div>
        <% }) %>
      </div>
      <div class="form-group">
        <label class="form-label">Slug <span class="hint">(auto-generated, can override)</span></label>
        <input type="text" id="addCatSlug" class="form-input" placeholder="e.g. starters" />
      </div>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="closeModal('addCatModal')" class="btn btn--secondary">Cancel</button>
      <button type="button" onclick="submitAddCategory()" class="btn btn--primary">Save</button>
    </div>
  </div>
</div>

<!-- Edit Category Modal -->
<div id="editCatModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title">Edit Category</h3>
      <button onclick="closeModal('editCatModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="editCatId" />
      <div data-lang-container>
        <div class="lang-tabs">
          <% langs.forEach((lang, i) => { %>
            <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
              data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
              <%= lang.toUpperCase() %>
            </button>
          <% }) %>
        </div>
        <% langs.forEach((lang, i) => { %>
          <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
            <div class="form-group">
              <label class="form-label">Name (<%= lang.toUpperCase() %>)</label>
              <input type="text" id="editCatName_<%= lang %>" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label">Description (<%= lang.toUpperCase() %>)</label>
              <input type="text" id="editCatDesc_<%= lang %>" class="form-input" />
            </div>
          </div>
        <% }) %>
      </div>
      <div class="form-group">
        <label class="form-label">Parent Category</label>
        <select id="editCatParentId" class="form-select">
          <option value="">— None (top-level) —</option>
          <% categories.filter(c => !c.parent_id).forEach(c => { %>
            <option value="<%= c.id %>"><%= (c.translations || []).find(t => t.lang === primary)?.name || c.slug %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Slug</label>
        <input type="text" id="editCatSlug" class="form-input" />
      </div>
      <label class="form-check">
        <input type="checkbox" id="editCatIsActive" />
        <span class="form-check__label">Active (visible on menu)</span>
      </label>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="closeModal('editCatModal')" class="btn btn--secondary">Cancel</button>
      <button type="button" onclick="submitEditCategory()" class="btn btn--primary">Save Changes</button>
    </div>
  </div>
</div>

<script>
  // Auto-generate slug from primary-language name field
  document.getElementById('addCatName_' + PRIMARY)?.addEventListener('input', function () {
    const slug = this.value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')
      .replace(/[^a-z0-9\s-]/g,'').trim().replace(/\s+/g,'-').replace(/-+/g,'-');
    document.getElementById('addCatSlug').value = slug;
  });

  function openAddCategoryModal() {
    document.getElementById('addCatParentId').value = '';
    document.getElementById('addCatModalTitle').textContent = 'Add Category';
    LANGS.forEach(lang => {
      const n = document.getElementById(`addCatName_${lang}`); if (n) n.value = '';
      const d = document.getElementById(`addCatDesc_${lang}`); if (d) d.value = '';
    });
    document.getElementById('addCatSlug').value = '';
    const container = document.querySelector('#addCatModal [data-lang-container]');
    resetLangTabs(container, PRIMARY);
    openModal('addCatModal');
  }

  function openAddSubModal(parentId, parentName, directItemCount) {
    openAddCategoryModal();
    document.getElementById('addCatParentId').value = parentId;
    document.getElementById('addCatModalTitle').textContent = `Add Subcategory under "${parentName}"`;
    const warn = document.getElementById('addSubWarning');
    if (warn) warn.classList.toggle('hidden', !directItemCount);
  }

  function openEditCategoryModal(cat) {
    document.getElementById('editCatId').value         = cat.id;
    document.getElementById('editCatSlug').value       = cat.slug;
    document.getElementById('editCatIsActive').checked = cat.is_active;
    document.getElementById('editCatParentId').value   = cat.parent_id || '';
    const byLang = {};
    (cat.translations || []).forEach(t => byLang[t.lang] = t);
    LANGS.forEach(lang => {
      const n = document.getElementById(`editCatName_${lang}`); if (n) n.value = (byLang[lang]||{}).name        || '';
      const d = document.getElementById(`editCatDesc_${lang}`); if (d) d.value = (byLang[lang]||{}).description || '';
    });
    const container = document.querySelector('#editCatModal [data-lang-container]');
    resetLangTabs(container, PRIMARY);
    openModal('editCatModal');
  }

  async function submitAddCategory() {
    const body = { slug: document.getElementById('addCatSlug').value || undefined };
    const parentId = document.getElementById('addCatParentId').value;
    if (parentId) body.parent_id = parseInt(parentId);
    LANGS.forEach(lang => {
      const n = document.getElementById(`addCatName_${lang}`)?.value.trim();
      const d = document.getElementById(`addCatDesc_${lang}`)?.value.trim();
      if (n) body[`name_${lang}`] = n;
      if (d) body[`description_${lang}`] = d;
    });
    try {
      await api('POST', '/api/categories', body);
      showToast('Category created');
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function submitEditCategory() {
    const id       = document.getElementById('editCatId').value;
    const parentId = document.getElementById('editCatParentId').value;
    const body = {
      slug:      document.getElementById('editCatSlug').value,
      is_active: document.getElementById('editCatIsActive').checked,
      parent_id: parentId === '' ? null : parseInt(parentId),
    };
    LANGS.forEach(lang => {
      const n = document.getElementById(`editCatName_${lang}`)?.value.trim();
      const d = document.getElementById(`editCatDesc_${lang}`)?.value.trim();
      if (n !== undefined) body[`name_${lang}`] = n;
      if (d !== undefined) body[`description_${lang}`] = d;
    });
    try {
      await api('PUT', `/api/categories/${id}`, body);
      showToast('Category updated');
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function deleteCategory(id, name) {
    confirmDelete(`Delete category "${name}"? This cannot be undone.`, async () => {
      try {
        await api('DELETE', `/api/categories/${id}`);
        showToast('Category deleted');
        reloadAfter();
      } catch (err) { showToast(err.message, 'error'); }
    });
  }
</script>
