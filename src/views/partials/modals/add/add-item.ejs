<!-- ── Add Item Modal (generic selector) ────────────────────────────────────── -->
<!-- Requires in scope: langs, primary, dishes                                  -->
<!-- Caller must call openAddItemModal(config) — see script block below        -->
<div id="addItemModal" class="modal-overlay hidden">
  <div class="modal modal--lg" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title" id="addItemModalTitle">Add Item</h3>
      <button onclick="closeModal('addItemModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="addItemSmcId" />
      <div id="addItemCourseWrap" class="form-group hidden">
        <label class="form-label">Add to Course <span class="required">*</span></label>
        <select id="addItemCourseSelect" class="form-select"></select>
      </div>
      <div class="form-group">
        <input type="text" id="addItemSearch" placeholder="Search items…" oninput="filterItemSearch()" class="form-input" />
      </div>
      <div id="addItemList" class="add-to-cat-list">
        <% dishes.forEach(d => {
          const dT = d.translations.find(t => t.lang === primary) || d.translations[0];
          const dName = dT ? (dT.name || '—') : '—';
        %>
          <div class="add-to-cat-item" data-dish-id="<%= d.id %>"
               data-name="<%= dName.toLowerCase() %>"
               onclick="selectItem(this)">
            <%= dName %><span class="add-to-cat-item__meta"> — €<%= Number(d.price).toFixed(2) %></span>
          </div>
        <% }) %>
      </div>
      <div class="modal-create-action">
        <button type="button" class="btn btn--pill link--slide" onclick="swapToItemModal()">+ Create Item</button>
      </div>
      <div id="addItemNoteWrap" class="modal-note-wrap hidden">
        <h4 class="modal-section-title">Add A Note</h4>
        <div data-lang-container>
          <div class="lang-tabs" id="addItemNoteTabs">
            <% langs.forEach((lang, i) => { %>
              <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
                data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
                <%= lang.toUpperCase() %>
              </button>
            <% }) %>
          </div>
          <% langs.forEach((lang, i) => { %>
            <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
              <div class="form-group">
                <label class="form-label form-label--xs">
                  Note for this item (<%= lang.toUpperCase() %>) <span class="hint">— optional</span>
                </label>
                <input type="text" id="addItemNote_<%= lang %>" class="form-input form-input--sm"
                  placeholder="e.g. Contains nuts, Ask server for info…" />
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
    <div class="modal__footer">
      <button onclick="closeModal('addItemModal')" class="btn btn--secondary">Cancel</button>
      <button onclick="submitAddItem()" class="btn btn--primary">Add Item</button>
    </div>
  </div>
</div>

<script>
  let _selectedDishId  = null;
  let _swapReturnId    = null;
  let _addItemConfig   = null;

  function openAddItemModal(config) {
    _addItemConfig  = config || {};
    _selectedDishId = null;

    document.getElementById('addItemModalTitle').textContent = _addItemConfig.title || 'Add Item';

    const courseWrap = document.getElementById('addItemCourseWrap');
    const smcIdInput = document.getElementById('addItemSmcId');

    if (_addItemConfig.smcId !== undefined && _addItemConfig.smcId !== null) {
      smcIdInput.value = _addItemConfig.smcId;
      courseWrap.classList.add('hidden');
    } else if (_addItemConfig.courses && _addItemConfig.courses.length) {
      smcIdInput.value = '';
      const sel = document.getElementById('addItemCourseSelect');
      sel.innerHTML = _addItemConfig.courses
        .map(smc => `<option value="${smc.id}">${esc(getName(smc.course.translations))}</option>`)
        .join('');
      courseWrap.classList.remove('hidden');
    } else {
      smcIdInput.value = '';
      courseWrap.classList.add('hidden');
    }

    document.getElementById('addItemSearch').value = '';
    document.querySelectorAll('#addItemList .add-to-cat-item').forEach(el => {
      el.classList.remove('add-to-cat-item--selected');
      el.style.display = '';
    });
    document.getElementById('addItemNoteWrap').classList.add('hidden');
    LANGS.forEach(lang => {
      const el = document.getElementById(`addItemNote_${lang}`);
      if (el) el.value = '';
    });
    resetLangTabs(document.querySelector('#addItemModal [data-lang-container]'), PRIMARY);
    openModal('addItemModal');
  }

  function selectItem(el) {
    document.querySelectorAll('#addItemList .add-to-cat-item')
      .forEach(i => i.classList.remove('add-to-cat-item--selected'));
    el.classList.add('add-to-cat-item--selected');
    _selectedDishId = parseInt(el.dataset.dishId);
    if (_addItemConfig?.showNotes) {
      document.getElementById('addItemNoteWrap').classList.remove('hidden');
    }
  }

  function filterItemSearch() {
    const q = document.getElementById('addItemSearch').value.toLowerCase().trim();
    document.querySelectorAll('#addItemList .add-to-cat-item').forEach(el => {
      el.style.display = !q || el.dataset.name.includes(q) ? '' : 'none';
    });
  }

  async function submitAddItem() {
    if (!_selectedDishId) return showToast('Select an item first', 'error');
    if (!_addItemConfig?.onSubmit) return;

    const courseWrap  = document.getElementById('addItemCourseWrap');
    const useSelector = !courseWrap.classList.contains('hidden');
    const smcIdVal    = useSelector
      ? document.getElementById('addItemCourseSelect').value
      : document.getElementById('addItemSmcId').value;
    if (useSelector && !smcIdVal) return showToast('Please select a course', 'error');

    const smcId = smcIdVal ? parseInt(smcIdVal) : undefined;
    const notes = {};
    if (_addItemConfig.showNotes) {
      LANGS.forEach(lang => {
        const val = document.getElementById(`addItemNote_${lang}`)?.value.trim();
        if (val) notes[`notes_${lang}`] = val;
      });
    }

    try {
      await _addItemConfig.onSubmit(_selectedDishId, { smcId, notes });
      closeModal('addItemModal');
    } catch (err) { showToast(err.message, 'error'); }
  }

  function returnFromSwap(newItem) {
    document.querySelectorAll('.modal-overlay:not(.hidden)').forEach(el => el.classList.add('hidden'));
    if (_swapReturnId) {
      document.getElementById(_swapReturnId).classList.remove('hidden');
      _swapReturnId = null;
    }
    if (newItem) injectAndSelectItem(newItem);
  }

  function swapToItemModal() {
    document.getElementById('addItemModal').classList.add('hidden');
    _swapReturnId = 'addItemModal';
    window._onItemSaved = function(item) {
      window._onItemSaved = null;
      returnFromSwap(item);
    };
    window._onItemModalClose = function() {
      returnFromSwap(null);
    };
    openAddDishModal();
  }

  function injectAndSelectItem(item) {
    const t    = (item.translations || []).find(t => t.lang === PRIMARY) || (item.translations || [])[0];
    const name = t?.name || '—';
    const el   = document.createElement('div');
    el.className      = 'add-to-cat-item';
    el.dataset.dishId = item.id;
    el.dataset.name   = name.toLowerCase();
    el.onclick        = function() { selectItem(this); };
    el.innerHTML = `${esc(name)}<span class="add-to-cat-item__meta"> — €${Number(item.price).toFixed(2)}</span>`;
    const list = document.getElementById('addItemList');
    list.insertBefore(el, list.firstChild);
    document.getElementById('addItemSearch').value = '';
    document.querySelectorAll('#addItemList .add-to-cat-item').forEach(e => e.style.display = '');
    selectItem(el);
    list.scrollTop = 0;
  }
</script>
