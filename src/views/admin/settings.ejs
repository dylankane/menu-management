<!DOCTYPE html>
<html lang="<%= uiLang %>">
<%- include('../partials/head', { title: t('page.settings.title'), restaurantName, section: 'admin' }) %>
<body>

<%- include('./partials/sidebar', { current, user, restaurantName }) %>

<%
  const s     = settings;
  const langs = s.enabled_languages || ['en', 'es'];
  const LOCKED  = ['en', 'es'];

  const ALL_LANGS = [
    { code: 'en', label: 'English' },
    { code: 'es', label: 'Spanish' },
    { code: 'fr', label: 'French' },
    { code: 'de', label: 'German' },
    { code: 'it', label: 'Italian' },
    { code: 'pt', label: 'Portuguese' },
    { code: 'nl', label: 'Dutch' },
    { code: 'pl', label: 'Polish' },
    { code: 'ru', label: 'Russian' },
    { code: 'zh', label: 'Chinese' },
    { code: 'ja', label: 'Japanese' },
    { code: 'ar', label: 'Arabic' },
  ];
  const available = ALL_LANGS.filter(l => !langs.includes(l.code));

  const MODULES = [
    {
      key:      'menu',
      name:     t('page.settings.module_menu_name'),
      desc:     t('page.settings.module_menu_desc'),
      included: true,
    },
    {
      key:      'languages',
      name:     t('page.settings.module_languages_name').replace('{max}', maxLanguages),
      desc:     t('page.settings.module_languages_desc').replace('{max}', maxLanguages),
      included: true,
      enquire:  true,
    },
    {
      key:      'restaurantHub',
      name:     t('page.settings.module_hub_name'),
      desc:     t('page.settings.module_hub_desc'),
      included: features.restaurantHub,
    },
    {
      key:      'gourmetClub',
      name:     t('page.settings.module_gc_name'),
      desc:     t('page.settings.module_gc_desc'),
      included: features.gourmetClub,
    },
  ];
%>

<div class="main">
  <header class="page-header">
    <h2 class="page-header__title"><%= t('page.settings.title') %></h2>
    <%- include('./partials/lang-selector') %>
  </header>

  <main class="page-body">
    <div class="settings-grid">

      <!-- ── Account & Billing ──────────────────────────────────────────────── -->
      <div class="card">
        <div class="card__header card__header--accent">
          <h3 class="card__title"><%= t('page.settings.card_account') %></h3>
        </div>
        <div class="card__body form-stack">
          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label"><%= t('page.settings.label_manager_name') %></label>
              <input type="text" id="accOwnerName" class="form-input" value="<%= account.owner_name || '' %>" />
            </div>
            <div class="form-group">
              <label class="form-label"><%= t('page.settings.label_manager_phone') %></label>
              <input type="tel" id="accOwnerPhone" class="form-input" value="<%= account.owner_phone || '' %>" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label"><%= t('page.settings.label_manager_email') %></label>
            <input type="email" id="accOwnerEmail" class="form-input" value="<%= account.owner_email || '' %>" />
          </div>
          <div class="form-group">
            <label class="form-label"><%= t('page.settings.label_billing_address') %></label>
            <textarea id="accBillingAddress" rows="2" class="form-textarea"><%= account.billing_address || '' %></textarea>
          </div>
          <div class="form-group">
            <label class="form-label"><%= t('page.settings.label_notes') %></label>
            <textarea id="accNotes" rows="3" class="form-textarea"><%= account.notes || '' %></textarea>
          </div>
        </div>
        <div class="card__footer form-footer">
          <button onclick="saveAccount()" class="btn btn--primary"><%= t('common.save') %></button>
        </div>
      </div>

      <!-- ── Languages ──────────────────────────────────────────────────────── -->
      <div class="card">
        <div class="card__header card__header--accent">
          <h3 class="card__title"><%= t('page.settings.card_languages') %></h3>
          <span class="card__meta"><%= t('page.settings.lang_max').replace('{max}', maxLanguages) %></span>
        </div>
        <div class="card__body form-stack">
          <p class="card__note"><%= t('page.settings.lang_note') %></p>

          <div class="lang-list">
            <% langs.forEach(lang => { %>
              <div class="lang-row">
                <span class="lang-row__code"><%= lang %></span>
                <div class="lang-row__action">
                  <% if (LOCKED.includes(lang)) { %>
                    <svg class="lang-row__lock"><use href="/admin/icons/sprite.svg#lock"></use></svg>
                  <% } else { %>
                    <button onclick="removeLang('<%= lang %>')" class="btn-delete" title="<%= t('common.tooltip_remove_lang') %>">
                      <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                      </svg>
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>

          <% if (available.length > 0 && langs.length < maxLanguages) { %>
            <div class="input-row">
              <select id="addLangSelect" class="form-select">
                <% available.forEach(l => { %>
                  <option value="<%= l.code %>"><%= l.code.toUpperCase() %> — <%= l.label %></option>
                <% }) %>
              </select>
              <button onclick="addLang()" class="btn btn--primary btn--sm"><%= t('page.settings.lang_add_btn') %></button>
            </div>
          <% } %>

          <div class="card-action">
            <a href="/admin/menu-translations" class="btn btn--pill btn--outline-brand btn--sm"><%= t('page.settings.manage_static_translations') %></a>
          </div>
        </div>
      </div>

      <!-- ── Plan & Features ───────────────────────────────────────────────── -->
      <div class="card settings-grid__full">
        <div class="card__header card__header--accent">
          <h3 class="card__title"><%= t('page.settings.card_plan') %></h3>
          <% if (account.plan) { %><span class="card__meta"><%= t('page.settings.plan_label').replace('{plan}', account.plan) %></span><% } %>
        </div>
        <div class="feature-list">
          <% MODULES.forEach(mod => { %>
            <div class="feature-row <%= mod.included ? 'feature-row--included' : 'feature-row--addon' %>">
              <div class="feature-row__indicator">
                <% if (mod.included) { %>
                  <svg class="icon feature-row__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                <% } else { %>
                  <svg class="icon feature-row__lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                <% } %>
              </div>
              <div class="feature-row__info">
                <p class="feature-row__name"><%= mod.name %></p>
                <p class="feature-row__desc"><%= mod.desc %><% if (!mod.included) { %> <%= t('page.settings.get_in_touch') %><% } %></p>
              </div>
              <div class="feature-row__status">
                <% if (!mod.included || mod.enquire) { %>
                  <a href="#" class="btn btn--pill btn--outline-brand btn--sm"><%= t('common.contact_us') %></a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

    </div>
  </main>
  <footer class="page-legal-footer">
    <a href="/admin/privacy"><%= t('common.legal_privacy') %> <svg class="icon page-legal-footer__icon"><use href="/admin/icons/sprite.svg#arrow-up-right"></use></svg></a>
  </footer>
</div>

<!-- ── Remove language warning modal ────────────────────────────────────────── -->
<div id="removeLangModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title"><%= t('page.settings.modal_remove_lang_title') %></h3>
      <button onclick="closeModal('removeLangModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <p id="removeLangBody1"></p>
      <p class="text-danger">
        <strong><%= t('common.warning') %>:</strong>
        <%= t('page.settings.modal_remove_lang_warning') %>
      </p>
      <p><%= t('page.settings.modal_remove_lang_confirm') %></p>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="closeModal('removeLangModal')" class="btn btn--secondary"><%= t('modal.btn_cancel') %></button>
      <button type="button" id="confirmRemoveLangBtn" class="btn btn--outline-danger"><%= t('page.settings.btn_remove_language') %></button>
    </div>
  </div>
</div>

<%- include('./partials/scripts') %>
<script>
  const _removeLangBody1Tpl = <%- JSON.stringify(t('page.settings.modal_remove_lang_body_1')) %>;

  async function saveAccount() {
    const body = {
      owner_name:      document.getElementById('accOwnerName').value.trim()      || null,
      owner_email:     document.getElementById('accOwnerEmail').value.trim()     || null,
      owner_phone:     document.getElementById('accOwnerPhone').value.trim()     || null,
      billing_address: document.getElementById('accBillingAddress').value.trim() || null,
      tax_number:      null,
      plan:            null,
      notes:           document.getElementById('accNotes').value.trim()          || null,
    };
    try {
      await api('PUT', '/api/client-account', body);
      showToast(tr('account_saved'));
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function addLang() {
    const lang = document.getElementById('addLangSelect').value;
    try {
      await api('POST', '/api/settings/languages', { lang });
      showToast(tr('lang_added', { lang: lang.toUpperCase() }));
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  let pendingRemoveLang = null;

  function removeLang(lang) {
    pendingRemoveLang = lang;
    document.getElementById('removeLangBody1').textContent = _removeLangBody1Tpl.replace('{lang}', lang.toUpperCase());
    document.getElementById('confirmRemoveLangBtn').onclick = confirmRemoveLang;
    openModal('removeLangModal');
  }

  async function confirmRemoveLang() {
    if (!pendingRemoveLang) return;
    try {
      await api('DELETE', `/api/settings/languages/${pendingRemoveLang}`);
      showToast(tr('lang_removed', { lang: pendingRemoveLang.toUpperCase() }));
      closeModal('removeLangModal');
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }
</script>

</body>
</html>
