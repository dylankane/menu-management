<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Settings', restaurantName }) %>
<body>

<%- include('../partials/sidebar', { current, user, restaurantName }) %>

<%
  const s       = settings;
  const primary = s.primary_language || 'en';
  const langs   = s.enabled_languages || ['en', 'es'];
  const LOCKED  = ['en', 'es'];

  const ALL_LANGS = [
    { code: 'en', label: 'English' },
    { code: 'es', label: 'Spanish' },
    { code: 'fr', label: 'French' },
    { code: 'de', label: 'German' },
    { code: 'it', label: 'Italian' },
    { code: 'pt', label: 'Portuguese' },
    { code: 'nl', label: 'Dutch' },
    { code: 'pl', label: 'Polish' },
    { code: 'ru', label: 'Russian' },
    { code: 'zh', label: 'Chinese' },
    { code: 'ja', label: 'Japanese' },
    { code: 'ar', label: 'Arabic' },
  ];
  const available = ALL_LANGS.filter(l => !langs.includes(l.code));

  const MODULES = [
    {
      key:      'menu',
      name:     'Menu Management',
      desc:     'Build and manage your full menu — dishes, set menus, categories, allergens and dietary tags.',
      included: true,
    },
    {
      key:      'languages',
      name:     `Languages — up to ${maxLanguages}`,
      desc:     `You currently have a max of ${maxLanguages} languages. If you need more, contact us to see about an increase.`,
      included: true,
      enquire:  true,
    },
    {
      key:      'restaurantHub',
      name:     'Restaurant Hub',
      desc:     'Manage your wider web presence — opening hours, contact info, announcements and restaurant identity.',
      included: features.restaurantHub,
    },
    {
      key:      'gourmetClub',
      name:     'Gourmet Club',
      desc:     'A loyalty and membership platform for your most valued guests — members, offers and exclusive content.',
      included: features.gourmetClub,
    },
  ];
%>

<div class="main">
  <header class="page-header">
    <h2 class="page-header__title">Settings</h2>
    <%- include('../partials/lang-selector') %>
  </header>

  <main class="page-body">
    <div class="settings-grid">

      <!-- ── Account & Billing ──────────────────────────────────────────────── -->
      <div class="card">
        <div class="card__header card__header--accent">
          <h3 class="card__title">Account &amp; Billing</h3>
        </div>
        <div class="card__body form-stack">
          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label">Manager Name</label>
              <input type="text" id="accOwnerName" class="form-input" value="<%= account.owner_name || '' %>" />
            </div>
            <div class="form-group">
              <label class="form-label">Manager Phone</label>
              <input type="tel" id="accOwnerPhone" class="form-input" value="<%= account.owner_phone || '' %>" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Manager Email</label>
            <input type="email" id="accOwnerEmail" class="form-input" value="<%= account.owner_email || '' %>" />
          </div>
          <div class="form-group">
            <label class="form-label">Billing Address</label>
            <textarea id="accBillingAddress" rows="2" class="form-textarea"><%= account.billing_address || '' %></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">Notes</label>
            <textarea id="accNotes" rows="3" class="form-textarea"><%= account.notes || '' %></textarea>
          </div>
        </div>
        <div class="card__footer form-footer">
          <button onclick="saveAccount()" class="btn btn--primary">Save</button>
        </div>
      </div>

      <!-- ── Languages ──────────────────────────────────────────────────────── -->
      <div class="card">
        <div class="card__header card__header--accent">
          <h3 class="card__title">Languages</h3>
          <span class="card__meta">Max <%= maxLanguages %></span>
        </div>
        <div class="card__body form-stack">
          <p class="card__note">
            Choose which languages your menu and customer-facing content are available in. Translations are managed manually. Your primary language is shown first by default throughout your dashboard.
          </p>

          <div class="lang-list">
            <% langs.forEach(lang => { %>
              <div class="lang-row">
                <span class="lang-row__code"><%= lang %></span>
                <div class="lang-row__primary">
                  <% if (lang === primary) { %>
                    <span class="lang-badge--primary">PRIMARY</span>
                  <% } else { %>
                    <button onclick="setPrimary('<%= lang %>')" class="btn btn--pill link--slide btn--sm">Set as Primary</button>
                  <% } %>
                </div>
                <div class="lang-row__action">
                  <% if (LOCKED.includes(lang)) { %>
                    <svg class="lang-row__lock"><use href="/icons/sprite.svg#lock"></use></svg>
                  <% } else { %>
                    <button onclick="removeLang('<%= lang %>')" class="btn-delete" title="Remove language">
                      <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                      </svg>
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>

          <% if (available.length > 0 && langs.length < maxLanguages) { %>
            <div class="input-row">
              <select id="addLangSelect" class="form-select">
                <% available.forEach(l => { %>
                  <option value="<%= l.code %>"><%= l.code.toUpperCase() %> — <%= l.label %></option>
                <% }) %>
              </select>
              <button onclick="addLang()" class="btn btn--primary btn--sm">Add</button>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ── Plan & Features ───────────────────────────────────────────────── -->
      <div class="card settings-grid__full">
        <div class="card__header card__header--accent">
          <h3 class="card__title">Plan &amp; Features</h3>
          <% if (account.plan) { %><span class="card__meta">Plan: <%= account.plan %></span><% } %>
        </div>
        <div class="feature-list">
          <% MODULES.forEach(mod => { %>
            <div class="feature-row <%= mod.included ? 'feature-row--included' : 'feature-row--addon' %>">
              <div class="feature-row__indicator">
                <% if (mod.included) { %>
                  <svg class="icon feature-row__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                <% } else { %>
                  <svg class="icon feature-row__lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                <% } %>
              </div>
              <div class="feature-row__info">
                <p class="feature-row__name"><%= mod.name %></p>
                <p class="feature-row__desc"><%= mod.desc %><% if (!mod.included) { %> Get in touch if you are interested in this feature.<% } %></p>
              </div>
              <div class="feature-row__status">
                <% if (!mod.included || mod.enquire) { %>
                  <a href="#" class="btn btn--pill btn--outline-brand btn--sm">Contact Us</a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- ── Remove language warning modal ────────────────────────────────────────── -->
<div id="removeLangModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title">Remove Language</h3>
      <button onclick="closeModal('removeLangModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <p>You are about to remove <strong id="removeLangCode"></strong> from enabled languages.</p>
      <p class="text-danger">
        <strong>Warning:</strong> All translations in this language (menu item names, descriptions,
        category names, allergen labels, etc.) will become inaccessible from the admin UI.
        The data is <em>not deleted</em> from the database, but it will be hidden.
      </p>
      <p>Are you sure you want to continue?</p>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="closeModal('removeLangModal')" class="btn btn--secondary">Cancel</button>
      <button type="button" id="confirmRemoveLangBtn" class="btn btn--outline-danger">Remove Language</button>
    </div>
  </div>
</div>

<%- include('../partials/scripts') %>
<script>
  async function saveAccount() {
    const body = {
      owner_name:      document.getElementById('accOwnerName').value.trim()      || null,
      owner_email:     document.getElementById('accOwnerEmail').value.trim()     || null,
      owner_phone:     document.getElementById('accOwnerPhone').value.trim()     || null,
      billing_address: document.getElementById('accBillingAddress').value.trim() || null,
      tax_number:      null,
      plan:            null,
      notes:           document.getElementById('accNotes').value.trim()          || null,
    };
    try {
      await api('PUT', '/api/client-account', body);
      showToast('Account saved');
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function setPrimary(lang) {
    try {
      await api('PUT', '/api/settings', { primary_language: lang });
      showToast(`Primary language set to ${lang.toUpperCase()}`);
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function addLang() {
    const lang = document.getElementById('addLangSelect').value;
    try {
      await api('POST', '/api/settings/languages', { lang });
      showToast(`${lang.toUpperCase()} added`);
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  let pendingRemoveLang = null;

  function removeLang(lang) {
    pendingRemoveLang = lang;
    document.getElementById('removeLangCode').textContent = lang.toUpperCase();
    document.getElementById('confirmRemoveLangBtn').onclick = confirmRemoveLang;
    openModal('removeLangModal');
  }

  async function confirmRemoveLang() {
    if (!pendingRemoveLang) return;
    try {
      await api('DELETE', `/api/settings/languages/${pendingRemoveLang}`);
      showToast(`${pendingRemoveLang.toUpperCase()} removed`);
      closeModal('removeLangModal');
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }
</script>

</body>
</html>
