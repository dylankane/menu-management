<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Categories', restaurantName }) %>
<body>

<%- include('../partials/sidebar', { current, user, restaurantName }) %>

<%
  const primary = settings.primary_language || 'en';
  const langs   = settings.enabled_languages || ['en', 'es'];

  function catName(cat) {
    const t = (cat.translations || []).find(t => t.lang === primary)
           || (cat.translations || [])[0];
    return t ? (t.name || cat.slug) : cat.slug;
  }
  function catDesc(cat) {
    const t = (cat.translations || []).find(t => t.lang === primary)
           || (cat.translations || [])[0];
    return t ? (t.description || '') : '';
  }
%>

<div class="main">
  <header class="page-header">
    <h2 class="page-header__title">Categories</h2>
    <%- include('../partials/lang-selector') %>
  </header>

  <main class="page-body">
    <div class="card table-controls">
      <div class="card__header card__header--brand">
        <h3 class="card__title">All Categories</h3>
        <button type="button" class="filter-toggle" id="filterToggle" onclick="toggleFilterBar()" title="Search & filter">
          <svg class="icon" style="width:1.1rem;height:1.1rem;"><use href="/icons/sprite.svg#search"></use></svg>
        </button>
        <button onclick="openAddModal()" class="btn btn--pill btn--outline-accent-on-dark btn--sm">+ Add Category</button>
      </div>
      <div class="filter-bar" id="filterBar">
        <input type="text" id="searchInput" placeholder="Search by name..." oninput="filterCategories()" class="form-input" style="width:15rem;" />
        <div class="filter-radios">
          <label><input type="radio" name="catFilter" value="all" checked onchange="filterCategories()" /> All</label>
          <label><input type="radio" name="catFilter" value="active" onchange="filterCategories()" /> Active</label>
          <label><input type="radio" name="catFilter" value="inactive" onchange="filterCategories()" /> Inactive</label>
        </div>
        <span id="catCount" class="filter-bar__count"></span>
      </div>
    </div>

    <% if (categories.length === 0) { %>
      <div class="card">
        <div class="empty-state">
          <div class="empty-state__icon">📁</div>
          <p class="empty-state__text">No categories yet</p>
          <button onclick="openAddModal()" class="empty-state__action">Add your first category →</button>
        </div>
      </div>
    <% } else { %>
      <div class="card table-card">
        <table class="data-table" id="catsTable">
          <thead>
            <tr>
              <th>Name</th>
              <th>Status</th>
              <th>Subcategories</th>
              <th>Order</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach((cat, idx) => { %>
              <!-- Parent row -->
              <tr class="cat-row cat-row--parent" data-name="<%= catName(cat).toLowerCase() %>" data-id="<%= cat.id %>" data-active="<%= cat.is_active %>">
                <td>
                  <div class="table-item">
                    <p class="table-item__name"><%= catName(cat) %></p>
                    <% if (cat.is_protected) { %><span class="badge badge--warning">Protected</span><% } %>
                  </div>
                </td>
                <td>
                  <label class="avail-toggle">
                    <input type="checkbox" <%= cat.is_active ? 'checked' : '' %> readonly tabindex="-1" />
                    <span class="avail-toggle__label <%= cat.is_active ? 'avail-toggle__label--active' : 'avail-toggle__label--inactive' %>">
                      <%= cat.is_active ? 'Active' : 'Inactive' %>
                    </span>
                  </label>
                </td>
                <td>
                  <button onclick="openAddSubModal(<%= cat.id %>, '<%= catName(cat).replace(/'/g, "\\'") %>')" class="btn btn--outline-add btn--sm">+ Add</button>
                </td>
                <td>
                  <div class="table-actions">
                    <% if (idx > 0) { %>
                      <button onclick="moveCategory(<%= cat.id %>, 'up', <%= idx %>)" title="Move up" class="btn-reorder">▲</button>
                    <% } %>
                    <% if (idx < categories.length - 1) { %>
                      <button onclick="moveCategory(<%= cat.id %>, 'down', <%= idx %>)" title="Move down" class="btn-reorder">▼</button>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="table-actions">
                    <button onclick='openEditModal(<%- JSON.stringify(cat) %>)' class="btn btn--outline-primary btn--sm">Edit</button>
                    <% if (!cat.is_protected) { %>
                      <button onclick="deleteCategory(<%= cat.id %>, '<%= catName(cat).replace(/'/g, "\\'") %>')" class="btn btn--outline-danger btn--sm">Delete</button>
                    <% } %>
                  </div>
                </td>
              </tr>
              <!-- Subcategory rows -->
              <% if (cat.children) cat.children.forEach((child, childIdx) => { %>
                <tr class="cat-row cat-row--child" data-name="<%= catName(child).toLowerCase() %>" data-parent-id="<%= cat.id %>" data-active="<%= child.is_active %>">
                  <td>
                    <div class="table-item cat-row__indent">
                      <span class="cat-row__arrow">↳</span>
                      <p class="table-item__name"><%= catName(child) %></p>
                    </div>
                  </td>
                  <td>
                    <label class="avail-toggle">
                      <input type="checkbox" <%= child.is_active ? 'checked' : '' %> readonly tabindex="-1" />
                      <span class="avail-toggle__label <%= child.is_active ? 'avail-toggle__label--active' : 'avail-toggle__label--inactive' %>">
                        <%= child.is_active ? 'Active' : 'Inactive' %>
                      </span>
                    </label>
                  </td>
                  <td></td>
                  <td>
                    <div class="table-actions">
                      <% if (childIdx > 0) { %>
                        <button onclick="moveSubcategory(<%= child.id %>, 'up', <%= cat.id %>, <%= childIdx %>)" title="Move up" class="btn-reorder btn-reorder--outline">△</button>
                      <% } %>
                      <% if (childIdx < cat.children.length - 1) { %>
                        <button onclick="moveSubcategory(<%= child.id %>, 'down', <%= cat.id %>, <%= childIdx %>)" title="Move down" class="btn-reorder btn-reorder--outline">▽</button>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <div class="table-actions">
                      <button onclick='openEditModal(<%- JSON.stringify(child) %>)' class="btn btn--outline-primary btn--sm">Edit</button>
                      <% if (!child.is_protected) { %>
                        <button onclick="deleteCategory(<%= child.id %>, '<%= catName(child).replace(/'/g, "\\'") %>')" class="btn btn--outline-danger btn--sm">Delete</button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</div>

<!-- ── Add Category Modal ─────────────────────────────────────────────────── -->
<div id="addModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title" id="addModalTitle">Add Category</h3>
      <button onclick="closeModal('addModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="addParentId" value="" />
      <div data-lang-container>
        <div class="lang-tabs">
          <% langs.forEach((lang, i) => { %>
            <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
              data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
              <%= lang.toUpperCase() %>
            </button>
          <% }) %>
        </div>
        <% langs.forEach((lang, i) => { %>
          <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
            <div class="form-group">
              <label class="form-label">Name (<%= lang.toUpperCase() %>)</label>
              <input type="text" id="addName_<%= lang %>" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label">Description (<%= lang.toUpperCase() %>)</label>
              <input type="text" id="addDesc_<%= lang %>" class="form-input" placeholder="Optional" />
            </div>
          </div>
        <% }) %>
      </div>
      <div class="form-group">
        <label class="form-label">Slug <span class="hint">(auto-generated, can override)</span></label>
        <input type="text" id="addSlug" class="form-input" placeholder="e.g. starters" />
      </div>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="closeModal('addModal')" class="btn btn--secondary">Cancel</button>
      <button type="button" onclick="submitAdd()" class="btn btn--primary">Save</button>
    </div>
  </div>
</div>

<!-- ── Edit Category Modal ────────────────────────────────────────────────── -->
<div id="editModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title">Edit Category</h3>
      <button onclick="closeModal('editModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="editId" />
      <div data-lang-container>
        <div class="lang-tabs">
          <% langs.forEach((lang, i) => { %>
            <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
              data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
              <%= lang.toUpperCase() %>
            </button>
          <% }) %>
        </div>
        <% langs.forEach((lang, i) => { %>
          <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
            <div class="form-group">
              <label class="form-label">Name (<%= lang.toUpperCase() %>)</label>
              <input type="text" id="editName_<%= lang %>" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label">Description (<%= lang.toUpperCase() %>)</label>
              <input type="text" id="editDesc_<%= lang %>" class="form-input" />
            </div>
          </div>
        <% }) %>
      </div>
      <div class="form-group">
        <label class="form-label">Slug</label>
        <input type="text" id="editSlug" class="form-input" />
      </div>
      <label class="form-check">
        <input type="checkbox" id="editIsActive" />
        <span class="form-check__label">Active (visible on menu)</span>
      </label>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="closeModal('editModal')" class="btn btn--secondary">Cancel</button>
      <button type="button" onclick="submitEdit()" class="btn btn--primary">Save Changes</button>
    </div>
  </div>
</div>

<%- include('../partials/scripts') %>

<script>
  const LANGS   = <%- JSON.stringify(langs) %>;
  const PRIMARY = '<%= primary %>';
  const topLevelCategories = <%- JSON.stringify(categories.map(c => ({ id: c.id, display_order: c.display_order }))) %>;
  const subGroups = <%- JSON.stringify(
    Object.fromEntries(categories.map(c => [
      c.id,
      (c.children || []).map(ch => ({ id: ch.id, display_order: ch.display_order }))
    ]))
  ) %>;

  // Auto-generate slug from primary-language name field
  document.getElementById('addName_' + PRIMARY)?.addEventListener('input', function () {
    const slug = this.value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')
      .replace(/[^a-z0-9\s-]/g,'').trim().replace(/\s+/g,'-').replace(/-+/g,'-');
    document.getElementById('addSlug').value = slug;
  });

  function openAddModal() {
    document.getElementById('addParentId').value = '';
    document.getElementById('addModalTitle').textContent = 'Add Category';
    LANGS.forEach(lang => {
      const n = document.getElementById(`addName_${lang}`); if (n) n.value = '';
      const d = document.getElementById(`addDesc_${lang}`); if (d) d.value = '';
    });
    document.getElementById('addSlug').value = '';
    const container = document.querySelector('#addModal [data-lang-container]');
    resetLangTabs(container, PRIMARY);
    openModal('addModal');
  }

  function openAddSubModal(parentId, parentName) {
    openAddModal();
    document.getElementById('addParentId').value = parentId;
    document.getElementById('addModalTitle').textContent = `Add Subcategory under "${parentName}"`;
  }

  function openEditModal(cat) {
    document.getElementById('editId').value        = cat.id;
    document.getElementById('editSlug').value      = cat.slug;
    document.getElementById('editIsActive').checked = cat.is_active;
    const byLang = {};
    (cat.translations || []).forEach(t => byLang[t.lang] = t);
    LANGS.forEach(lang => {
      const n = document.getElementById(`editName_${lang}`); if (n) n.value = (byLang[lang]||{}).name || '';
      const d = document.getElementById(`editDesc_${lang}`); if (d) d.value = (byLang[lang]||{}).description || '';
    });
    const container = document.querySelector('#editModal [data-lang-container]');
    resetLangTabs(container, PRIMARY);
    openModal('editModal');
  }

  async function submitAdd() {
    const body = { slug: document.getElementById('addSlug').value || undefined };
    const parentId = document.getElementById('addParentId').value;
    if (parentId) body.parent_id = parseInt(parentId);
    LANGS.forEach(lang => {
      const n = document.getElementById(`addName_${lang}`)?.value.trim();
      const d = document.getElementById(`addDesc_${lang}`)?.value.trim();
      if (n) body[`name_${lang}`] = n;
      if (d) body[`description_${lang}`] = d;
    });
    try {
      await api('POST', '/api/categories', body);
      showToast('Category created');
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function submitEdit() {
    const id   = document.getElementById('editId').value;
    const body = {
      slug:      document.getElementById('editSlug').value,
      is_active: document.getElementById('editIsActive').checked,
    };
    LANGS.forEach(lang => {
      const n = document.getElementById(`editName_${lang}`)?.value.trim();
      const d = document.getElementById(`editDesc_${lang}`)?.value.trim();
      if (n !== undefined) body[`name_${lang}`] = n;
      if (d !== undefined) body[`description_${lang}`] = d;
    });
    try {
      await api('PUT', `/api/categories/${id}`, body);
      showToast('Category updated');
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function deleteCategory(id, name) {
    confirmDelete(`Delete category "${name}"? This cannot be undone.`, async () => {
      try {
        await api('DELETE', `/api/categories/${id}`);
        showToast('Category deleted');
        reloadAfter();
      } catch (err) { showToast(err.message, 'error'); }
    });
  }

  function toggleFilterBar() {
    const bar    = document.getElementById('filterBar');
    const toggle = document.getElementById('filterToggle');
    const open   = bar.classList.toggle('filter-bar--open');
    toggle.classList.toggle('filter-toggle--active', open);
    if (open) document.getElementById('searchInput')?.focus();
  }

  function filterCategories() {
    const q      = document.getElementById('searchInput').value.toLowerCase().trim();
    const status = document.querySelector('input[name="catFilter"]:checked')?.value || 'all';
    const parentRows = document.querySelectorAll('.cat-row--parent');
    let visible = 0;

    parentRows.forEach(parent => {
      const parentId     = parent.dataset.id;
      const parentName   = parent.dataset.name || '';
      const parentActive = parent.dataset.active === 'true';
      const childRows    = document.querySelectorAll(`.cat-row--child[data-parent-id="${parentId}"]`);

      const nameMatch   = !q || parentName.includes(q);
      const statusMatch = status === 'all'
        || (status === 'active'   && parentActive)
        || (status === 'inactive' && !parentActive);

      let childMatch = false;
      childRows.forEach(child => {
        const childName   = child.dataset.name || '';
        const childActive = child.dataset.active === 'true';
        const childStatus = status === 'all'
          || (status === 'active'   && childActive)
          || (status === 'inactive' && !childActive);
        const show = (nameMatch || childName.includes(q)) && (statusMatch || childStatus);
        child.classList.toggle('hidden', !show);
        if (show) childMatch = true;
      });

      const showParent = (nameMatch || childMatch) && (statusMatch || childMatch);
      parent.classList.toggle('hidden', !showParent);
      if (showParent) visible++;
    });

    const countEl = document.getElementById('catCount');
    if (countEl) countEl.textContent = `${visible} categor${visible !== 1 ? 'ies' : 'y'}`;
  }

  // initialise count on page load
  filterCategories();

  async function moveCategory(id, direction, currentIdx) {
    const items   = [...topLevelCategories];
    const swapIdx = direction === 'up' ? currentIdx - 1 : currentIdx + 1;
    const current = items[currentIdx];
    const swap    = items[swapIdx];
    try {
      await api('PATCH', '/api/categories/reorder', {
        items: [
          { id: current.id, display_order: swap.display_order },
          { id: swap.id,    display_order: current.display_order },
        ],
      });
      reloadAfter(100);
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function moveSubcategory(id, direction, parentId, currentIdx) {
    const items   = [...(subGroups[parentId] || [])];
    const swapIdx = direction === 'up' ? currentIdx - 1 : currentIdx + 1;
    const current = items[currentIdx];
    const swap    = items[swapIdx];
    try {
      await api('PATCH', '/api/categories/reorder', {
        items: [
          { id: current.id, display_order: swap.display_order },
          { id: swap.id,    display_order: current.display_order },
        ],
      });
      reloadAfter(100);
    } catch (err) { showToast(err.message, 'error'); }
  }
</script>

</body>
</html>
