<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Categories', restaurantName }) %>
<body>

<%- include('../partials/sidebar', { current, user, restaurantName }) %>

<%
  const primary = settings.primary_language || 'en';
  const langs   = settings.enabled_languages || ['en', 'es'];

  function catName(cat) {
    const t = (cat.translations || []).find(t => t.lang === primary)
           || (cat.translations || [])[0];
    return t ? (t.name || cat.slug) : cat.slug;
  }
%>

<div class="main">
  <header class="page-header page-header--minimal">
    <h2 class="page-header__title">Categories</h2>
    <%- include('../partials/lang-selector') %>
  </header>

  <main class="page-body page-body--minimal">
    <div class="card table-card">
      <div class="card__header card__header--brand">
        <h3 class="card__title">Categories</h3>
        <button type="button" class="filter-toggle" id="filterToggle" onclick="toggleFilterBar()" title="Search & filter">
          <svg class="icon" style="width:1.1rem;height:1.1rem;"><use href="/icons/sprite.svg#search"></use></svg>
        </button>
        <button onclick="openAddCategoryModal()" class="btn btn--pill btn--outline-accent-on-dark btn--sm">+ Add Category</button>
      </div>
      <div class="filter-bar" id="filterBar">
        <input type="text" id="searchInput" placeholder="Search by name..." oninput="filterCategories()" class="form-input" style="width:15rem;" />
        <div class="filter-radios">
          <label class="form-check">
            <input type="radio" name="catFilter" value="all" checked onchange="filterCategories()" />
            <span class="form-check__label">All</span>
          </label>
          <label class="form-check">
            <input type="radio" name="catFilter" value="active" onchange="filterCategories()" />
            <span class="form-check__label">Active</span>
          </label>
          <label class="form-check">
            <input type="radio" name="catFilter" value="inactive" onchange="filterCategories()" />
            <span class="form-check__label">Inactive</span>
          </label>
        </div>
        <span id="catCount" class="filter-bar__count"></span>
      </div>
      <% if (categories.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state__icon">
            <svg class="icon icon--empty-state"><use href="/icons/sprite.svg#categories"></use></svg>
          </div>
          <p class="empty-state__text">No categories yet</p>
          <button onclick="openAddCategoryModal()" class="btn btn--pill btn--outline-brand btn--sm">+ Add Category</button>
        </div>
      <% } else { %>
        <table class="data-table" id="catsTable">
          <tbody>
            <% categories.forEach(cat => { %>

              <!-- Parent category row -->
              <tr class="cat-row cat-row--parent"
                  data-name="<%= catName(cat).toLowerCase() %>"
                  data-id="<%= cat.id %>"
                  data-active="<%= cat.is_active %>">

                <td class="col-name col-align-left">
                  <div class="table-item">
                    <p class="table-item__name">• <%= catName(cat) %></p>
                    <% if (cat.is_protected) { %><svg class="icon icon--sm"><use href="/icons/sprite.svg#lock"></use></svg><% } %>
                  </div>
                </td>

                <td class="col-counts col-align-left">
                  <% if (!cat.children || cat.children.length === 0) { %>
                    <span class="count-line"><%= cat._count ? (cat._count.menu_item_categories + cat._count.set_menu_categories) : 0 %> items</span>
                  <% } else { %>
                    <span class="cell-empty">—</span>
                  <% } %>
                </td>

                <td class="col-add-sub col-align-center">
                  <button onclick="openAddSubModal(<%= cat.id %>, '<%= catName(cat).replace(/'/g, "\\'") %>')"
                          class="btn btn--pill link--slide btn--sm">+ Sub</button>
                </td>

                <td class="col-translations col-align-center">
                  <div class="tag-list">
                    <% const catLangs = langs.filter(l => (cat.translations || []).find(t => t.lang === l && t.name)); %>
                    <% catLangs.forEach(l => { %>
                      <span class="tag tag--lang"><%= l.toUpperCase() %></span>
                    <% }); %>
                    <% if (catLangs.length === 0) { %><span class="cell-empty">—</span><% } %>
                  </div>
                </td>

                <td class="col-toggle col-align-center">
                  <label class="smb-avail-switch">
                    <input type="checkbox" <%= cat.is_active ? 'checked' : '' %> readonly tabindex="-1" />
                    <span class="smb-avail-label <%= cat.is_active ? 'smb-avail-label--on' : 'smb-avail-label--off' %>">
                      <%= cat.is_active ? 'Live' : 'Off' %>
                    </span>
                  </label>
                </td>

                <td class="col-details col-align-center">
                  <button class="btn-view" title="View details">
                    <svg class="icon icon-closed"><use href="/icons/sprite.svg#eye-closed"></use></svg>
                    <svg class="icon icon-open"><use href="/icons/sprite.svg#eye-open"></use></svg>
                  </button>
                </td>
                <td class="col-delete col-align-center">
                  <% if (!cat.is_protected) { %>
                    <button class="btn-delete" onclick="deleteCategory(<%= cat.id %>, '<%= catName(cat).replace(/'/g, "\\'") %>')" title="Delete">
                      <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="15" y1="9" x2="9" y2="15"/>
                        <line x1="9" y1="9" x2="15" y2="15"/>
                      </svg>
                    </button>
                  <% } %>
                </td>
              </tr>

              <!-- Subcategory rows -->
              <% if (cat.children) cat.children.forEach(child => { %>
                <tr class="cat-row cat-row--child"
                    data-name="<%= catName(child).toLowerCase() %>"
                    data-parent-id="<%= cat.id %>"
                    data-active="<%= child.is_active %>">

                  <td class="col-name col-align-left">
                    <p class="table-item__name cat-row__indent">◦ <%= catName(child) %></p>
                  </td>

                  <td class="col-counts col-align-left">
                    <% const childTotal = child._count ? (child._count.menu_item_categories + child._count.set_menu_categories) : 0; %>
                    <% if (childTotal > 0) { %>
                      <span class="count-line"><%= childTotal %> items</span>
                    <% } else { %>
                      <span class="cell-empty">—</span>
                    <% } %>
                  </td>

                  <td class="col-add-sub"></td>

                  <td class="col-translations col-align-center">
                    <div class="tag-list">
                      <% const childLangs = langs.filter(l => (child.translations || []).find(t => t.lang === l && t.name)); %>
                      <% childLangs.forEach(l => { %>
                        <span class="tag tag--lang"><%= l.toUpperCase() %></span>
                      <% }); %>
                      <% if (childLangs.length === 0) { %><span class="cell-empty">—</span><% } %>
                    </div>
                  </td>

                  <td class="col-toggle col-align-center">
                    <label class="smb-avail-switch">
                      <input type="checkbox" <%= child.is_active ? 'checked' : '' %> readonly tabindex="-1" />
                      <span class="smb-avail-label <%= child.is_active ? 'smb-avail-label--on' : 'smb-avail-label--off' %>">
                        <%= child.is_active ? 'Live' : 'Off' %>
                      </span>
                    </label>
                  </td>

                  <td class="col-details col-align-center">
                    <button class="btn-view" title="View details">
                      <svg class="icon icon-closed"><use href="/icons/sprite.svg#eye-closed"></use></svg>
                      <svg class="icon icon-open"><use href="/icons/sprite.svg#eye-open"></use></svg>
                    </button>
                  </td>
                  <td class="col-delete col-align-center">
                    <% if (!child.is_protected) { %>
                      <button class="btn-delete" onclick="deleteCategory(<%= child.id %>, '<%= catName(child).replace(/'/g, "\\'") %>')" title="Delete">
                        <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/>
                          <line x1="15" y1="9" x2="9" y2="15"/>
                          <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                      </button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>

            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/modals/category', { langs, primary, categories }) %>

<%- include('../partials/scripts') %>

<script>
  const LANGS   = <%- JSON.stringify(langs) %>;
  const PRIMARY = '<%= primary %>';

  function toggleFilterBar() {
    const bar    = document.getElementById('filterBar');
    const toggle = document.getElementById('filterToggle');
    const open   = bar.classList.toggle('filter-bar--open');
    toggle.classList.toggle('filter-toggle--active', open);
    if (open) document.getElementById('searchInput')?.focus();
  }

  function filterCategories() {
    const q      = document.getElementById('searchInput').value.toLowerCase().trim();
    const status = document.querySelector('input[name="catFilter"]:checked')?.value || 'all';
    const parentRows = document.querySelectorAll('.cat-row--parent');
    let visible = 0;

    parentRows.forEach(parent => {
      const parentId     = parent.dataset.id;
      const parentName   = parent.dataset.name || '';
      const parentActive = parent.dataset.active === 'true';
      const childRows    = document.querySelectorAll(`.cat-row--child[data-parent-id="${parentId}"]`);

      const nameMatch   = !q || parentName.includes(q);
      const statusMatch = status === 'all'
        || (status === 'active'   && parentActive)
        || (status === 'inactive' && !parentActive);

      let childMatch = false;
      childRows.forEach(child => {
        const childName   = child.dataset.name || '';
        const childActive = child.dataset.active === 'true';
        const childStatus = status === 'all'
          || (status === 'active'   && childActive)
          || (status === 'inactive' && !childActive);
        const show = (nameMatch || childName.includes(q)) && (statusMatch || childStatus);
        child.classList.toggle('hidden', !show);
        if (show) childMatch = true;
      });

      const showParent = (nameMatch || childMatch) && (statusMatch || childMatch);
      parent.classList.toggle('hidden', !showParent);
      if (showParent) visible++;
    });

    const countEl = document.getElementById('catCount');
    if (countEl) countEl.textContent = `${visible} categor${visible !== 1 ? 'ies' : 'y'}`;
  }

  filterCategories();
</script>

</body>
</html>
