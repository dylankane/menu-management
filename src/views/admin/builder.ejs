<!DOCTYPE html>
<html lang="<%= uiLang %>">
<%- include('../partials/head', { title: t('page.builder.title'), restaurantName, section: 'admin' }) %>
<body>

<%- include('./partials/sidebar', { current, user, restaurantName }) %>

<%
  const langs   = settings.enabled_languages || ['en', 'es'];
  const primary = uiLang;

  function getName(translations) {
    if (!translations || !translations.length) return '—';
    const t = translations.find(t => t.lang === uiLang)
           || translations.find(t => t.lang === 'en')
           || translations[0];
    return t ? (t.name || '—') : '—';
  }

  function catName(cat) {
    return getName(cat.translations);
  }

  function tagName(translations) {
    const t = (translations || []).find(t => t.lang === primary) || (translations || [])[0];
    return t ? (t.name || '') : '';
  }
%>

<div class="main">
  <header class="page-header page-header--minimal">
    <h2 class="page-header__title"><%= t('page.builder.title') %></h2>
    <%- include('./partials/lang-selector') %>
  </header>

  <main class="page-body page-body--minimal">
  <div class="card table-card smb-card">

    <div class="card__header card__header--brand">
      <h3 class="card__title"><%= t('page.builder.card_title') %></h3>
      <button onclick="openAddCategoryModal()" class="btn btn--pill btn--outline-accent-on-dark btn--sm"><%= t('page.builder.btn_create_category') %></button>
    </div>

    <div class="smb-tabs">
      <button class="smb-tabs__btn smb-tabs__btn--active" id="smb-tab-list" onclick="showListTab()"><%= t('page.builder.tab_categories') %></button>
      <button class="smb-tabs__btn" id="smb-tab-detail" onclick="showDetailTab()"><%= t('page.builder.tab_builder') %></button>
    </div>

    <div class="smb-split" id="smb-split">

    <!-- ── LEFT PANEL (SIDEBAR) ─────────────────────────────────────── -->
    <div class="smb-panel">
      <div class="smb-panel__header smb-panel__header--col">
        <h4 class="smb-panel__title"><%= t('page.builder.panel_title') %></h4>
        <label class="toggle-switch">
          <input type="checkbox" id="inactive-toggle-checkbox" onchange="toggleInactiveView()">
          <span class="toggle-switch__track">
            <span class="toggle-switch__label toggle-switch__label--left"><%= t('page.builder.toggle_live') %></span>
            <span class="toggle-switch__slider"></span>
            <span class="toggle-switch__label toggle-switch__label--right"><%= t('page.builder.toggle_off') %></span>
          </span>
        </label>
      </div>

      <div class="smb-panel__list" id="builder-list">
        <% if (categories.length === 0) { %>
          <div class="smb-panel__empty"><%= t('page.builder.empty_no_categories') %></div>
        <% } %>

        <!-- Active categories -->
        <div id="builder-cats">
          <% categories.filter(cat => cat.is_active).forEach(cat => { %>
            <div class="builder-cat-group is-collapsed" data-cat-id="<%= cat.id %>">
              <div class="smb-item" data-cat-id="<%= cat.id %>">
                <span class="smb-item__handle">&#8801;</span>
                <% if (cat.children && cat.children.length > 0) { %>
                  <svg class="icon builder-chevron builder-chevron--collapsed" onclick="toggleCatCollapse(event, <%= cat.id %>)"><use href="/admin/icons/sprite.svg#chevron-down"></use></svg>
                <% } else { %>
                  <span class="builder-chevron-spacer"></span>
                <% } %>
                <div class="smb-item__info" onclick="selectCategory(<%= cat.id %>)">
                  <span class="smb-item__name"><%= catName(cat) %></span>
                  <% if (cat.children && cat.children.length > 0) { %>
                    <span class="smb-item__price"><%= cat.children.filter(s => s.is_active).length %> <%= t('page.builder.subs_label') %></span>
                  <% } else { %>
                    <span class="smb-item__price"><%= cat._count ? (cat._count.menu_item_categories + cat._count.set_menu_categories) : 0 %> items</span>
                  <% } %>
                </div>
              </div>

              <% if (cat.children && cat.children.length > 0) { %>
                <div class="builder-subs hidden" id="builder-subs-<%= cat.id %>" data-parent-id="<%= cat.id %>">
                  <% cat.children.filter(sub => sub.is_active).forEach(sub => { %>
                    <div class="smb-item smb-item--sub" data-cat-id="<%= sub.id %>" onclick="selectCategory(<%= sub.id %>)">
                      <div class="smb-item__info">
                        <span class="smb-item__name"><%= catName(sub) %></span>
                        <span class="smb-item__price"><%= sub._count ? (cat.slug === 'set-menus' ? sub._count.set_menu_categories : (sub._count.menu_item_categories + sub._count.set_menu_categories)) : 0 %> <%= cat.slug === 'set-menus' ? t('page.builder.set_menu_label') : t('page.builder.items_label') %></span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>

        <!-- Inactive categories (hidden by default, populated by JS) -->
        <div id="builder-inactive" class="hidden"></div>
      </div>
    </div>

    <!-- ── RIGHT BUILDER ──────────────────────────────────────────── -->
    <div class="smb-builder">

      <!-- Empty state -->
      <div class="smb-empty" id="builder-empty">
        <div class="empty-state__icon">
          <svg class="icon icon--empty-state"><use href="/admin/icons/sprite.svg#categories"></use></svg>
        </div>
        <p class="empty-state__text"><%= t('page.builder.empty_select') %></p>
        <button onclick="openAddCategoryModal()" class="btn btn--pill btn--outline-brand btn--sm"><%= t('page.builder.btn_add_new_category') %></button>
      </div>

      <!-- Builder content (JS-rendered) -->
      <div class="smb-content hidden" id="builder-content">

        <!-- Sticky header -->
        <div class="smb-header">
          <div class="smb-header__row">
            <h3 class="smb-header__name" id="builder-name">—</h3>
            <span class="smb-header__count" id="builder-count"></span>
            <div id="builder-langs" class="tag-list smb-header__langs"></div>
            <label class="smb-avail-switch" title="<%= t('common.tooltip_toggle_avail') %>">
              <input type="checkbox" id="builder-avail-chk" onchange="toggleAvailability()">
              <span class="smb-avail-label" id="builder-avail-label"><%= t('common.live') %></span>
            </label>
            <div class="smb-header__actions">
              <button class="btn-view" onclick="openCatViewModal(activeCatId)" title="<%= t('common.tooltip_view') %>">
                <svg class="icon icon-closed"><use href="/admin/icons/sprite.svg#eye-closed"></use></svg>
                <svg class="icon icon-open"><use href="/admin/icons/sprite.svg#eye-open"></use></svg>
              </button>
              <button class="btn-delete" id="builder-delete-btn" onclick="confirmDeleteCat()" title="<%= t('common.tooltip_delete') %>">
                <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="15" y1="9" x2="9" y2="15"/>
                  <line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="smb-header__bar">
            <img id="builder-cat-img" src="" alt="" class="table-thumb table-thumb--clickable hidden"
                 onclick="openCatEditLightbox(this.src)" />
            <div id="builder-cat-placeholder" class="table-thumb-placeholder">
              <svg class="icon"><use href="/admin/icons/sprite.svg#categories"></use></svg>
            </div>
            <div class="category-breadcrumbs smb-header__cats" id="builder-breadcrumb"></div>
            <button class="btn btn--pill link--slide" onclick="openAddSubModal(activeCatId, activeCatName)" id="builder-add-sub-btn"><%= t('page.builder.btn_add_sub') %></button>
            <button class="btn btn--pill link--slide" id="builder-add-item-btn" onclick="openAddToCatModal(activeCatId, activeCatName)"><%= t('page.builder.btn_add_item') %></button>
            <a href="/admin/set-menus" class="btn btn--pill link--slide hidden" id="builder-manage-sm-btn"><%= t('page.builder.btn_manage_set_menus') %></a>
          </div>
        </div>

        <!-- Scrollable body -->
        <div class="smb-body" id="builder-body">
          <!-- Subcategories with nested items rendered by JS -->
        </div>

      </div>
    </div>

    </div><!-- /.smb-split -->
  </div><!-- /.smb-card -->
  </main><!-- /.page-body -->
</div><!-- /.main -->

<%- include('./partials/modals/create-edit/category', { langs, primary, categories }) %>
<%- include('./partials/modals/view/category') %>
<%- include('./partials/modals/create-edit/menu-item', { langs, primary, categories, allergens, dietaryTags, catName, tagName }) %>
<%- include('./partials/modals/view/menu-item') %>
<%- include('./partials/modals/view/set-menu', { langs, primary }) %>
<%- include('./partials/modals/add/add-item', { langs, primary }) %>

<%- include('./partials/scripts') %>
<script src="/admin/js/sortable.min.js"></script>
<script src="/admin/js/builder-sortable.js"></script>
<script>
// ── Data ─────────────────────────────────────────────────────────────────────
let CATS_DATA     = <%- JSON.stringify(categories) %>;
const LANGS       = <%- JSON.stringify(langs) %>;
const PRIMARY     = '<%= primary %>';
const ALL_ITEMS   = <%- JSON.stringify(allItems) %>;
const ALL_SET_MENUS = <%- JSON.stringify(allSetMenus) %>;

// Flat category list — needed by view modals for parent breadcrumbs
const ALL_CATS = [];
CATS_DATA.forEach(c => { ALL_CATS.push(c); (c.children || []).forEach(s => ALL_CATS.push(s)); });

// Aliases expected by the shared view modal scripts
let ITEMS_DATA      = ALL_ITEMS;
const CATEGORIES_DATA = ALL_CATS;
let SM_DATA         = [];

let activeCatId   = null;
let activeCatName = '';
let _sortables    = [];

const SCROLL_OPTS = { scroll: document.getElementById('builder-list'), scrollSensitivity: 80, scrollSpeed: 12 };

// ── Helpers ──────────────────────────────────────────────────────────────────
function getName(translations) {
  if (!translations || !translations.length) return '—';
  const t = translations.find(t => t.lang === PRIMARY) || translations[0];
  return t ? (t.name || '—') : '—';
}

function esc(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

// ── Mobile tab switching ──────────────────────────────────────────────────────
function showListTab() {
  document.getElementById('smb-split').classList.remove('smb-split--detail');
  document.getElementById('smb-tab-list').classList.add('smb-tabs__btn--active');
  document.getElementById('smb-tab-detail').classList.remove('smb-tabs__btn--active');
}

function showDetailTab() {
  document.getElementById('smb-split').classList.add('smb-split--detail');
  document.getElementById('smb-tab-detail').classList.add('smb-tabs__btn--active');
  document.getElementById('smb-tab-list').classList.remove('smb-tabs__btn--active');
}

// ── Panel selection ───────────────────────────────────────────────────────────
function selectCategory(id) {
  activeCatId = id;
  sessionStorage.setItem('builder-active', id);

  document.querySelectorAll('.smb-item').forEach(el =>
    el.classList.toggle('smb-item--active', parseInt(el.dataset.catId) === id)
  );
  document.querySelectorAll('.inactive-item').forEach(el =>
    el.classList.toggle('inactive-item--active', parseInt(el.dataset.catId) === id)
  );

  const cat = findCategory(id);
  if (cat) {
    activeCatName = getName(cat.translations);
    renderBuilder(cat);
  }
  showDetailTab();
}

function findCategory(id) {
  for (const cat of CATS_DATA) {
    if (cat.id === id) return cat;
    if (cat.children) {
      for (const sub of cat.children) {
        if (sub.id === id) return sub;
      }
    }
  }
  return null;
}

function isItemUnreachable(itemId) {
  const item = ALL_ITEMS.find(i => i.id === itemId);
  if (!item || !item.is_available) return false;
  for (const cat of CATS_DATA) {
    if ((cat.menu_item_categories || []).some(mic => mic.menu_item?.id === itemId) && cat.is_active) return false;
    for (const sub of (cat.children || [])) {
      if ((sub.menu_item_categories || []).some(mic => mic.menu_item?.id === itemId) && sub.is_active && cat.is_active) return false;
    }
  }
  return true;
}

function isSetMenuUnreachable(setMenuId) {
  const sm = ALL_SET_MENUS.find(s => s.id === setMenuId);
  if (!sm || !sm.is_available) return false;
  for (const cat of CATS_DATA) {
    if ((cat.set_menu_categories || []).some(smc => smc.set_menu?.id === setMenuId) && cat.is_active) return false;
    for (const sub of (cat.children || [])) {
      if ((sub.set_menu_categories || []).some(smc => smc.set_menu?.id === setMenuId) && sub.is_active && cat.is_active) return false;
    }
  }
  return true;
}

function refreshBuilderBody() {
  const cat = activeCatId ? findCategory(activeCatId) : null;
  if (cat) renderBuilder(cat);
}

// ── Builder render ────────────────────────────────────────────────────────────
function renderBuilder(cat) {
  document.getElementById('builder-empty').classList.add('hidden');
  document.getElementById('builder-content').classList.remove('hidden');

  const parent           = cat.parent_id ? CATS_DATA.find(c => c.id === cat.parent_id) : null;
  const isSetMenuContext = cat.slug === 'set-menus' || parent?.slug === 'set-menus';
  const itemLabel        = isSetMenuContext ? tUI('page.builder.set_menu_singular') : tUI('page.builder.item_singular');
  const itemsLabel       = isSetMenuContext ? tUI('page.builder.set_menu_label') : tUI('page.builder.items_label');
  const totalItems = (() => {
    const countFor = c => isSetMenuContext
      ? (c._count?.set_menu_categories  || 0)
      : (c._count?.menu_item_categories || 0) + (c._count?.set_menu_categories || 0);
    if (!cat.parent_id && cat.children && cat.children.length > 0) {
      return cat.children.reduce((sum, sub) => sum + countFor(sub), 0) + countFor(cat);
    }
    return countFor(cat);
  })();

  // Header name + count
  document.getElementById('builder-name').textContent = getName(cat.translations);
  if (!cat.parent_id && cat.children && cat.children.length > 0) {
    const subsCount = cat.children.length;
    document.getElementById('builder-count').textContent =
      `${subsCount} ${tUI('page.builder.subs_label')} · ${totalItems} ${totalItems !== 1 ? itemsLabel : itemLabel}`;
  } else {
    document.getElementById('builder-count').textContent =
      `${totalItems} ${totalItems !== 1 ? itemsLabel : itemLabel}`;
  }

  // Availability toggle
  const chk = document.getElementById('builder-avail-chk');
  chk.checked = cat.is_active;
  const lbl = document.getElementById('builder-avail-label');
  lbl.textContent = cat.is_active ? tUI('common.live') : tUI('common.off');
  lbl.className   = `smb-avail-label smb-avail-label--${cat.is_active ? 'on' : 'off'}`;

  // Breadcrumb
  const breadcrumbEl = document.getElementById('builder-breadcrumb');
  if (cat.parent_id && parent) {
    breadcrumbEl.innerHTML = `<div class="breadcrumb-text"><span class="breadcrumb-muted">${esc(getName(parent.translations))}<span class="breadcrumb-sep"> › </span></span>${esc(getName(cat.translations))}</div>`;
  } else {
    breadcrumbEl.innerHTML = '';
  }

  // Category image
  const catImg         = document.getElementById('builder-cat-img');
  const catPlaceholder = document.getElementById('builder-cat-placeholder');
  if (cat.image_url) {
    catImg.src = cat.image_url;
    catImg.classList.remove('hidden');
    catPlaceholder.classList.add('hidden');
  } else {
    catImg.src = '';
    catImg.classList.add('hidden');
    catPlaceholder.classList.remove('hidden');
  }

  // Language completion tags
  const langsEl = document.getElementById('builder-langs');
  const completedLangs = LANGS.filter(lang => {
    const t = (cat.translations || []).find(t => t.lang === lang);
    return t && t.name;
  });
  langsEl.innerHTML = completedLangs.length
    ? completedLangs.map(l => `<span class="tag tag--lang">${esc(l.toUpperCase())}</span>`).join('')
    : '<span class="cell-empty">—</span>';

  // +Sub button: only for top-level categories
  document.getElementById('builder-add-sub-btn').classList.toggle('hidden', !!cat.parent_id);

  // +Item is always present and always opens the modal (function detects context)
  // Manage Set Menus: only for the set-menus category context
  document.getElementById('builder-manage-sm-btn').classList.toggle('hidden', !isSetMenuContext);

  // Delete button: disabled for protected categories
  const deleteBtn = document.getElementById('builder-delete-btn');
  if (deleteBtn) deleteBtn.disabled = !!cat.is_protected;

  // Body: subcategory sections + direct items
  const bodyEl = document.getElementById('builder-body');
  if (!cat.parent_id && cat.children && cat.children.length > 0) {
    const subcatSections = cat.children.map(sub => renderSubcatSection(sub)).join('');
    const directItems    = renderDirectItemsSection(cat.menu_item_categories || [], cat.set_menu_categories || [], cat.id, cat.is_active);
    bodyEl.innerHTML = subcatSections + directItems;
  } else {
    bodyEl.innerHTML = renderDirectItemsSection(cat.menu_item_categories || [], cat.set_menu_categories || [], cat.id, cat.is_active);
  }

  if (!bodyEl.innerHTML.trim()) {
    const isSub = !!cat.parent_id;
    bodyEl.innerHTML = `
      <div class="smb-body-empty">
        <p class="smb-body-empty__text">${isSub ? tUI('page.builder.empty_no_items_sub') : tUI('page.builder.empty_no_items_cat')}</p>
        <div class="smb-body-empty__actions">
          <button onclick="openAddToCatModal(activeCatId, activeCatName)" class="btn btn--pill btn--outline-brand btn--sm">${tUI('page.builder.btn_add_to_sub')}</button>
          ${isSetMenuContext ? `<a href="/admin/set-menus" class="btn btn--pill btn--outline-brand btn--sm">${tUI('page.builder.btn_manage_set_menus')}</a>` : ''}
          ${!isSub ? `<button onclick="openAddSubModal(activeCatId, activeCatName)" class="btn btn--pill btn--outline-brand btn--sm">${tUI('page.builder.btn_add_sub')}</button>` : ''}
        </div>
      </div>`;
  }

  initSortables(cat.id);
}

function renderSubcatSection(sub) {
  const subParent    = CATS_DATA.find(c => c.id === sub.parent_id);
  const isSetMenuSub = subParent?.slug === 'set-menus';
  const itemCount    = isSetMenuSub
    ? (sub.set_menu_categories?.length || 0)
    : (sub.menu_item_categories?.length || 0) + (sub.set_menu_categories?.length || 0);
  const subItemLabel  = isSetMenuSub ? tUI('page.builder.set_menu_singular') : tUI('page.builder.item_singular');
  const subItemsLabel = isSetMenuSub ? tUI('page.builder.set_menu_label') : tUI('page.builder.items_label');
  const dishes       = (sub.menu_item_categories || []).map(mic => renderDishRow(mic, sub.id)).join('');
  const setMenus     = (sub.set_menu_categories  || []).map(smc => renderSetMenuRow(smc, sub.id)).join('');

  return `
    <div class="smb-course${sub.is_active ? '' : ' smb-course--inactive'}" data-sub-id="${sub.id}">
      <div class="smb-course__head">
        <span class="bl-handle bl-handle--sm" title="${tUI('common.tooltip_drag_reorder')}">&#8801;</span>
        <div class="smb-course__meta">
          <span class="smb-course__name">${esc(getName(sub.translations))}</span>
          <span class="smb-course__count">${itemCount} ${itemCount !== 1 ? subItemsLabel : subItemLabel}</span>
        </div>
        <div class="smb-course__actions">
          <button onclick="openAddToCatModal(${sub.id}, '${esc(getName(sub.translations))}')" class="btn btn--pill link--slide btn--sm">${tUI('page.builder.btn_add_to_sub')}</button>
          ${isSetMenuSub ? `<a href="/admin/set-menus" class="btn btn--pill link--slide btn--sm">${tUI('page.builder.btn_manage_set_menus')}</a>` : ''}
          <label class="smb-avail-switch" title="${tUI('common.tooltip_toggle_vis')}">
            <input type="checkbox" ${sub.is_active ? 'checked' : ''} onchange="toggleSubAvailability(${sub.id}, this.checked)">
            <span class="smb-avail-label smb-avail-label--${sub.is_active ? 'on' : 'off'}">${sub.is_active ? tUI('common.live') : tUI('common.off')}</span>
          </label>
          <button class="btn-view" onclick="openCatViewModal(${sub.id})" title="${tUI('common.tooltip_view')}">
            <svg class="icon icon-closed"><use href="/admin/icons/sprite.svg#eye-closed"></use></svg>
            <svg class="icon icon-open"><use href="/admin/icons/sprite.svg#eye-open"></use></svg>
          </button>
          <button class="btn-delete" onclick="deleteCategory(${sub.id}, '${esc(getName(sub.translations))}')" title="${tUI('common.tooltip_delete')}">
            <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="smb-dish-list" data-cat-id="${sub.id}" id="dish-list-${sub.id}">
        ${dishes}${setMenus}
      </div>
    </div>`;
}

function renderDirectItemsSection(dishes, setMenus, catId, isActive = true) {
  const dishRows    = dishes.map(mic => renderDishRow(mic, catId)).join('');
  const setMenuRows = setMenus.map(smc => renderSetMenuRow(smc, catId)).join('');
  const allRows     = dishRows + setMenuRows;
  if (!allRows) return '';
  return `<div class="smb-dish-list${isActive ? '' : ' smb-course--inactive'}" data-cat-id="${catId}" id="dish-list-${catId}">${allRows}</div>`;
}

function renderDishRow(mic, catId) {
  const itemData = ALL_ITEMS.find(i => i.id === mic.menu_item.id);
  const isOff    = itemData && !itemData.is_available;
  const catData  = CATS_DATA.find(c => c.id === catId);
  const catName  = catData ? getName(catData.translations) : '';
  return `
    <div class="smb-dish${isOff ? ' smb-dish--inactive' : ''}" data-item-id="${mic.menu_item.id}">
      <span class="bl-handle bl-handle--dish" title="${tUI('common.tooltip_drag_move')}">&#8801;</span>
      <div class="smb-dish__info">
        <span class="smb-dish__name">${esc(getName(mic.menu_item.translations))}</span>
        ${isOff ? `<span class="smb-dish__badge smb-dish__badge--off">${tUI('common.off')}</span>` : ''}
      </div>
      <div class="smb-dish__actions">
        <button class="btn-view" onclick="openBuilderItemView(${mic.menu_item.id})" title="${tUI('common.tooltip_view')}">
          <svg class="icon icon-closed"><use href="/admin/icons/sprite.svg#eye-closed"></use></svg>
          <svg class="icon icon-open"><use href="/admin/icons/sprite.svg#eye-open"></use></svg>
        </button>
        <button class="btn-remove" data-item-name="${esc(getName(mic.menu_item.translations))}" data-location="${esc(catName)}" onclick="removeItemFromCat(${mic.menu_item.id}, ${catId}, this.dataset.itemName, this.dataset.location)" title="${tUI('common.tooltip_remove_from_cat')}">
          <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
          </svg>
        </button>
      </div>
    </div>`;
}

function renderSetMenuRow(smc, catId) {
  const smData  = ALL_SET_MENUS.find(s => s.id === smc.set_menu.id);
  const isOff   = smData && !smData.is_available;
  const catData = CATS_DATA.find(c => c.id === catId);
  const catName = catData ? getName(catData.translations) : '';
  return `
    <div class="smb-dish${isOff ? ' smb-dish--inactive' : ''}" data-set-menu-id="${smc.set_menu.id}">
      <span class="bl-handle bl-handle--dish" title="${tUI('common.tooltip_drag_move')}">&#8801;</span>
      <div class="smb-dish__info">
        <span class="smb-dish__name">${esc(getName(smc.set_menu.translations))}</span>
        <span class="smb-dish__meta">${tUI('page.builder.set_menu_singular')}</span>
        ${isOff ? `<span class="smb-dish__badge smb-dish__badge--off">${tUI('common.off')}</span>` : ''}
      </div>
      <div class="smb-dish__actions">
        <button class="btn-view" onclick="openBuilderSmView(${smc.set_menu.id})" title="${tUI('common.tooltip_view')}">
          <svg class="icon icon-closed"><use href="/admin/icons/sprite.svg#eye-closed"></use></svg>
          <svg class="icon icon-open"><use href="/admin/icons/sprite.svg#eye-open"></use></svg>
        </button>
        <button class="btn-remove" data-item-name="${esc(getName(smc.set_menu.translations))}" data-location="${esc(catName)}" onclick="removeSetMenuFromCat(${smc.set_menu.id}, ${catId}, this.dataset.itemName, this.dataset.location)" title="${tUI('common.tooltip_remove_from_cat')}">
          <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
          </svg>
        </button>
      </div>
    </div>`;
}

// ── Sortable ──────────────────────────────────────────────────────────────────

// Panel-level sortables (run once, not rebuilt on category change)
Sortable.create(document.getElementById('builder-cats'), {
  ...SCROLL_OPTS,
  handle:     '.smb-item__handle:not(.smb-item__handle--sub)',
  animation:  180,
  ghostClass: 'bl-ghost',
  dragClass:  'bl-dragging',
  onEnd() {
    const items = [...document.querySelectorAll('#builder-cats > .builder-cat-group')].map((el, i) => ({
      id:            parseInt(el.dataset.catId),
      display_order: i,
    }));
    api('PATCH', '/api/categories/reorder', { items })
      .catch(err => showToast(err.message, 'error'));
  },
});


function initSortables(catId) {
  _sortables.forEach(s => { try { s.destroy(); } catch(e) {} });
  _sortables = initBuilderSortables({
    sectionContainer: document.getElementById('builder-body'),
    sectionDataAttr:  'subId',
    itemGroupName:    `cat-${catId}-items`,
    scrollEl:         document.getElementById('builder-body'),
    onSectionReorder(items) {
      api('PATCH', '/api/categories/reorder', { items })
        .then(() => {
          const parentCat = CATS_DATA.find(c => c.id === catId);
          if (parentCat && parentCat.children) {
            const order = items.map(item => item.id);
            parentCat.children.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
          }
          refreshSidebar();
        })
        .catch(err => showToast(err.message, 'error'));
    },
    onItemEnd(evt) {
      const fromCatId = parseInt(evt.from.dataset.catId);
      const toCatId   = parseInt(evt.to.dataset.catId);
      const itemId    = evt.item.dataset.itemId    ? parseInt(evt.item.dataset.itemId)    : null;
      const setMenuId = evt.item.dataset.setMenuId ? parseInt(evt.item.dataset.setMenuId) : null;

      if (itemId) {
        if (fromCatId !== toCatId) {
          api('PATCH', `/api/menu-items/${itemId}/move`, {
            from_category_id: fromCatId,
            to_category_id:   toCatId,
          })
          .then(() => {
            reorderDishList(evt.to);
            adjustSubCount(fromCatId, -1, false);
            adjustSubCount(toCatId,   +1, false);
          })
          .catch(err => {
            showToast(err.status === 409 ? UI_MESSAGES.itemAlreadyInCategory : UI_MESSAGES.genericError, 'error');
            setTimeout(() => location.reload(), 3500);
          });
        } else {
          reorderDishList(evt.to);
        }
      } else if (setMenuId) {
        if (fromCatId !== toCatId) {
          api('PATCH', `/api/set-menus/${setMenuId}/move-category`, {
            from_category_id: fromCatId,
            to_category_id:   toCatId,
          })
          .then(() => {
            reorderSetMenuList(evt.to);
            adjustSubCount(fromCatId, -1, true);
            adjustSubCount(toCatId,   +1, true);
          })
          .catch(err => {
            showToast(err.status === 409 ? UI_MESSAGES.itemAlreadyInCategory : UI_MESSAGES.genericError, 'error');
            setTimeout(() => location.reload(), 3500);
          });
        } else {
          reorderSetMenuList(evt.to);
        }
      }
    },
  });
}

function reorderDishList(listEl) {
  const catId = parseInt(listEl.dataset.catId);
  const items = [...listEl.querySelectorAll(':scope > .smb-dish[data-item-id]')].map((el, i) => ({
    menu_item_id:  parseInt(el.dataset.itemId),
    display_order: i,
  }));
  if (!items.length) return;
  api('PATCH', '/api/menu-items/reorder', { category_id: catId, items })
    .catch(err => showToast(err.message, 'error'));
}

function reorderSetMenuList(listEl) {
  const catId = parseInt(listEl.dataset.catId);
  const items = [...listEl.querySelectorAll(':scope > .smb-dish[data-set-menu-id]')].map((el, i) => ({
    set_menu_id:   parseInt(el.dataset.setMenuId),
    display_order: i,
  }));
  if (!items.length) return;
  api('PATCH', '/api/set-menus/reorder-in-category', { category_id: catId, items })
    .catch(err => showToast(err.message, 'error'));
}

function adjustSubCount(catId, delta, isSetMenu) {
  const courseEl = document.querySelector(`.smb-course[data-sub-id="${catId}"]`);
  if (courseEl) {
    const el = courseEl.querySelector('.smb-course__count');
    if (el) {
      const m = el.textContent.match(/^(\d+)\s+(.+)$/);
      if (m) {
        const n  = Math.max(0, parseInt(m[1]) + delta);
        el.textContent = `${n} ${n !== 1 ? tUI(isSetMenu ? 'page.builder.set_menu_label' : 'page.builder.items_label') : tUI(isSetMenu ? 'page.builder.set_menu_singular' : 'page.builder.item_singular')}`;
      }
    }
  }
  const sidebarEl = document.querySelector(`.smb-item--sub[data-cat-id="${catId}"] .smb-item__price`);
  if (sidebarEl) {
    const m = sidebarEl.textContent.match(/^(\d+)\s+(.+)$/);
    if (m) {
      const n  = Math.max(0, parseInt(m[1]) + delta);
      sidebarEl.textContent = `${n} ${n !== 1 ? tUI(isSetMenu ? 'page.builder.set_menu_label' : 'page.builder.items_label') : tUI(isSetMenu ? 'page.builder.set_menu_singular' : 'page.builder.item_singular')}`;
    }
  }
  const cat = findCategory(catId);
  if (cat && cat._count) {
    if (isSetMenu) cat._count.set_menu_categories  = Math.max(0, (cat._count.set_menu_categories  || 0) + delta);
    else           cat._count.menu_item_categories = Math.max(0, (cat._count.menu_item_categories || 0) + delta);
  }
}

// ── Availability toggle ───────────────────────────────────────────────────────
async function toggleAvailability() {
  if (!activeCatId) return;
  const chk = document.getElementById('builder-avail-chk');
  try {
    await api('PUT', `/api/categories/${activeCatId}`, { is_active: chk.checked });
    const lbl = document.getElementById('builder-avail-label');
    lbl.textContent = chk.checked ? tUI('common.live') : tUI('common.off');
    lbl.className   = `smb-avail-label smb-avail-label--${chk.checked ? 'on' : 'off'}`;
    const cat = findCategory(activeCatId);
    if (cat) {
      cat.is_active = chk.checked;
      if (!cat.parent_id) {
        (cat.children || []).forEach(sub => { sub.is_active = chk.checked; });
      }
    }
    showToast(tr(chk.checked ? 'category_live' : 'category_hidden'));
    refreshSidebar();
    refreshBuilderBody();
  } catch (err) {
    chk.checked = !chk.checked;
    showToast(err.message, 'error');
  }
}

// ── Add item ──────────────────────────────────────────────────────────────────
function openAddToCatModal(catId, catNameStr) {
  const cat      = findCategory(catId);
  const parent   = cat?.parent_id ? CATS_DATA.find(c => c.id === cat.parent_id) : null;
  const isSetMenuContext = cat?.slug === 'set-menus' || parent?.slug === 'set-menus';

  // If viewing a parent with subs, require the user to pick a sub
  const subs = (cat && !cat.parent_id && cat.children && cat.children.length > 0)
    ? cat.children
    : [];

  const items = isSetMenuContext
    ? ALL_SET_MENUS.map(sm => ({
        id:   sm.id,
        name: getName(sm.translations),
        meta: 'set menu',
        type: 'set-menu',
      }))
    : [
        ...ALL_ITEMS.map(i => ({
          id:   i.id,
          name: getName(i.translations),
          meta: `€${Number(i.price).toFixed(2)}`,
          type: 'dish',
        })),
        ...ALL_SET_MENUS.map(sm => ({
          id:    sm.id,
          name:  getName(sm.translations),
          meta:  `€${Number(sm.price).toFixed(2)}`,
          label: 'set menu',
          type:  'set-menu',
        })),
      ];

  openAddItemModal({
    title:     catNameStr ? tUI('modal.add_dish_to', { name: catNameStr }) : tUI('modal.add_dish_generic'),
    items,
    sections:  subs.length > 0 ? subs.map(s => ({ id: s.id, name: s.is_active ? getName(s.translations) : `${getName(s.translations)} (off)` })) : null,
    sectionId: subs.length === 0 ? catId : undefined,
    canCreate: !isSetMenuContext,
    showNotes: false,
    onSubmit: async (itemId, itemType, { sectionId }) => {
      const targetCatId = sectionId;
      try {
        if (itemType === 'set-menu') {
          await api('POST', `/api/set-menus/${itemId}/add-to-category`, { category_id: targetCatId });
          showToast(tr('set_menu_added_to_category'));
        } else {
          await api('POST', `/api/menu-items/${itemId}/add-to-category`, { category_id: targetCatId });
          showToast(tr('item_added_to_category'));
        }
        reloadAfter();
      } catch (err) {
        showToast(err.status === 409 ? UI_MESSAGES.itemAlreadyInCategory : err.message, 'error');
      }
    },
  });
}

function removeItemFromCat(itemId, catId, name, location) {
  confirmRemove(name, location, async () => {
    try {
      await api('DELETE', `/api/menu-items/${itemId}/categories/${catId}`);
      showToast(tr('item_removed_from_category'));
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  });
}

function removeSetMenuFromCat(setMenuId, catId, name, location) {
  confirmRemove(name, location, async () => {
    try {
      await api('DELETE', `/api/set-menus/${setMenuId}/categories/${catId}`);
      showToast(tr('set_menu_removed_from_category'));
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  });
}

// ── Category status toggle (inactive panel) ───────────────────────────────────
async function toggleCategoryStatus(id, checked) {
  try {
    await api('PUT', `/api/categories/${id}`, { is_active: checked });
    const cat = findCategory(id);
    if (cat) {
      cat.is_active = checked;
      if (!cat.parent_id) {
        (cat.children || []).forEach(sub => { sub.is_active = checked; });
      }
    }
    showToast(tr(checked ? 'category_live' : 'category_hidden'));
    refreshSidebar();
    refreshBuilderBody();
  } catch (err) { showToast(err.message, 'error'); }
}

async function toggleSubAvailability(subId, checked) {
  try {
    await api('PUT', `/api/categories/${subId}`, { is_active: checked });
    const sub = findCategory(subId);
    if (sub) sub.is_active = checked;
    const courseEl = document.querySelector(`.smb-course[data-sub-id="${subId}"]`);
    if (courseEl) {
      const lbl = courseEl.querySelector('.smb-avail-label');
      if (lbl) {
        lbl.textContent = checked ? tUI('common.live') : tUI('common.off');
        lbl.className   = `smb-avail-label smb-avail-label--${checked ? 'on' : 'off'}`;
      }
    }
    showToast(tr(checked ? 'subcategory_live' : 'subcategory_hidden'));
    refreshSidebar();
    refreshBuilderBody();
  } catch (err) {
    const courseEl = document.querySelector(`.smb-course[data-sub-id="${subId}"]`);
    if (courseEl) {
      const chk = courseEl.querySelector('input[type="checkbox"]');
      if (chk) chk.checked = !checked;
    }
    showToast(err.message, 'error');
  }
}

// ── View modal helpers ────────────────────────────────────────────────────────
async function openBuilderItemView(itemId) {
  try {
    const r    = await api('GET', `/api/menu-items/${itemId}`);
    const item = r.data.item;
    const idx  = ITEMS_DATA.findIndex(i => i.id === item.id);
    if (idx !== -1) ITEMS_DATA[idx] = item; else ITEMS_DATA.push(item);
    openViewModal(itemId);
  } catch (err) { showToast(err.message, 'error'); }
}

async function openBuilderSmView(setMenuId) {
  try {
    const r = await api('GET', `/api/set-menus/${setMenuId}`);
    SM_DATA = [r.data.setMenu];
    openSmViewModal(setMenuId);
  } catch (err) { showToast(err.message, 'error'); }
}

// Redirect "Edit Set Menu" in the view modal to the set-menus page
function _smViewToEdit() {
  closeModal('smViewModal');
  window.location.href = '/admin/set-menus';
}

function confirmDeleteCat() {
  if (!activeCatId) return;
  const cat = findCategory(activeCatId);
  if (!cat) return;
  if (cat.is_protected) {
    showToast(tr('category_protected'), 'error');
    return;
  }
  deleteCategory(activeCatId, getName(cat.translations));
}

// ── Collapse/Expand ───────────────────────────────────────────────────────────
function toggleCatCollapse(event, catId) {
  event.stopPropagation();
  const group   = document.querySelector(`.builder-cat-group[data-cat-id="${catId}"]`);
  const chevron = event.currentTarget;
  const subsEl  = document.getElementById(`builder-subs-${catId}`);
  if (!group || !subsEl) return;
  const isCollapsed = group.classList.toggle('is-collapsed');
  chevron.classList.toggle('builder-chevron--collapsed', isCollapsed);
  subsEl.classList.toggle('hidden', isCollapsed);
}

// ── Toggle Inactive View ──────────────────────────────────────────────────────
let showingInactive = false;

function toggleInactiveView() {
  showingInactive = document.getElementById('inactive-toggle-checkbox').checked;
  document.getElementById('builder-cats').classList.toggle('hidden', showingInactive);
  document.getElementById('builder-inactive').classList.toggle('hidden', !showingInactive);
  if (showingInactive) renderInactiveList();
}

function renderInactiveList() {
  const inactiveCatsEl  = document.getElementById('builder-inactive');
  const inactiveParents = CATS_DATA.filter(cat => !cat.is_active);
  const inactiveSubs    = [];
  CATS_DATA.forEach(cat => {
    (cat.children || []).forEach(sub => { if (!sub.is_active) inactiveSubs.push(sub); });
  });

  inactiveParents.sort((a, b) => getName(a.translations).localeCompare(getName(b.translations)));
  inactiveSubs.sort((a, b)    => getName(a.translations).localeCompare(getName(b.translations)));

  let html = '';

  if (inactiveParents.length > 0) {
    html += `<div class="inactive-section"><h4 class="inactive-section__title">${tUI('page.builder.inactive_section_categories')}</h4>`;
    inactiveParents.forEach(cat => {
      html += `
        <div class="inactive-item" data-cat-id="${cat.id}">
          <div class="inactive-item__info" onclick="selectCategory(${cat.id})">
            <span class="inactive-item__name">${esc(getName(cat.translations))}</span>
          </div>
          <label class="smb-avail-switch">
            <input type="checkbox" onchange="toggleCategoryStatus(${cat.id}, this.checked)" />
            <span class="smb-avail-label smb-avail-label--off">${tUI('page.builder.btn_activate')}</span>
          </label>
        </div>`;
    });
    html += '</div>';
  }

  if (inactiveSubs.length > 0) {
    html += `<div class="inactive-section"><h4 class="inactive-section__title">${tUI('page.builder.inactive_section_subcategories')}</h4>`;
    inactiveSubs.forEach(sub => {
      const parent     = CATS_DATA.find(p => p.id === sub.parent_id);
      const parentName = parent ? getName(parent.translations) : '';
      html += `
        <div class="inactive-item" data-cat-id="${sub.id}">
          <div class="inactive-item__info" onclick="selectCategory(${sub.id})">
            <span class="inactive-item__name">${esc(getName(sub.translations))}</span>
            ${parentName ? `<span class="inactive-item__parent">in ${esc(parentName)}</span>` : ''}
          </div>
          <label class="smb-avail-switch">
            <input type="checkbox" onchange="toggleCategoryStatus(${sub.id}, this.checked)" />
            <span class="smb-avail-label smb-avail-label--off">${tUI('page.builder.btn_activate')}</span>
          </label>
        </div>`;
    });
    html += '</div>';
  }

  if (!inactiveParents.length && !inactiveSubs.length) {
    html = `<div class="smb-panel__empty">${tUI('page.builder.empty_no_inactive')}</div>`;
  }

  inactiveCatsEl.innerHTML = html;
}

function renderSidebarActiveList() {
  const activeCatsEl = document.getElementById('builder-cats');
  const expanded = new Set(
    [...document.querySelectorAll('.builder-cat-group:not(.is-collapsed)')].map(el => parseInt(el.dataset.catId))
  );
  const active = CATS_DATA.filter(cat => cat.is_active);

  activeCatsEl.innerHTML = active.map(cat => {
    const hasSubs    = cat.children && cat.children.length > 0;
    const activeSubs = hasSubs ? cat.children.filter(s => s.is_active) : [];

    const chevron = hasSubs
      ? `<svg class="icon builder-chevron builder-chevron--collapsed" onclick="toggleCatCollapse(event, ${cat.id})"><use href="/admin/icons/sprite.svg#chevron-down"></use></svg>`
      : `<span class="builder-chevron-spacer"></span>`;

    const countHtml = hasSubs
      ? `<span class="smb-item__price">${activeSubs.length} ${tUI('page.builder.subs_label')}</span>`
      : `<span class="smb-item__price">${cat._count ? (cat._count.menu_item_categories + cat._count.set_menu_categories) : 0} ${tUI('page.builder.items_label')}</span>`;

    const subsHtml = hasSubs ? `
      <div class="builder-subs hidden" id="builder-subs-${cat.id}" data-parent-id="${cat.id}">
        ${activeSubs.map(sub => `
          <div class="smb-item smb-item--sub" data-cat-id="${sub.id}" onclick="selectCategory(${sub.id})">
            <div class="smb-item__info">
              <span class="smb-item__name">${esc(getName(sub.translations))}</span>
              <span class="smb-item__price">${sub._count ? (cat.slug === 'set-menus' ? sub._count.set_menu_categories : (sub._count.menu_item_categories + sub._count.set_menu_categories)) : 0} ${cat.slug === 'set-menus' ? tUI('page.builder.set_menu_label') : tUI('page.builder.items_label')}</span>
            </div>
          </div>`).join('')}
      </div>` : '';

    return `
      <div class="builder-cat-group is-collapsed" data-cat-id="${cat.id}">
        <div class="smb-item" data-cat-id="${cat.id}">
          <span class="smb-item__handle">&#8801;</span>
          ${chevron}
          <div class="smb-item__info" onclick="selectCategory(${cat.id})">
            <span class="smb-item__name">${esc(getName(cat.translations))}</span>
            ${countHtml}
          </div>
        </div>
        ${subsHtml}
      </div>`;
  }).join('');

  expanded.forEach(id => {
    const group   = document.querySelector(`.builder-cat-group[data-cat-id="${id}"]`);
    const subsEl  = document.getElementById(`builder-subs-${id}`);
    const chevron = group?.querySelector('.builder-chevron');
    if (group && subsEl) {
      group.classList.remove('is-collapsed');
      subsEl.classList.remove('hidden');
      if (chevron) chevron.classList.remove('builder-chevron--collapsed');
    }
  });
}

function refreshSidebar() {
  renderSidebarActiveList();
  if (showingInactive) renderInactiveList();
  // Restore active selection highlights
  document.querySelectorAll('.smb-item').forEach(el =>
    el.classList.toggle('smb-item--active', parseInt(el.dataset.catId) === activeCatId)
  );
  document.querySelectorAll('.inactive-item').forEach(el =>
    el.classList.toggle('inactive-item--active', parseInt(el.dataset.catId) === activeCatId)
  );
}

// ── Init ──────────────────────────────────────────────────────────────────────
(function init() {
  const lastId = parseInt(sessionStorage.getItem('builder-active'));
  if (lastId && findCategory(lastId)) {
    selectCategory(lastId);
  } else if (CATS_DATA.length > 0) {
    selectCategory(CATS_DATA[0].id);
  }
})();
</script>

