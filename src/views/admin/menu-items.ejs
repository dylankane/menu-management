<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Menu Items', restaurantName }) %>
<body>

<%- include('../partials/sidebar', { current, user, restaurantName }) %>

<%
  const primary = settings.primary_language || 'en';
  const langs   = settings.enabled_languages || ['en', 'es'];

  function itemName(item) {
    const t = (item.translations || []).find(t => t.lang === primary)
           || (item.translations || [])[0];
    return t ? (t.name || '—') : '—';
  }
  function tagName(translations) {
    const t = (translations || []).find(t => t.lang === primary) || (translations || [])[0];
    return t ? (t.name || '') : '';
  }
  function catName(cat) {
    return tagName(cat.translations);
  }
  // Returns the parent category object for a subcategory, or null
  function parentCat(cat) {
    if (!cat.parent_id) return null;
    return categories.find(c => c.id === cat.parent_id) || null;
  }
%>

<div class="main">
  <header class="page-header page-header--minimal">
    <h2 class="page-header__title">Menu Items</h2>
    <%- include('../partials/lang-selector') %>
  </header>

  <main class="page-body page-body--minimal">
    <div class="card table-card">
      <div class="card__header card__header--brand">
        <h3 class="card__title">Menu Items</h3>
        <button type="button" class="filter-toggle" id="filterToggle" onclick="toggleFilterBar()" title="Search & filter">
          <svg class="icon" style="width:1.1rem;height:1.1rem;"><use href="/icons/sprite.svg#search"></use></svg>
        </button>
        <button onclick="openAddDishModal()" class="btn btn--pill btn--outline-accent-on-dark btn--sm">+ Add Dish</button>
      </div>
      <div class="filter-bar" id="filterBar">
        <input type="text" id="searchInput" placeholder="Search by name..." oninput="filterItems()" class="form-input" style="width:15rem;" />
        <select id="categoryFilter" onchange="filterItems()" class="form-select" style="width:auto;">
          <option value="">All categories</option>
          <% categories.filter(c => !c.parent_id).forEach(cat => { %>
            <option value="<%= cat.id %>"><%= catName(cat) %></option>
            <% if (cat.children) cat.children.forEach(child => { %>
              <option value="<%= child.id %>">&nbsp;&nbsp;↳ <%= catName(child) %></option>
            <% }) %>
          <% }) %>
        </select>
        <div class="filter-radios">
          <label class="form-check">
            <input type="radio" name="availFilter" value="all" onchange="filterItems()" checked />
            <span class="form-check__label">All</span>
          </label>
          <label class="form-check">
            <input type="radio" name="availFilter" value="active" onchange="filterItems()" />
            <span class="form-check__label">Active</span>
          </label>
          <label class="form-check">
            <input type="radio" name="availFilter" value="inactive" onchange="filterItems()" />
            <span class="form-check__label">Inactive</span>
          </label>
        </div>
        <span id="itemCount" class="filter-bar__count"></span>
      </div>
      <% if (items.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state__icon">
            <svg class="icon icon--empty-state"><use href="/icons/sprite.svg#menu-items"></use></svg>
          </div>
          <p class="empty-state__text">No dishes yet</p>
          <button onclick="openAddDishModal()" class="btn btn--pill btn--outline-brand btn--sm">+ Add Dish</button>
        </div>
      <% } else { %>
        <table class="data-table" id="itemsTable">
          <tbody id="itemsBody">
            <% items.forEach(item => { %>
              <tr class="item-row"
                  data-name="<%= itemName(item).toLowerCase() %>"
                  data-categories="<%= item.categories.map(c => c.category_id).join(',') %>"
                  data-available="<%= item.is_available %>">
                <td class="col-thumb col-align-left">
                  <% if (item.image_url) { %>
                    <img src="<%= item.image_url %>" alt="" class="table-thumb table-thumb--clickable"
                         onclick="openLightbox('<%= item.image_url %>')" />
                  <% } else { %>
                    <div class="table-thumb-placeholder">🍴</div>
                  <% } %>
                </td>
                <td class="col-name col-align-left col-max-width">
                  <p class="table-item__name"><%= itemName(item) %></p>
                  <% const desc = (item.translations || []).find(t => t.lang === primary)?.description || (item.translations || [])[0]?.description || ''; %>
                  <% if (desc) { %>
                    <p class="table-item__desc"><%= desc.length > 80 ? desc.substring(0, 80) + '...' : desc %></p>
                  <% } %>
                </td>
                <td class="col-categories col-align-left">
                  <div class="category-breadcrumbs">
                    <% let hasContent = false; %>
                    <% item.categories.forEach(c => { %>
                      <% hasContent = true; %>
                      <% const parent = parentCat(c.category); %>
                      <% if (parent) { %>
                        <div class="breadcrumb-text"><span class="breadcrumb-muted"><%= catName(parent) %><span class="breadcrumb-sep"> › </span></span><%= catName(c.category) %></div>
                      <% } else { %>
                        <div class="breadcrumb-text"><%= catName(c.category) %></div>
                      <% } %>
                    <% }); %>
                    <% if (item.is_special) { %>
                      <% hasContent = true; %>
                      <div class="breadcrumb-text">Chef's Special</div>
                    <% } %>
                    <% if (!hasContent) { %>
                      <span class="cell-empty">—</span>
                    <% } %>
                  </div>
                </td>
                <td class="col-translations col-align-center">
                  <div class="tag-list">
                    <% const translatedLangs = (item.translations || []).filter(t => t.name && t.description).map(t => t.lang); %>
                    <% translatedLangs.forEach(lang => { %>
                      <span class="tag tag--lang"><%= lang.toUpperCase() %></span>
                    <% }); %>
                    <% if (translatedLangs.length === 0) { %>
                      <span class="cell-empty">—</span>
                    <% } %>
                  </div>
                </td>
                <td class="col-tags col-align-left">
                  <div class="tag-status">
                    <div class="tag-status__item">
                      <span class="tag-status__label">Allergens:</span>
                      <span class="tag-status__dot <%= (item.allergen_tags && item.allergen_tags.length > 0) ? 'tag-status__dot--success' : 'tag-status__dot--danger' %>"></span>
                    </div>
                    <div class="tag-status__item">
                      <span class="tag-status__label">Dietary:</span>
                      <span class="tag-status__dot <%= (item.dietary_tags && item.dietary_tags.length > 0) ? 'tag-status__dot--success' : 'tag-status__dot--danger' %>"></span>
                    </div>
                  </div>
                </td>
                <td class="col-price col-align-center">
                  <span class="item-price">€<%= Number(item.price).toFixed(2) %></span>
                  <% if (item.has_discount && item.discount_value) { %>
                    <br/><span class="item-discount">
                      -<%= item.discount_type === 'percent' ? item.discount_value + '%' : '€' + Number(item.discount_value).toFixed(2) %>
                    </span>
                  <% } %>
                </td>
                <td class="col-toggle col-align-center">
                  <label class="smb-avail-switch" onclick="toggleAvailability(<%= item.id %>, <%= item.is_available %>)">
                    <input type="checkbox" <%= item.is_available ? 'checked' : '' %> readonly tabindex="-1" />
                    <span class="smb-avail-label <%= item.is_available ? 'smb-avail-label--on' : 'smb-avail-label--off' %>">
                      <%= item.is_available ? 'Live' : 'Off' %>
                    </span>
                  </label>
                </td>
                <td class="col-details col-align-center">
                  <button class="btn-view" onclick="openViewModal(<%= item.id %>)" title="View details">
                    <svg class="icon icon-closed"><use href="/icons/sprite.svg#eye-closed"></use></svg>
                    <svg class="icon icon-open"><use href="/icons/sprite.svg#eye-open"></use></svg>
                  </button>
                </td>
                <td class="col-delete col-align-center">
                  <button class="btn-delete" onclick="deleteItem(<%= item.id %>, '<%= itemName(item).replace(/'/g, "\\'") %>')" title="Delete">
                    <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="15" y1="9" x2="9" y2="15"/>
                      <line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/modals/menu-item', { langs, primary, categories, allergens, dietaryTags, catName, tagName }) %>

<!-- ── Image Lightbox ─────────────────────────────────────────────────────── -->
<div id="imageLightbox" class="lightbox hidden" onclick="closeLightbox()">
  <img id="lightboxImg" src="" alt="" class="lightbox__img" onclick="event.stopPropagation()" />
  <button class="lightbox__close" onclick="closeLightbox()">&times;</button>
</div>

<%- include('../partials/scripts') %>

<script>
  const LANGS   = <%- JSON.stringify(langs) %>;
  const PRIMARY = '<%= primary %>';

  function toggleFilterBar() {

    const bar    = document.getElementById('filterBar');
    const toggle = document.getElementById('filterToggle');
    const open   = bar.classList.toggle('filter-bar--open');
    toggle.classList.toggle('filter-toggle--active', open);
    if (open) document.getElementById('searchInput')?.focus();
  }

  function filterItems() {
    const search    = document.getElementById('searchInput').value.toLowerCase();
    const catId     = document.getElementById('categoryFilter').value;
    const availFilter = document.querySelector('input[name="availFilter"]:checked').value;
    const rows      = document.querySelectorAll('.item-row');
    let visible = 0;

    rows.forEach(row => {
      const nameMatch  = !search || row.dataset.name.includes(search);
      const catMatch   = !catId  || row.dataset.categories.split(',').includes(catId);
      const avail      = row.dataset.available === 'true';
      const availMatch = availFilter === 'all'
                      || (availFilter === 'active'   &&  avail)
                      || (availFilter === 'inactive' && !avail);
      const show = nameMatch && catMatch && availMatch;
      row.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    document.getElementById('itemCount').textContent = `${visible} dish${visible !== 1 ? 'es' : ''}`;
  }

  filterItems();

  function openLightbox(src) {
    document.getElementById('lightboxImg').src = src;
    document.getElementById('imageLightbox').classList.remove('hidden');
  }

  function closeLightbox() {
    document.getElementById('imageLightbox').classList.add('hidden');
    document.getElementById('lightboxImg').src = '';
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

</body>
</html>
