<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Allergens & Dietary', restaurantName }) %>
<body>

<%- include('../partials/sidebar', { current, user, restaurantName }) %>

<%
  const primary = settings.primary_language || 'en';
  const langs   = settings.enabled_languages || ['en', 'es'];

  function tagName(translations) {
    if (!translations || !translations.length) return '—';
    const t = translations.find(t => t.lang === primary) || translations[0];
    return t ? (t.name || '—') : '—';
  }
%>

<div class="main">
  <header class="page-header page-header--minimal">
    <div>
      <h2 class="page-header__title">Allergens &amp; Dietary Tags</h2>
    </div>
    <%- include('../partials/lang-selector') %>
  </header>

  <main class="page-body page-body--minimal">
    <div class="two-col">

      <!-- ── Allergens ───────────────────────────────────────────────────── -->
      <div>
        <div class="card table-card">
          <div class="card__header card__header--brand">
            <h3 class="card__title">Allergen Tags</h3>
            <button onclick="openAddAllergenModal()" class="btn btn--pill btn--outline-accent-on-dark btn--sm">+ Create Tag</button>
          </div>
          <% if (allergens.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state__icon">
                <svg class="icon icon--empty-state"><use href="/icons/sprite.svg#tags"></use></svg>
              </div>
              <p class="empty-state__text">No allergens yet.</p>
              <button onclick="openAddAllergenModal()" class="btn btn--pill btn--outline-brand btn--sm">+ Add Allergen</button>
            </div>
          <% } else { %>
            <table class="data-table">
              <tbody>
                <% allergens.forEach(a => { %>
                  <tr>
                    <td class="col-name col-align-left">
                      <p class="table-item__name"><%= tagName(a.translations) %></p>
                    </td>
                    <td class="col-translations col-align-center">
                      <div class="tag-list">
                        <% const aLangs = langs.filter(l => (a.translations || []).find(t => t.lang === l && t.name)); %>
                        <% aLangs.forEach(l => { %>
                          <span class="tag tag--lang"><%= l.toUpperCase() %></span>
                        <% }); %>
                        <% if (aLangs.length === 0) { %><span class="cell-empty">—</span><% } %>
                      </div>
                    </td>
                    <td class="col-details col-align-center">
                      <button class="btn-view" onclick='openEditAllergenModal(<%- JSON.stringify(a) %>)' title="View details">
                        <svg class="icon icon-closed"><use href="/icons/sprite.svg#eye-closed"></use></svg>
                        <svg class="icon icon-open"><use href="/icons/sprite.svg#eye-open"></use></svg>
                      </button>
                    </td>
                    <td class="col-delete col-align-center">
                      <button class="btn-delete" onclick="deleteAllergen(<%= a.id %>, '<%= tagName(a.translations).replace(/'/g, "\\'") %>')" title="Delete">
                        <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/>
                          <line x1="15" y1="9" x2="9" y2="15"/>
                          <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>

      <!-- ── Dietary Tags ─────────────────────────────────────────────────── -->
      <div>
        <div class="card table-card">
          <div class="card__header card__header--brand">
            <h3 class="card__title">Dietary Tags</h3>
            <button onclick="openAddDietaryModal()" class="btn btn--pill btn--outline-accent-on-dark btn--sm">+ Create Tag</button>
          </div>
          <% if (dietaryTags.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state__icon">
                <svg class="icon icon--empty-state"><use href="/icons/sprite.svg#tags"></use></svg>
              </div>
              <p class="empty-state__text">No dietary tags yet.</p>
              <button onclick="openAddDietaryModal()" class="btn btn--pill btn--outline-brand btn--sm">+ Add Dietary Tag</button>
            </div>
          <% } else { %>
            <table class="data-table">
              <tbody>
                <% dietaryTags.forEach(d => { %>
                  <tr>
                    <td class="col-name col-align-left">
                      <p class="table-item__name"><%= tagName(d.translations) %></p>
                    </td>
                    <td class="col-translations col-align-center">
                      <div class="tag-list">
                        <% const dLangs = langs.filter(l => (d.translations || []).find(t => t.lang === l && t.name)); %>
                        <% dLangs.forEach(l => { %>
                          <span class="tag tag--lang"><%= l.toUpperCase() %></span>
                        <% }); %>
                        <% if (dLangs.length === 0) { %><span class="cell-empty">—</span><% } %>
                      </div>
                    </td>
                    <td class="col-details col-align-center">
                      <button class="btn-view" onclick='openEditDietaryModal(<%- JSON.stringify(d) %>)' title="View details">
                        <svg class="icon icon-closed"><use href="/icons/sprite.svg#eye-closed"></use></svg>
                        <svg class="icon icon-open"><use href="/icons/sprite.svg#eye-open"></use></svg>
                      </button>
                    </td>
                    <td class="col-delete col-align-center">
                      <button class="btn-delete" onclick="deleteDietary(<%= d.id %>, '<%= tagName(d.translations).replace(/'/g, "\\'") %>')" title="Delete">
                        <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/>
                          <line x1="15" y1="9" x2="9" y2="15"/>
                          <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/modals/create-edit/allergen', { langs, primary }) %>
<%- include('../partials/modals/create-edit/dietary', { langs, primary }) %>

<%- include('../partials/scripts') %>
<script>
  const LANGS   = <%- JSON.stringify(langs) %>;
  const PRIMARY = '<%= primary %>';
</script>

</body>
</html>
