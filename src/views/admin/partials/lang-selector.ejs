<div class="lang-selector">
  <button class="lang-selector__btn<%= uiLang === 'en' ? ' lang-selector__btn--active' : '' %>" data-lang="en">EN</button>
  <span class="lang-selector__divider">|</span>
  <button class="lang-selector__btn<%= uiLang === 'es' ? ' lang-selector__btn--active' : '' %>" data-lang="es">ES</button>
</div>
