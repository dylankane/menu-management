<!-- Shared JS utilities — included at the bottom of every admin page -->

<!-- Toast notification container -->
<div id="toast" class="toast hidden"></div>

<%- include('./modals/confirm-delete') %>
<%- include('./modals/confirm-remove') %>

<script>
  // ── UI translations (server-injected) ─────────────────────────────────────
  window.UI_TRANS = <%- JSON.stringify(uiStrings || {}) %>;

  // Translate a toast key, with optional {placeholder} substitution.
  function tr(key, vars) {
    const section = UI_TRANS.toast || {};
    let str = section[key];
    if (str === undefined) str = key;
    if (vars) {
      Object.keys(vars).forEach(function (k) {
        str = str.replace('{' + k + '}', vars[k]);
      });
    }
    return str;
  }

  // Translate any UI key using dot notation (e.g. 'common.tooltip_view').
  function tUI(key, vars) {
    const parts = key.split('.');
    let node = UI_TRANS;
    for (let i = 0; i < parts.length; i++) {
      if (node == null || typeof node !== 'object') { node = undefined; break; }
      node = node[parts[i]];
    }
    let str = (node !== undefined && node !== null) ? String(node) : key;
    if (vars) {
      Object.keys(vars).forEach(function (k) {
        str = str.replace('{' + k + '}', vars[k]);
      });
    }
    return str;
  }

  // ── HTML escape ──────────────────────────────────────────────────────────
  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // ── Toast notification ────────────────────────────────────────────────────
  function showToast(message, type) {
    const el = document.getElementById('toast');
    el.textContent = message;
    el.className = 'toast toast--' + (type === 'error' ? 'error' : 'success');
    clearTimeout(el._timer);
    el._timer = setTimeout(function () { el.classList.add('hidden'); }, 4500);
  }

  // ── Modal helpers ─────────────────────────────────────────────────────────
  function openModal(id) {
    document.getElementById(id).classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
    document.body.style.overflow = '';
  }
  document.addEventListener('click', function (e) {
    if (e.target.classList.contains('modal-overlay')) {
      if (e.target.querySelector('input, textarea, select')) return;
      e.target.classList.add('hidden');
      document.body.style.overflow = '';
    }
  });

  // ── API helper ────────────────────────────────────────────────────────────
  async function api(method, url, data) {
    const opts = { method: method };
    if (data instanceof FormData) {
      opts.body = data;
    } else if (data) {
      opts.headers = { 'Content-Type': 'application/json' };
      opts.body = JSON.stringify(data);
    }
    const res  = await fetch(url, opts);
    const json = await res.json();
    if (!res.ok) {
      const raw = json.errors ? json.errors.map(function (e) { return e.message; }).join(', ') : (json.error || 'Something went wrong');
      const message = sanitiseClientError(raw);
      const err = new Error(message);
      err.status = res.status;
      throw err;
    }
    return json;
  }

  function sanitiseClientError(message) {
    const TECHNICAL_PATTERNS = [/prisma/i, /unique constraint/i, /foreign key/i, /p\d{4}/i, /stack trace/i, /at Object\./i];
    const e = UI_TRANS.errors || {};
    if (!message || message.length > 120 || TECHNICAL_PATTERNS.some(function (p) { return p.test(message); })) {
      return e.server_error || 'Something went wrong — please refresh and try again.';
    }
    return message;
  }

  // ── Centralised API error → human-readable translated message ─────────────
  function apiError(err) {
    const msg = (err.message || '').toLowerCase();
    const e   = UI_TRANS.errors || {};

    if (msg.includes('already in this category') || msg.includes('already in that category'))
      return e.already_in_category        || 'That item is already in this category.';
    if (msg.includes('set menu is already in this category'))
      return e.set_menu_already_in_category || 'That set menu is already in this category.';
    if (msg.includes('already in the set menu'))
      return e.dish_already_in_set_menu   || 'This dish is already in this set menu.';
    if (msg.includes('subcategor'))
      return e.has_subcategories          || 'Please remove all subcategories before deleting.';
    if (msg.includes('in use by a set menu'))
      return e.course_in_use              || 'This course is in use by a set menu.';
    if (msg.includes('has courses'))
      return e.set_menu_has_courses       || 'Please assign the dish to a course first.';
    if (msg.includes('protected'))
      return e.protected_category         || 'This item is protected and cannot be deleted.';
    if (msg.includes('nest more than one level') || msg.includes('only be nested one level'))
      return e.cannot_nest_deeper         || 'Categories can only be one level deep.';
    if (msg.includes('current password') || msg.includes('password is incorrect'))
      return e.password_incorrect         || 'The current password is incorrect.';
    if (msg.includes('cannot delete your own'))
      return e.cannot_delete_self         || 'You cannot delete your own account.';
    if (msg.includes('email already in use'))
      return e.email_in_use               || 'That email address is already in use.';
    if (msg.includes('slug already exists') || msg.includes('category with that slug'))
      return e.slug_exists                || 'A category with that name already exists.';
    if (msg.includes('invalid email or password'))
      return e.invalid_login              || 'Incorrect email or password.';
    if (msg.includes('override already exists for that date'))
      return e.date_override_exists       || 'There is already an entry for that date.';
    if (msg.includes('primary language'))
      return e.primary_language_locked    || 'The primary language cannot be removed.';
    if (msg.includes('locked language'))
      return e.language_locked            || 'This language cannot be removed.';

    if (err.status === 404) return e.not_found      || 'Item not found.';
    if (err.status === 409) return e.conflict       || 'This already exists.';
    if (err.status === 403) return e.forbidden      || 'Access denied.';
    if (err.status === 401) return e.session_expired || 'Please log in again.';
    if (err.status === 400) return e.bad_request    || 'Please check your entries.';
    return e.server_error || 'Something went wrong — please refresh and try again.';
  }

  const UI_MESSAGES = {
    genericError: (UI_TRANS.errors && UI_TRANS.errors.server_error) || 'Something went wrong — please refresh and try again.',
  };

  // ── Confirm delete ────────────────────────────────────────────────────────
  let _confirmDeleteCallback = null;

  function confirmDelete(message, callback, opts) {
    _confirmDeleteCallback = callback;
    document.getElementById('confirmDeleteTitle').textContent = message;
    const detail = document.getElementById('confirmDeleteDetail');
    if (opts && opts.detail) {
      detail.textContent = opts.detail;
      detail.classList.remove('hidden');
    } else {
      detail.classList.add('hidden');
      detail.textContent = '';
    }
    openModal('confirmDeleteModal');
  }

  function _confirmDeleteExecute() {
    closeModal('confirmDeleteModal');
    if (_confirmDeleteCallback) _confirmDeleteCallback();
    _confirmDeleteCallback = null;
  }

  // ── Confirm remove (soft unlink — not a permanent delete) ─────────────────
  let _confirmRemoveCallback = null;

  function confirmRemove(itemName, location, callback) {
    _confirmRemoveCallback = callback;
    document.getElementById('confirmRemoveTitle').textContent = tUI('modal.confirm_remove_title', { name: itemName });
    document.getElementById('confirmRemoveDetail').textContent = tUI('modal.confirm_remove_body', { name: itemName, location: location });
    openModal('confirmRemoveModal');
  }

  function _confirmRemoveExecute() {
    closeModal('confirmRemoveModal');
    if (_confirmRemoveCallback) _confirmRemoveCallback();
    _confirmRemoveCallback = null;
  }

  // ── Reload after short delay ──────────────────────────────────────────────
  function reloadAfter(ms) {
    setTimeout(function () { location.reload(); }, ms || 600);
  }

  // ── Clear a staged image upload preview ───────────────────────────────────
  function clearImagePreview(inputId, previewId) {
    const input = document.getElementById(inputId);
    if (input) input.value = '';
    const wrap = document.getElementById(previewId);
    if (wrap) wrap.classList.add('hidden');
  }

  // ── Language tab switcher ─────────────────────────────────────────────────
  function switchLangTab(btn, lang) {
    const container = btn.closest('[data-lang-container]');
    container.querySelectorAll('.lang-tab').forEach(function (t) { t.classList.remove('lang-tab--active'); });
    btn.classList.add('lang-tab--active');
    container.querySelectorAll('.lang-panel').forEach(function (p) { p.classList.remove('lang-panel--active'); });
    const panel = container.querySelector('.lang-panel[data-lang="' + lang + '"]');
    if (panel) panel.classList.add('lang-panel--active');
  }

  function resetLangTabs(container, primaryLang) {
    container.querySelectorAll('.lang-tab').forEach(function (t) { t.classList.remove('lang-tab--active'); });
    const primaryTab = container.querySelector('.lang-tab[data-lang="' + primaryLang + '"]');
    if (primaryTab) primaryTab.classList.add('lang-tab--active');
    container.querySelectorAll('.lang-panel').forEach(function (p) { p.classList.remove('lang-panel--active'); });
    const primaryPanel = container.querySelector('.lang-panel[data-lang="' + primaryLang + '"]');
    if (primaryPanel) primaryPanel.classList.add('lang-panel--active');
  }


</script>

<script src="/admin/js/ui-lang.js"></script>
