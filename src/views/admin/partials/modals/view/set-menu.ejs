<!-- ── Set Menu View Modal ────────────────────────────────────────────────── -->
<div id="smViewModal" class="modal-overlay hidden">
  <div class="modal modal--lg" onclick="event.stopPropagation()">

    <div class="modal__header">
      <h3 id="smViewTitle" class="modal__title">—</h3>
      <button onclick="closeModal('smViewModal')" class="modal__close">&times;</button>
    </div>

    <div class="modal__body modal__body--view">

      <!-- Translations — all languages stacked -->
      <div id="smViewTranslations" class="view-langs"></div>

      <!-- Image (left) + Info (right) -->
      <div class="view-hero">

        <img id="smViewImg" src="" alt="" class="view-hero__img hidden"
             onclick="openSmViewLightbox(this.src)" />
        <div id="smViewImgPlaceholder" class="view-hero__img-placeholder hidden">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
            <circle cx="12" cy="13" r="4"/>
            <line x1="2" y1="2" x2="22" y2="22"/>
          </svg>
        </div>

        <div class="view-hero__meta">

          <div class="view-info-row">
            <span class="form-label"><%= t('common.price') %></span>
            <div class="view-hero__price-row">
              <span id="smViewPrice" class="item-price"></span>
              <span id="smViewDiscount" class="item-discount hidden"></span>
              <span id="smViewFinal" class="view-hero__final hidden"></span>
            </div>
          </div>

          <div class="view-info-row">
            <span class="form-label"><%= t('modal.label_status') %></span>
            <div id="smViewBadges" class="view-hero__badges"></div>
          </div>

          <div class="view-info-row">
            <span class="form-label"><%= t('modal.label_internal_notes') %> <span class="hint"><%= t('modal.hint_internal_only') %></span></span>
            <p id="smViewNotes" class="view-section__value view-section__value--muted"></p>
          </div>

        </div>
      </div>

      <!-- Categories -->
      <div class="view-section">
        <span class="form-label"><%= t('modal.label_categories') %></span>
        <div id="smViewCategories" class="category-breadcrumbs"></div>
      </div>

    </div>

    <div class="modal__footer">
      <button onclick="closeModal('smViewModal')" class="btn btn--secondary"><%= t('common.close') %></button>
      <button onclick="_smViewToEdit()" class="btn btn--primary"><%= t('modal.btn_edit_set_menu') %></button>
    </div>

  </div>
</div>

<!-- Lightbox -->
<div id="smViewLightbox" class="lightbox hidden" onclick="closeSmViewLightbox()">
  <img id="smViewLightboxImg" src="" alt="" class="lightbox__img" onclick="event.stopPropagation()" />
  <button class="lightbox__close" onclick="closeSmViewLightbox()">&times;</button>
</div>

<script>
  let _viewingSm = null;

  function openSmViewLightbox(src) {
    document.getElementById('smViewLightboxImg').src = src;
    document.getElementById('smViewLightbox').classList.remove('hidden');
  }
  function closeSmViewLightbox() {
    document.getElementById('smViewLightbox').classList.add('hidden');
    document.getElementById('smViewLightboxImg').src = '';
  }

  function openSmViewModal(id) {
    const sm = SM_DATA.find(s => s.id === id);
    if (!sm) return;
    _viewingSm = sm;
    _populateSmViewModal(sm);
    openModal('smViewModal');
  }

  function _populateSmViewModal(sm) {
    const byLang       = {};
    (sm.translations || []).forEach(t => { byLang[t.lang] = t; });
    const primaryTrans = byLang[PRIMARY] || Object.values(byLang)[0] || {};

    // Title
    document.getElementById('smViewTitle').textContent = primaryTrans.name || '—';

    // Translations
    const transEl = document.getElementById('smViewTranslations');
    transEl.innerHTML = '';
    LANGS.forEach(lang => {
      const t   = byLang[lang] || {};
      const div = document.createElement('div');
      div.className = 'view-lang-block';
      div.innerHTML =
        `<span class="view-lang-block__tag">${esc(lang.toUpperCase())}</span>` +
        `<div class="view-lang-block__content">` +
          `<p class="view-lang-block__name">${esc(t.name || '—')}</p>` +
          `<p class="view-lang-block__desc">${esc(t.description || '—')}</p>` +
          `<p class="view-lang-block__desc view-lang-block__desc--notes">${esc(t.public_notes || '—')}</p>` +
        `</div>`;
      transEl.appendChild(div);
    });

    // Image / placeholder
    const imgEl = document.getElementById('smViewImg');
    const phEl  = document.getElementById('smViewImgPlaceholder');
    if (sm.image_url) {
      imgEl.src = sm.image_url;
      imgEl.classList.remove('hidden');
      phEl.classList.add('hidden');
    } else {
      imgEl.classList.add('hidden');
      phEl.classList.remove('hidden');
    }

    // Price + discount
    const priceEl = document.getElementById('smViewPrice');
    const discEl  = document.getElementById('smViewDiscount');
    const finalEl = document.getElementById('smViewFinal');
    priceEl.textContent = '€' + Number(sm.price).toFixed(2);
    priceEl.classList.toggle('item-price--muted', !!(sm.has_discount && sm.discount_value));
    if (sm.has_discount && sm.discount_value) {
      const dv  = Number(sm.discount_value);
      const str = sm.discount_type === 'percent' ? `-${dv}%` : `-€${dv.toFixed(2)}`;
      discEl.textContent = str;
      discEl.classList.remove('hidden');
      let final = Number(sm.price);
      if (sm.discount_type === 'percent') final = final * (1 - dv / 100);
      else final = final - dv;
      finalEl.textContent = '→ €' + Math.max(0, final).toFixed(2);
      finalEl.classList.remove('hidden');
    } else {
      discEl.classList.add('hidden');
      finalEl.classList.add('hidden');
    }

    // Status badges
    document.getElementById('smViewBadges').innerHTML =
      `<span class="smb-avail smb-avail--${sm.is_available ? 'on' : 'off'}"></span>` +
      `<span class="smb-avail-label">${sm.is_available ? tUI('common.live') : tUI('common.off')}</span>` +
      (sm.is_special ? `&nbsp;&nbsp;<span class="tag">${tUI('modal.label_special')}</span>` : '');

    // Internal notes
    document.getElementById('smViewNotes').textContent = sm.notes || '—';

    // Categories
    const catsEl = document.getElementById('smViewCategories');
    catsEl.innerHTML = '';
    if (sm.categories && sm.categories.length) {
      sm.categories.forEach(c => {
        const cat      = c.category;
        const catTrans = (cat.translations || []).find(t => t.lang === PRIMARY) || (cat.translations || [])[0] || {};
        const div      = document.createElement('div');
        div.className  = 'breadcrumb-text';
        if (cat.parent_id) {
          const parent      = ALL_CATS.find(p => p.id === cat.parent_id);
          const parentTrans = parent
            ? ((parent.translations || []).find(t => t.lang === PRIMARY) || (parent.translations || [])[0] || {})
            : {};
          div.innerHTML = parent
            ? `<span class="breadcrumb-muted">${esc(parentTrans.name || '?')}<span class="breadcrumb-sep"> › </span></span>${esc(catTrans.name || '?')}`
            : esc(catTrans.name || '?');
        } else {
          div.textContent = catTrans.name || '?';
        }
        catsEl.appendChild(div);
      });
    } else {
      catsEl.innerHTML = '<span class="cell-empty">—</span>';
    }

  }

  function _smViewToEdit() {
    if (!_viewingSm) return;
    closeModal('smViewModal');
    window._onSmSaved = async (smId) => {
      await refreshAndRender(smId);
      _viewingSm = SM_DATA.find(s => s.id === smId);
      if (_viewingSm) _populateSmViewModal(_viewingSm);
      openModal('smViewModal');
    };
    window._onSmModalClose = () => { openModal('smViewModal'); };
    openEditModal();
  }
</script>
