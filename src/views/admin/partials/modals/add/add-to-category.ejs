<!-- ── Add Existing Dish to Category Modal ─────────────────────────────────── -->
<!-- Requires in scope: allItems, primary                                       -->
<div id="addToCatModal" class="modal-overlay hidden">
  <div class="modal modal--lg" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title" id="addToCatModalTitle"><%= t('modal.add_dish_generic') %></h3>
      <button onclick="closeModal('addToCatModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="addToCatCatId" />
      <div class="form-group">
        <input type="text" id="addToCatSearch" placeholder="<%= t('modal.search_placeholder_items') %>" oninput="filterAddToCatDishes()" class="form-input" />
      </div>
      <div id="addToCatList" class="add-to-cat-list" style="max-height:16rem;overflow-y:auto;">
        <% allItems.forEach(item => {
          const t = (item.translations || []).find(t => t.lang === primary) || (item.translations || [])[0];
          const name = t ? (t.name || '—') : '—';
        %>
          <div class="add-to-cat-item" data-item-id="<%= item.id %>" data-name="<%= name.toLowerCase() %>" onclick="selectAddToCatItem(this)">
            <%= name %><span class="add-to-cat-item__meta"> — €<%= Number(item.price).toFixed(2) %></span>
          </div>
        <% }) %>
      </div>
      <div class="modal-create-action">
        <button type="button" class="btn btn--pill link--slide" onclick="swapToCreateFromAddToCat()"><%= t('page.menu_items.btn_create') %></button>
      </div>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="closeModal('addToCatModal')" class="btn btn--secondary"><%= t('common.cancel') %></button>
      <button type="button" onclick="submitAddToCategory()" class="btn btn--primary"><%= t('modal.btn_add_to_category') %></button>
    </div>
  </div>
</div>

<script>
  let _addToCatSelectedId = null;

  function openAddToCatModal(catId, catNameStr) {
    document.getElementById('addToCatCatId').value = catId;
    document.getElementById('addToCatModalTitle').textContent =
      catNameStr ? tUI('modal.add_dish_to', { name: catNameStr }) : tUI('modal.add_dish_generic');
    document.getElementById('addToCatSearch').value = '';
    _addToCatSelectedId = null;
    document.querySelectorAll('#addToCatList .add-to-cat-item').forEach(el => {
      el.classList.remove('add-to-cat-item--selected');
      el.style.display = '';
    });
    openModal('addToCatModal');
  }

  function selectAddToCatItem(el) {
    document.querySelectorAll('#addToCatList .add-to-cat-item').forEach(i => i.classList.remove('add-to-cat-item--selected'));
    el.classList.add('add-to-cat-item--selected');
    _addToCatSelectedId = el.dataset.itemId;
  }

  function filterAddToCatDishes() {
    const q = document.getElementById('addToCatSearch').value.toLowerCase().trim();
    document.querySelectorAll('#addToCatList .add-to-cat-item').forEach(el => {
      el.style.display = !q || el.dataset.name.includes(q) ? '' : 'none';
    });
  }

  async function submitAddToCategory() {
    if (!_addToCatSelectedId) return showToast(tUI('modal.validation_select_dish'), 'error');
    const catId = document.getElementById('addToCatCatId').value;
    try {
      await api('POST', `/api/menu-items/${_addToCatSelectedId}/add-to-category`, {
        category_id: parseInt(catId),
      });
      showToast(tr('item_added_to_category'));
      closeModal('addToCatModal');
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  let _addToCatSwapReturnId = null;

  function swapToCreateFromAddToCat() {
    const catId = document.getElementById('addToCatCatId').value;
    document.getElementById('addToCatModal').classList.add('hidden');
    _addToCatSwapReturnId = 'addToCatModal';
    window._onItemSaved = function(item) {
      window._onItemSaved = null;
      _returnFromAddToCatSwap(item);
    };
    window._onItemModalClose = function() {
      _returnFromAddToCatSwap(null);
    };
    openAddDishModal(catId || null);
  }

  function _returnFromAddToCatSwap(newItem) {
    document.querySelectorAll('.modal-overlay:not(.hidden)').forEach(el => el.classList.add('hidden'));
    if (_addToCatSwapReturnId) {
      document.getElementById(_addToCatSwapReturnId).classList.remove('hidden');
      _addToCatSwapReturnId = null;
    }
    if (newItem) _injectAndSelectAddToCatItem(newItem);
  }

  function _injectAndSelectAddToCatItem(item) {
    const t = (item.translations || []).find(t => t.lang === PRIMARY) || (item.translations || [])[0];
    const name = t ? (t.name || '—') : '—';
    const el = document.createElement('div');
    el.className = 'add-to-cat-item';
    el.dataset.itemId = item.id;
    el.dataset.name = name.toLowerCase();
    el.onclick = function() { selectAddToCatItem(this); };
    el.innerHTML = `${esc(name)}<span class="add-to-cat-item__meta"> — €${Number(item.price).toFixed(2)}</span>`;
    const list = document.getElementById('addToCatList');
    list.insertBefore(el, list.firstChild);
    document.getElementById('addToCatSearch').value = '';
    document.querySelectorAll('#addToCatList .add-to-cat-item').forEach(e => e.style.display = '');
    selectAddToCatItem(el);
    list.scrollTop = 0;
  }
</script>
