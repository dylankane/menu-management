<!-- ── Add Item Modal ─────────────────────────────────────────────────────────── -->
<!-- Requires in scope: langs, primary                                           -->
<!-- Caller must call openAddItemModal(config) — see script block below          -->
<!-- config: { title, items[{id,name,meta,type}], sections[{id,name}],           -->
<!--           sectionId, showNotes, canCreate, onSubmit(itemId,type,{sectionId,notes}) } -->
<div id="addItemModal" class="modal-overlay hidden">
  <div class="modal modal--lg" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title" id="addItemModalTitle"><%= t('modal.title_add_item') %></h3>
      <button onclick="closeModal('addItemModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">

      <!-- Section / course dropdown — shown when config.sections is set -->
      <div id="addItemSectionWrap" class="form-group hidden">
        <label class="form-label"><%= t('modal.label_add_to') %> <span class="required">*</span></label>
        <select id="addItemSectionSelect" class="form-select"></select>
      </div>

      <div class="form-group">
        <input type="text" id="addItemSearch" placeholder="<%= t('modal.search_placeholder_items') %>"
               oninput="filterItemSearch()" class="form-input" />
      </div>

      <!-- Item list — JS-rendered via renderItemList() -->
      <div id="addItemList" class="add-to-cat-list"></div>

      <div class="modal-create-action" id="addItemCreateAction">
        <button type="button" class="btn btn--pill link--slide" onclick="swapToItemModal()"><%= t('page.menu_items.btn_create') %></button>
      </div>

      <!-- Per-language notes — shown after an item is selected when showNotes is true -->
      <div id="addItemNoteWrap" class="modal-note-wrap hidden">
        <h4 class="modal-section-title"><%= t('modal.section_add_note') %></h4>
        <div data-lang-container>
          <div class="lang-tabs" id="addItemNoteTabs">
            <% langs.forEach((lang, i) => { %>
              <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
                data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
                <%= lang.toUpperCase() %>
              </button>
            <% }) %>
          </div>
          <% langs.forEach((lang, i) => { %>
            <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
              <div class="form-group">
                <label class="form-label form-label--xs">
                  <%= t('modal.label_note_lang').replace('{lang}', lang.toUpperCase()) %> <span class="hint"><%= t('modal.hint_optional') %></span>
                </label>
                <input type="text" id="addItemNote_<%= lang %>" class="form-input form-input--sm"
                  placeholder="<%= t('modal.placeholder_note_item') %>" />
              </div>
            </div>
          <% }) %>
        </div>
      </div>

    </div>
    <div class="modal__footer">
      <button onclick="closeModal('addItemModal')" class="btn btn--secondary"><%= t('common.cancel') %></button>
      <button onclick="submitAddItem()" class="btn btn--primary"><%= t('modal.title_add_item') %></button>
    </div>
  </div>
</div>

<script>
  let _selectedItemId   = null;
  let _selectedItemType = null;
  let _swapReturnId     = null;
  let _addItemConfig    = null;

  function openAddItemModal(config) {
    _addItemConfig    = config || {};
    _selectedItemId   = null;
    _selectedItemType = null;

    document.getElementById('addItemModalTitle').textContent = _addItemConfig.title || tUI('modal.title_add_item');

    // Section / course dropdown
    const sectionWrap   = document.getElementById('addItemSectionWrap');
    const sectionSelect = document.getElementById('addItemSectionSelect');
    if (_addItemConfig.sections && _addItemConfig.sections.length) {
      sectionSelect.innerHTML = _addItemConfig.sections
        .map(s => `<option value="${s.id}">${esc(s.name)}</option>`)
        .join('');
      sectionWrap.classList.remove('hidden');
    } else {
      sectionWrap.classList.add('hidden');
    }

    // Item list
    renderItemList(_addItemConfig.items || []);

    // Create Item button — hidden when canCreate is explicitly false
    document.getElementById('addItemCreateAction').classList.toggle('hidden', _addItemConfig.canCreate === false);

    // Notes + search reset
    document.getElementById('addItemNoteWrap').classList.add('hidden');
    document.getElementById('addItemSearch').value = '';
    LANGS.forEach(lang => {
      const el = document.getElementById(`addItemNote_${lang}`);
      if (el) el.value = '';
    });
    resetLangTabs(document.querySelector('#addItemModal [data-lang-container]'), PRIMARY);
    openModal('addItemModal');
  }

  function renderItemList(items) {
    document.getElementById('addItemList').innerHTML = items.map(item => `
      <div class="add-to-cat-item"
           data-item-id="${item.id}"
           data-item-type="${esc(item.type || 'dish')}"
           data-name="${esc(String(item.name || '').toLowerCase())}"
           onclick="selectItem(this)">
        ${esc(item.name || '—')}<span class="add-to-cat-item__meta"> — ${esc(item.meta || '')}</span>${item.label ? `<span class="add-to-cat-item__type"> ${esc(item.label)}</span>` : ''}
      </div>`).join('');
  }

  function selectItem(el) {
    document.querySelectorAll('#addItemList .add-to-cat-item')
      .forEach(i => i.classList.remove('add-to-cat-item--selected'));
    el.classList.add('add-to-cat-item--selected');
    _selectedItemId   = parseInt(el.dataset.itemId);
    _selectedItemType = el.dataset.itemType || 'dish';
    if (_addItemConfig?.showNotes) {
      document.getElementById('addItemNoteWrap').classList.remove('hidden');
    }
  }

  function filterItemSearch() {
    const q = document.getElementById('addItemSearch').value.toLowerCase().trim();
    document.querySelectorAll('#addItemList .add-to-cat-item').forEach(el => {
      el.style.display = !q || el.dataset.name.includes(q) ? '' : 'none';
    });
  }

  async function submitAddItem() {
    if (!_selectedItemId) return showToast(tUI('modal.validation_select_item'), 'error');
    if (!_addItemConfig?.onSubmit) return;

    const sectionWrap = document.getElementById('addItemSectionWrap');
    const useSelector = !sectionWrap.classList.contains('hidden');
    let sectionId;
    if (useSelector) {
      sectionId = parseInt(document.getElementById('addItemSectionSelect').value);
      if (!sectionId) return showToast(tUI('modal.validation_select_section'), 'error');
    } else {
      sectionId = _addItemConfig.sectionId ?? null;
    }

    const notes = {};
    if (_addItemConfig.showNotes) {
      LANGS.forEach(lang => {
        const val = document.getElementById(`addItemNote_${lang}`)?.value.trim();
        if (val) notes[`notes_${lang}`] = val;
      });
    }

    try {
      await _addItemConfig.onSubmit(_selectedItemId, _selectedItemType, { sectionId, notes });
      closeModal('addItemModal');
    } catch (err) { showToast(apiError(err), 'error'); }
  }

  // ── Swap to item creation modal ───────────────────────────────────────────────
  function swapToItemModal() {
    document.getElementById('addItemModal').classList.add('hidden');
    _swapReturnId = 'addItemModal';
    window._onItemSaved = function(item) {
      window._onItemSaved = null;
      returnFromSwap(item);
    };
    window._onItemModalClose = function() {
      returnFromSwap(null);
    };
    const sectionWrap = document.getElementById('addItemSectionWrap');
    const useSelector = !sectionWrap.classList.contains('hidden');
    const presetCatId = useSelector
      ? (parseInt(document.getElementById('addItemSectionSelect').value) || null)
      : (_addItemConfig?.sectionId ?? null);
    openAddDishModal(presetCatId);
  }

  function returnFromSwap(newItem) {
    document.querySelectorAll('.modal-overlay:not(.hidden)').forEach(el => el.classList.add('hidden'));
    if (_swapReturnId) {
      document.getElementById(_swapReturnId).classList.remove('hidden');
      _swapReturnId = null;
    }
    if (newItem) injectAndSelectItem(newItem);
  }

  function injectAndSelectItem(item) {
    const t    = (item.translations || []).find(t => t.lang === PRIMARY) || (item.translations || [])[0];
    const name = t?.name || '—';
    const meta = `€${Number(item.price).toFixed(2)}`;
    const el   = document.createElement('div');
    el.className           = 'add-to-cat-item';
    el.dataset.itemId      = item.id;
    el.dataset.itemType    = 'dish';
    el.dataset.name        = name.toLowerCase();
    el.onclick             = function() { selectItem(this); };
    el.innerHTML           = `${esc(name)}<span class="add-to-cat-item__meta"> — ${esc(meta)}</span>`;
    const list = document.getElementById('addItemList');
    list.insertBefore(el, list.firstChild);
    document.getElementById('addItemSearch').value = '';
    document.querySelectorAll('#addItemList .add-to-cat-item').forEach(e => e.style.display = '');
    selectItem(el);
    list.scrollTop = 0;
  }
</script>
