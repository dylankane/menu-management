<!-- ── Add / Edit Category Modals ──────────────────────────────────────────── -->
<!-- Requires in scope: langs, primary, categories                             -->

<!-- Add Category Modal (also used for subcategories via addCatParentId)  -->
<div id="addCatModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title" id="addCatModalTitle">Create Category</h3>
      <button onclick="closeModal('addCatModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="addCatParentId" value="" />
      <div data-lang-container>
        <div class="lang-tabs">
          <% langs.forEach((lang, i) => { %>
            <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
              data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
              <%= lang.toUpperCase() %>
            </button>
          <% }) %>
        </div>
        <% langs.forEach((lang, i) => { %>
          <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
            <div class="form-group">
              <label class="form-label"><%= t('modal.label_name').replace('{lang}', lang.toUpperCase()) %></label>
              <input type="text" id="addCatName_<%= lang %>" class="form-input" data-capitalize="title" />
            </div>
            <div class="form-group">
              <label class="form-label"><%= t('modal.label_description').replace('{lang}', lang.toUpperCase()) %></label>
              <input type="text" id="addCatDesc_<%= lang %>" class="form-input" placeholder="<%= t('common.optional') %>" data-capitalize="sentence" />
            </div>
            <div class="form-group">
              <label class="form-label"><%= t('modal.label_public_notes').replace('{lang}', lang.toUpperCase()) %> <span class="hint"><%= t('modal.hint_shown_to_customers') %></span></label>
              <textarea id="addCatPublicNotes_<%= lang %>" rows="2" class="form-textarea" data-capitalize="sentence"></textarea>
            </div>
          </div>
        <% }) %>
      </div>
      <div class="image-upload-row">
        <div class="image-upload-input">
          <label class="form-label"><%= t('modal.label_image') %></label>
          <input type="file" id="addCatImage" accept="image/*" class="form-file" />
        </div>
        <div id="addCatImagePreview" class="image-preview hidden">
          <img id="addCatImageThumb" src="" alt="" class="table-thumb table-thumb--clickable"
               onclick="openCatAddLightbox(this.src)" />
          <span class="image-preview__label"><%= t('modal.image_new_selected') %></span>
          <button type="button" class="image-preview__clear" onclick="clearImagePreview('addCatImage','addCatImagePreview')" aria-label="Remove">&times;</button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label"><%= t('modal.label_internal_notes') %> <span class="hint"><%= t('modal.hint_admin_only') %></span></label>
        <textarea id="addCatNotes" rows="2" class="form-textarea" data-capitalize="sentence"></textarea>
      </div>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="closeModal('addCatModal')" class="btn btn--secondary"><%= t('modal.btn_cancel') %></button>
      <button type="button" onclick="submitAddCategory()" class="btn btn--primary"><%= t('modal.btn_save') %></button>
    </div>
  </div>
</div>

<!-- Edit Category Modal -->
<div id="editCatModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title"><%= t('modal.title_edit_category') %></h3>
      <button onclick="_handleEditCatClose()" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="editCatId" />
      <div data-lang-container class="modal-lang-section">
        <div class="lang-tabs">
          <% langs.forEach((lang, i) => { %>
            <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
              data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
              <%= lang.toUpperCase() %>
            </button>
          <% }) %>
        </div>
        <% langs.forEach((lang, i) => { %>
          <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
            <div class="form-group">
              <label class="form-label"><%= t('modal.label_name').replace('{lang}', lang.toUpperCase()) %></label>
              <input type="text" id="editCatName_<%= lang %>" class="form-input" data-capitalize="title" />
            </div>
            <div class="form-group">
              <label class="form-label"><%= t('modal.label_description').replace('{lang}', lang.toUpperCase()) %></label>
              <input type="text" id="editCatDesc_<%= lang %>" class="form-input" data-capitalize="sentence" />
            </div>
            <div class="form-group">
              <label class="form-label"><%= t('modal.label_public_notes').replace('{lang}', lang.toUpperCase()) %> <span class="hint"><%= t('modal.hint_shown_to_customers') %></span></label>
              <textarea id="editCatPublicNotes_<%= lang %>" rows="2" class="form-textarea" data-capitalize="sentence"></textarea>
            </div>
          </div>
        <% }) %>
      </div>
      <div class="image-upload-row">
        <div class="image-upload-input">
          <label class="form-label"><%= t('modal.label_image') %></label>
          <input type="file" id="editCatImage" accept="image/*" class="form-file" />
        </div>
        <div id="editCatImagePreview" class="image-preview hidden">
          <img id="editCatImageThumb" src="" alt="" class="table-thumb table-thumb--clickable"
               onclick="openCatEditLightbox(this.src)" />
          <span class="image-preview__label"><%= t('modal.image_current') %></span>
          <button type="button" class="image-preview__clear" onclick="clearImagePreview('editCatImage','editCatImagePreview')" aria-label="Remove">&times;</button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label"><%= t('modal.label_internal_notes') %> <span class="hint"><%= t('modal.hint_admin_only') %></span></label>
        <textarea id="editCatNotes" rows="2" class="form-textarea" data-capitalize="sentence"></textarea>
      </div>
      <div class="form-group">
        <label class="form-label"><%= t('modal.label_parent_category') %></label>
        <select id="editCatParentId" class="form-select">
          <option value=""><%= t('modal.option_none_top_level') %></option>
          <% categories.filter(c => !c.parent_id).forEach(c => { %>
            <option value="<%= c.id %>"><%= (c.translations || []).find(t => t.lang === primary)?.name || c.slug %></option>
          <% }) %>
        </select>
      </div>
      <label class="form-check">
        <input type="checkbox" id="editCatIsActive" />
        <span class="form-check__label"><%= t('modal.label_active') %></span>
      </label>
    </div>
    <div class="modal__footer">
      <button type="button" onclick="_handleEditCatClose()" class="btn btn--secondary"><%= t('modal.btn_cancel') %></button>
      <button type="button" onclick="submitEditCategory()" class="btn btn--primary"><%= t('modal.btn_save_changes') %></button>
    </div>
  </div>
</div>

<!-- Lightboxes for category modals -->
<div id="catAddLightbox" class="lightbox hidden" onclick="closeCatAddLightbox()">
  <img id="catAddLightboxImg" src="" alt="" class="lightbox__img" onclick="event.stopPropagation()" />
  <button class="lightbox__close" onclick="closeCatAddLightbox()">&times;</button>
</div>
<div id="catEditLightbox" class="lightbox hidden" onclick="closeCatEditLightbox()">
  <img id="catEditLightboxImg" src="" alt="" class="lightbox__img" onclick="event.stopPropagation()" />
  <button class="lightbox__close" onclick="closeCatEditLightbox()">&times;</button>
</div>

<script>
  function openCatAddLightbox(src)  { document.getElementById('catAddLightboxImg').src = src; document.getElementById('catAddLightbox').classList.remove('hidden'); }
  function closeCatAddLightbox()    { document.getElementById('catAddLightbox').classList.add('hidden'); document.getElementById('catAddLightboxImg').src = ''; }
  function openCatEditLightbox(src) { document.getElementById('catEditLightboxImg').src = src; document.getElementById('catEditLightbox').classList.remove('hidden'); }
  function closeCatEditLightbox()   { document.getElementById('catEditLightbox').classList.add('hidden'); document.getElementById('catEditLightboxImg').src = ''; }

  document.getElementById('addCatImage').addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    document.getElementById('addCatImageThumb').src = URL.createObjectURL(file);
    document.getElementById('addCatImagePreview').classList.remove('hidden');
  });

  document.getElementById('editCatImage').addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    document.getElementById('editCatImageThumb').src = URL.createObjectURL(file);
    document.getElementById('editCatImagePreview').querySelector('.image-preview__label').textContent = tUI('modal.image_new_selected');
    document.getElementById('editCatImagePreview').classList.remove('hidden');
  });

  function openAddCategoryModal() {
    document.getElementById('addCatParentId').value = '';
    document.getElementById('addCatModalTitle').textContent = tUI('modal.title_create_category');
    document.getElementById('addCatNotes').value = '';
    document.getElementById('addCatImage').value = '';
    document.getElementById('addCatImagePreview').classList.add('hidden');
    LANGS.forEach(lang => {
      const n  = document.getElementById(`addCatName_${lang}`);        if (n)  n.value  = '';
      const d  = document.getElementById(`addCatDesc_${lang}`);        if (d)  d.value  = '';
      const pn = document.getElementById(`addCatPublicNotes_${lang}`); if (pn) pn.value = '';
    });
    const container = document.querySelector('#addCatModal [data-lang-container]');
    resetLangTabs(container, PRIMARY);
    openModal('addCatModal');
  }

  function openAddSubModal(parentId, parentName) {
    openAddCategoryModal();
    document.getElementById('addCatParentId').value = parentId;
    document.getElementById('addCatModalTitle').textContent = tUI('modal.title_create_sub', { name: parentName });
  }

  function openEditCategoryModal(cat) {
    document.getElementById('editCatId').value         = cat.id;
    document.getElementById('editCatIsActive').checked = cat.is_active;
    document.getElementById('editCatParentId').value   = cat.parent_id || '';
    document.getElementById('editCatNotes').value      = cat.notes || '';
    document.getElementById('editCatImage').value      = '';

    if (cat.image_url) {
      document.getElementById('editCatImageThumb').src = cat.image_url;
      document.getElementById('editCatImagePreview').querySelector('.image-preview__label').textContent = tUI('modal.image_current');
      document.getElementById('editCatImagePreview').classList.remove('hidden');
    } else {
      document.getElementById('editCatImagePreview').classList.add('hidden');
    }

    const byLang = {};
    (cat.translations || []).forEach(t => byLang[t.lang] = t);
    LANGS.forEach(lang => {
      const t  = byLang[lang] || {};
      const n  = document.getElementById(`editCatName_${lang}`);        if (n)  n.value  = t.name         || '';
      const d  = document.getElementById(`editCatDesc_${lang}`);        if (d)  d.value  = t.description  || '';
      const pn = document.getElementById(`editCatPublicNotes_${lang}`); if (pn) pn.value = t.public_notes || '';
    });
    const container = document.querySelector('#editCatModal [data-lang-container]');
    resetLangTabs(container, PRIMARY);
    openModal('editCatModal');
  }

  function _handleEditCatClose() {
    closeModal('editCatModal');
    if (typeof window._onCatModalClose === 'function') {
      const cb = window._onCatModalClose;
      window._onCatModalClose = null;
      cb();
    }
  }

  async function submitAddCategory() {
    const parentId = document.getElementById('addCatParentId').value;

    // Capture direct items/set-menus on the parent BEFORE creating the sub.
    // If this is the first sub, they'll be auto-migrated into it.
    let directItems    = [];
    let directSetMenus = [];
    if (parentId && typeof findCategory === 'function') {
      const parentCat = findCategory(parseInt(parentId));
      if (parentCat && (!parentCat.children || parentCat.children.length === 0)) {
        directItems    = parentCat.menu_item_categories || [];
        directSetMenus = parentCat.set_menu_categories  || [];
      }
    }

    const fd = new FormData();
    if (parentId) fd.append('parent_id', parentId);
    const notes = document.getElementById('addCatNotes')?.value.trim();
    if (notes) fd.append('notes', notes);
    const imageFile = document.getElementById('addCatImage').files[0];
    if (imageFile) fd.append('image', imageFile);
    LANGS.forEach(lang => {
      const n  = document.getElementById(`addCatName_${lang}`)?.value.trim();
      const d  = document.getElementById(`addCatDesc_${lang}`)?.value.trim();
      const pn = document.getElementById(`addCatPublicNotes_${lang}`)?.value.trim();
      if (n)  fd.append(`name_${lang}`, n);
      if (d)  fd.append(`description_${lang}`, d);
      if (pn) fd.append(`public_notes_${lang}`, pn);
    });

    try {
      const { data } = await api('POST', '/api/categories', fd);
      const newSubId  = data.category.id;
      const total     = directItems.length + directSetMenus.length;

      if (total > 0) {
        // Migrate all parent-level items into the first sub
        await Promise.all([
          ...directItems.map(mic =>
            api('PATCH', `/api/menu-items/${mic.menu_item.id}/move`, {
              from_category_id: parseInt(parentId),
              to_category_id:   newSubId,
            })
          ),
          ...directSetMenus.map(smc =>
            api('PATCH', `/api/set-menus/${smc.set_menu.id}/move-category`, {
              from_category_id: parseInt(parentId),
              to_category_id:   newSubId,
            })
          ),
        ]);
        showToast(tr('sub_created_items_moved', { count: total }));
      } else {
        showToast(tr('category_created'));
      }

      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function submitEditCategory() {
    const id       = document.getElementById('editCatId').value;
    const parentId = document.getElementById('editCatParentId').value;
    const fd       = new FormData();
    fd.append('is_active', document.getElementById('editCatIsActive').checked);
    fd.append('parent_id', parentId === '' ? '' : parentId);
    fd.append('notes', document.getElementById('editCatNotes')?.value.trim() || '');
    const imageFile = document.getElementById('editCatImage').files[0];
    if (imageFile) fd.append('image', imageFile);
    LANGS.forEach(lang => {
      fd.append(`name_${lang}`,         document.getElementById(`editCatName_${lang}`)?.value.trim()        || '');
      fd.append(`description_${lang}`,  document.getElementById(`editCatDesc_${lang}`)?.value.trim()        || '');
      fd.append(`public_notes_${lang}`, document.getElementById(`editCatPublicNotes_${lang}`)?.value.trim() || '');
    });
    try {
      const { data } = await api('PUT', `/api/categories/${id}`, fd);
      showToast(tr('category_updated'));
      if (typeof window._onCatSaved === 'function') {
        const cb = window._onCatSaved;
        window._onCatSaved = null;
        closeModal('editCatModal');
        cb(data.category);
      } else {
        reloadAfter();
      }
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function deleteCategory(id, name) {
    confirmDelete(tUI('modal.confirm_delete_named', { name }), async () => {
      try {
        await api('DELETE', `/api/categories/${id}`);
        showToast(tr('category_deleted'));
        reloadAfter();
      } catch (err) { showToast(err.message, 'error'); }
    });
  }
</script>
