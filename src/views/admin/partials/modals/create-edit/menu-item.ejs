<!-- ── Add / Edit Item Modal ───────────────────────────────────────────────── -->
<!-- Requires in scope: langs, primary, categories, allergens, dietaryTags    -->
<div id="itemModal" class="modal-overlay hidden">
  <div class="modal modal--lg" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 id="itemModalTitle" class="modal__title">Create Item</h3>
      <button onclick="_handleItemModalClose()" class="modal__close">&times;</button>
    </div>

    <form id="itemForm" onsubmit="submitDishForm(event)" enctype="multipart/form-data" novalidate>
      <div class="modal__body">
        <input type="hidden" id="itemId" value="" />

        <div data-lang-container class="modal-lang-section">
          <div class="lang-tabs">
            <% langs.forEach((lang, i) => { %>
              <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
                data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
                <%= lang.toUpperCase() %>
              </button>
            <% }) %>
          </div>
          <% langs.forEach((lang, i) => { %>
            <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
              <div class="form-group">
                <label class="form-label"><%= t('modal.label_name').replace('{lang}', lang.toUpperCase()) %></label>
                <input type="text" name="name_<%= lang %>" id="itemName_<%= lang %>" class="form-input" />
              </div>
              <div class="form-group">
                <label class="form-label"><%= t('modal.label_description').replace('{lang}', lang.toUpperCase()) %></label>
                <textarea name="description_<%= lang %>" id="itemDesc_<%= lang %>" rows="2" class="form-textarea"></textarea>
              </div>
              <div class="form-group">
                <label class="form-label"><%= t('modal.label_public_notes').replace('{lang}', lang.toUpperCase()) %> <span class="hint"><%= t('modal.hint_shown_to_customers') %></span></label>
                <textarea name="public_notes_<%= lang %>" id="itemPublicNotes_<%= lang %>" rows="2" class="form-textarea"></textarea>
              </div>
              <div class="form-group">
                <label class="form-label"><%= t('modal.label_price_note').replace('{lang}', lang.toUpperCase()) %> <span class="hint"><%= t('modal.hint_price_note') %></span></label>
                <input type="text" name="price_note_<%= lang %>" id="itemPriceNote_<%= lang %>" class="form-input" />
              </div>
            </div>
          <% }) %>
        </div>

        <div class="form-group">
          <label class="form-label"><%= t('modal.label_internal_notes') %> <span class="hint"><%= t('modal.hint_admin_only') %></span></label>
          <textarea name="notes" id="itemNotes" rows="2" class="form-textarea"></textarea>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label"><%= t('modal.label_price') %></label>
            <input type="number" id="itemPrice" name="price" step="0.01" class="form-input" placeholder="—" />
          </div>
          <div class="form-group">
            <label class="form-label"><%= t('modal.label_discount') %></label>
            <div class="discount-group">
              <label class="smb-avail-switch smb-avail-switch--brand">
                <input type="checkbox" id="itemHasDiscount" name="has_discount"
                       onchange="toggleDiscount()">
                <span class="smb-avail-label" id="itemDiscountLabel"><%= t('common.off') %></span>
              </label>
              <div id="discountFields" class="discount-fields hidden">
                <div class="form-group">
                  <label class="form-label"><%= t('modal.label_type') %></label>
                  <select id="itemDiscountType" name="discount_type" class="form-select">
                    <option value="percent"><%= t('modal.label_discount_percent') %></option>
                    <option value="flat"><%= t('modal.label_discount_flat') %></option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label"><%= t('modal.label_value') %></label>
                  <input type="number" id="itemDiscountValue" name="discount_value" step="0.01" min="0" class="form-input" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="image-upload-row">
          <div class="image-upload-input">
            <label class="form-label"><%= t('modal.label_image') %></label>
            <input type="file" id="itemImage" name="image" accept="image/*" class="form-file" />
          </div>
          <div id="currentImagePreview" class="image-preview hidden">
            <img id="currentImage" src="" alt="" class="table-thumb table-thumb--clickable"
                 onclick="openModalLightbox(this.src)" />
            <span id="imagePreviewLabel" class="image-preview__label"><%= t('modal.image_current') %></span>
            <button type="button" class="image-preview__clear" onclick="clearImagePreview('itemImage','currentImagePreview')" aria-label="Remove">&times;</button>
          </div>
        </div>

        <div class="modal-toggles">
          <div class="modal-toggle-item">
            <span class="modal-toggle-label"><%= t('modal.label_availability') %></span>
            <label class="smb-avail-switch">
              <input type="checkbox" id="itemIsAvailable" name="is_available" checked
                     onchange="updateModalToggle('itemIsAvailable', 'itemAvailLabel', tUI('common.live'), tUI('common.off'))">
              <span class="smb-avail-label smb-avail-label--on" id="itemAvailLabel"><%= t('common.live') %></span>
            </label>
          </div>
          <div class="modal-toggle-item">
            <span class="modal-toggle-label"><%= t('modal.label_special') %></span>
            <label class="smb-avail-switch smb-avail-switch--brand">
              <input type="checkbox" id="itemIsSpecial" name="is_special"
                     onchange="updateModalToggle('itemIsSpecial', 'itemSpecialLabel', tUI('common.special'), tUI('common.off'))">
              <span class="smb-avail-label" id="itemSpecialLabel"><%= t('common.off') %></span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label"><%= t('modal.label_categories') %></label>
          <div class="check-list check-list--single">
            <% categories.filter(c => !c.parent_id && c.slug !== 'set-menus').forEach(cat => { %>
              <% const visibleChildren = (cat.children || []).filter(c => c.slug !== 'set-menus'); %>
              <div class="cat-group">
                <label class="form-check cat-group__parent">
                  <% if (visibleChildren.length > 0) { %>
                    <input type="checkbox" class="item-category-cb item-cat-parent-cb" data-cat-id="<%= cat.id %>" />
                  <% } else { %>
                    <input type="checkbox" name="category_ids" value="<%= cat.id %>" class="item-category-cb item-cat-leaf-cb" />
                  <% } %>
                  <span class="form-check__label"><%= catName(cat) %></span>
                </label>
                <% if (visibleChildren.length > 0) { %>
                  <div class="cat-group__children">
                    <% visibleChildren.forEach(child => { %>
                      <label class="form-check">
                        <input type="checkbox" name="category_ids" value="<%= child.id %>" class="item-category-cb item-cat-child-cb" data-parent-id="<%= cat.id %>" />
                        <span class="form-check__label"><%= catName(child) %></span>
                      </label>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label"><%= t('modal.label_allergens') %></label>
          <div class="check-list">
            <% allergens.forEach(a => { %>
              <label class="form-check">
                <input type="checkbox" name="allergen_ids" value="<%= a.id %>" class="item-allergen-cb" />
                <span class="form-check__label"><%= tagName(a.translations) %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label"><%= t('modal.label_dietary_tags') %></label>
          <div class="check-list">
            <% dietaryTags.forEach(d => { %>
              <label class="form-check">
                <input type="checkbox" name="dietary_ids" value="<%= d.id %>" class="item-dietary-cb" />
                <span class="form-check__label"><%= tagName(d.translations) %></span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="modal__footer">
        <button type="button" onclick="_handleItemModalClose()" class="btn btn--secondary"><%= t('modal.btn_cancel') %></button>
        <button type="submit" class="btn btn--primary"><%= t('modal.btn_save_item') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal image lightbox -->
<div id="modalImageLightbox" class="lightbox hidden" onclick="closeModalLightbox()">
  <img id="modalLightboxImg" src="" alt="" class="lightbox__img" onclick="event.stopPropagation()" />
  <button class="lightbox__close" onclick="closeModalLightbox()">&times;</button>
</div>

<script>
  function toggleDiscount() {
    const checked = document.getElementById('itemHasDiscount').checked;
    document.getElementById('discountFields').classList.toggle('hidden', !checked);
    updateModalToggle('itemHasDiscount', 'itemDiscountLabel', tUI('common.on'), tUI('common.off'));
  }

  function updateModalToggle(checkId, labelId, onText, offText) {
    const checked = document.getElementById(checkId).checked;
    const label   = document.getElementById(labelId);
    label.textContent = checked ? onText : offText;
    label.className   = `smb-avail-label smb-avail-label--${checked ? 'on' : 'off'}`;
  }

  function openModalLightbox(src) {
    document.getElementById('modalLightboxImg').src = src;
    document.getElementById('modalImageLightbox').classList.remove('hidden');
  }

  function closeModalLightbox() {
    document.getElementById('modalImageLightbox').classList.add('hidden');
    document.getElementById('modalLightboxImg').src = '';
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModalLightbox();
  });

  document.getElementById('itemImage').addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    const url = URL.createObjectURL(file);
    document.getElementById('currentImage').src = url;
    document.getElementById('imagePreviewLabel').textContent = tUI('modal.image_new_selected');
    document.getElementById('currentImagePreview').classList.remove('hidden');
  });

  function openAddDishModal(presetCategoryId) {
    document.getElementById('itemModalTitle').textContent = tUI('modal.title_create_item');
    document.getElementById('itemId').value = '';
    document.getElementById('itemForm').reset();
    document.getElementById('currentImagePreview').classList.add('hidden');
    document.getElementById('discountFields').classList.add('hidden');
    updateModalToggle('itemIsAvailable', 'itemAvailLabel', tUI('common.live'), tUI('common.off'));
    updateModalToggle('itemIsSpecial', 'itemSpecialLabel', tUI('common.special'), tUI('common.off'));
    updateModalToggle('itemHasDiscount', 'itemDiscountLabel', tUI('common.on'), tUI('common.off'));
    if (presetCategoryId) {
      const presetId = String(presetCategoryId);
      const childCb  = document.querySelector(`.item-cat-child-cb[value="${presetId}"]`);
      if (childCb) {
        childCb.checked = true;
        const parentCb = document.querySelector(`.item-cat-parent-cb[data-cat-id="${childCb.dataset.parentId}"]`);
        if (parentCb) parentCb.checked = true;
      } else {
        const leafCb = document.querySelector(`.item-cat-leaf-cb[value="${presetId}"]`);
        if (leafCb) {
          leafCb.checked = true;
        } else {
          const parentCb = document.querySelector(`.item-cat-parent-cb[data-cat-id="${presetId}"]`);
          if (parentCb) { parentCb.checked = true; parentCb.dispatchEvent(new Event('change')); }
        }
      }
    }
    const container = document.querySelector('#itemModal [data-lang-container]');
    resetLangTabs(container, PRIMARY);
    openModal('itemModal');
  }

  function openEditDishModal(item) {
    document.getElementById('itemModalTitle').textContent = tUI('modal.title_edit_item');
    document.getElementById('itemId').value              = item.id;
    document.getElementById('itemPrice').value           = item.price != null ? Number(item.price).toFixed(2) : '';
    document.getElementById('itemIsAvailable').checked   = item.is_available;
    document.getElementById('itemIsSpecial').checked     = item.is_special;
    document.getElementById('itemHasDiscount').checked   = item.has_discount;
    document.getElementById('itemDiscountType').value    = item.discount_type || 'percent';
    document.getElementById('itemDiscountValue').value   = item.discount_value ? Number(item.discount_value).toFixed(2) : '';
    document.getElementById('discountFields').classList.toggle('hidden', !item.has_discount);
    updateModalToggle('itemIsAvailable', 'itemAvailLabel', tUI('common.live'), tUI('common.off'));
    updateModalToggle('itemIsSpecial', 'itemSpecialLabel', tUI('common.special'), tUI('common.off'));
    updateModalToggle('itemHasDiscount', 'itemDiscountLabel', tUI('common.on'), tUI('common.off'));

    const byLang = {};
    (item.translations || []).forEach(t => byLang[t.lang] = t);
    LANGS.forEach(lang => {
      const t  = byLang[lang] || {};
      const n  = document.getElementById(`itemName_${lang}`);        if (n)  n.value  = t.name         || '';
      const d  = document.getElementById(`itemDesc_${lang}`);        if (d)  d.value  = t.description  || '';
      const pn = document.getElementById(`itemPublicNotes_${lang}`); if (pn) pn.value = t.public_notes || '';
      const pno = document.getElementById(`itemPriceNote_${lang}`);  if (pno) pno.value = t.price_note || '';
    });
    document.getElementById('itemNotes').value = item.notes || '';

    if (item.image_url) {
      document.getElementById('currentImage').src = item.image_url;
      document.getElementById('imagePreviewLabel').textContent = tUI('modal.image_current');
      document.getElementById('currentImagePreview').classList.remove('hidden');
    } else {
      document.getElementById('currentImagePreview').classList.add('hidden');
    }

    const catIds      = item.categories.map(c => String(c.category_id));
    const allergenIds = item.allergens.map(a => String(a.allergen_id));
    const dietaryIds  = item.dietary.map(d => String(d.dietary_id));

    document.querySelectorAll('.item-cat-leaf-cb, .item-cat-child-cb').forEach(cb => { cb.checked = catIds.includes(cb.value); });
    document.querySelectorAll('.item-cat-parent-cb[data-cat-id]').forEach(parentCb => {
      parentCb.checked = [...document.querySelectorAll(`.item-cat-child-cb[data-parent-id="${parentCb.dataset.catId}"]`)].some(c => c.checked);
    });
    document.querySelectorAll('.item-allergen-cb').forEach(cb => { cb.checked = allergenIds.includes(cb.value); });
    document.querySelectorAll('.item-dietary-cb').forEach(cb => { cb.checked = dietaryIds.includes(cb.value); });

    const container = document.querySelector('#itemModal [data-lang-container]');
    resetLangTabs(container, PRIMARY);
    openModal('itemModal');
  }

  function _handleItemModalClose() {
    closeModal('itemModal');
    if (typeof window._onItemSaved === 'function') window._onItemSaved = null;
    if (typeof window._onItemModalClose === 'function') {
      const cb = window._onItemModalClose;
      window._onItemModalClose = null;
      cb();
    }
  }

  async function submitDishForm(e) {
    e.preventDefault();
    const id     = document.getElementById('itemId').value;
    const fd     = new FormData(e.target);
    const url    = id ? `/api/menu-items/${id}` : '/api/menu-items';
    const method = id ? 'PUT' : 'POST';
    try {
      const { data } = await api(method, url, fd);
      showToast(tr(id ? 'item_updated' : 'item_created'));
      if (typeof window._onItemSaved === 'function') {
        const cb = window._onItemSaved;
        window._onItemSaved = null;
        closeModal('itemModal');
        cb(data.item);
      } else {
        closeModal('itemModal');
        reloadAfter();
      }
    } catch (err) {
      showToast(apiError(err), 'error');
    }
  }

  async function deleteItem(id, name) {
    confirmDelete(tUI('modal.confirm_delete_named', { name }), async () => {
      try {
        await api('DELETE', `/api/menu-items/${id}`);
        showToast(tr('item_deleted'));
        reloadAfter();
      } catch (err) { showToast(apiError(err), 'error'); }
    });
  }

  async function toggleAvailability(id, current) {
    try {
      await api('PUT', `/api/menu-items/${id}`, { is_available: !current });
      reloadAfter(100);
    } catch (err) { showToast(apiError(err), 'error'); }
  }

  (function initCategoryCheckboxes() {
    document.querySelectorAll('.item-cat-parent-cb[data-cat-id]').forEach(parentCb => {
      const children = [...document.querySelectorAll(`.item-cat-child-cb[data-parent-id="${parentCb.dataset.catId}"]`)];
      if (!children.length) return;
      parentCb.addEventListener('change', function() {
        if (this.checked) {
          if (!children.some(c => c.checked)) children[0].checked = true;
        } else {
          children.forEach(c => { c.checked = false; });
        }
      });
      children.forEach(child => {
        child.addEventListener('change', function() {
          parentCb.checked = children.some(c => c.checked);
        });
      });
    });
  })();
</script>
