<!-- ── Create / Edit Set Menu Modal ───────────────────────────────────────── -->
<!-- Requires in scope: langs, primary, categories                             -->
<%
  function smCatName(cat) {
    const t = (cat.translations || []).find(t => t.lang === primary) || (cat.translations || [])[0];
    return t ? (t.name || cat.slug) : cat.slug;
  }
  const smLockedCat = categories.find(c => c.slug === 'set-menus');
%>
<div id="setMenuModal" class="modal-overlay hidden">
  <div class="modal modal--lg" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 id="setMenuModalTitle" class="modal__title">Create Set Menu</h3>
      <button onclick="_handleSmModalClose()" class="modal__close">&times;</button>
    </div>
    <form id="setMenuForm" onsubmit="submitSetMenu(event)" enctype="multipart/form-data">
      <div class="modal__body">
        <input type="hidden" id="setMenuId" value="" />

        <div data-lang-container class="modal-lang-section">
          <div class="lang-tabs">
            <% langs.forEach((lang, i) => { %>
              <button type="button" class="lang-tab <%= i === 0 ? 'lang-tab--active' : '' %>"
                data-lang="<%= lang %>" onclick="switchLangTab(this, '<%= lang %>')">
                <%= lang.toUpperCase() %>
              </button>
            <% }) %>
          </div>
          <% langs.forEach((lang, i) => { %>
            <div class="lang-panel <%= i === 0 ? 'lang-panel--active' : '' %>" data-lang="<%= lang %>">
              <div class="form-group">
                <label class="form-label"><%= t('modal.label_name').replace('{lang}', lang.toUpperCase()) %></label>
                <input type="text" name="name_<%= lang %>" id="smName_<%= lang %>" class="form-input" />
              </div>
              <div class="form-group">
                <label class="form-label"><%= t('modal.label_description').replace('{lang}', lang.toUpperCase()) %></label>
                <textarea name="description_<%= lang %>" id="smDesc_<%= lang %>" rows="2" class="form-textarea"></textarea>
              </div>
              <div class="form-group">
                <label class="form-label"><%= t('modal.label_public_notes').replace('{lang}', lang.toUpperCase()) %> <span class="hint"><%= t('modal.hint_shown_to_customers') %></span></label>
                <textarea name="public_notes_<%= lang %>" id="smPublicNotes_<%= lang %>" rows="2" class="form-textarea"></textarea>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label"><%= t('modal.label_price') %> <span class="required">*</span></label>
            <input type="number" id="smPrice" name="price" required step="0.01" min="0" class="form-input" />
          </div>
          <div class="form-group">
            <label class="form-label"><%= t('modal.label_discount') %></label>
            <div class="discount-group">
              <label class="smb-avail-switch smb-avail-switch--brand">
                <input type="checkbox" id="smHasDiscount" name="has_discount" onchange="toggleSmDiscount()">
                <span class="smb-avail-label" id="smDiscountLabel"><%= t('common.off') %></span>
              </label>
              <div id="smDiscountFields" class="discount-fields hidden">
                <div class="form-group">
                  <label class="form-label"><%= t('modal.label_type') %></label>
                  <select id="smDiscountType" name="discount_type" class="form-select">
                    <option value="percent"><%= t('modal.label_discount_percent') %></option>
                    <option value="flat"><%= t('modal.label_discount_flat') %></option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label"><%= t('modal.label_value') %></label>
                  <input type="number" id="smDiscountValue" name="discount_value" step="0.01" min="0" class="form-input" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="image-upload-row">
          <div class="image-upload-input">
            <label class="form-label"><%= t('modal.label_image') %></label>
            <input type="file" id="smImage" name="image" accept="image/*" class="form-file" />
          </div>
          <div id="smCurrentImageWrap" class="image-preview hidden">
            <img id="smCurrentImage" src="" alt="" class="table-thumb table-thumb--clickable"
                 onclick="openSmLightbox(this.src)" />
            <span class="image-preview__label"><%= t('modal.image_current') %></span>
            <button type="button" class="image-preview__clear" onclick="clearImagePreview('smImage','smCurrentImageWrap')" aria-label="Remove">&times;</button>
          </div>
        </div>

        <div class="modal-toggles">
          <div class="modal-toggle-item">
            <span class="modal-toggle-label"><%= t('modal.label_availability') %></span>
            <label class="smb-avail-switch">
              <input type="checkbox" id="smIsAvailable" name="is_available" checked
                     onchange="updateModalToggle('smIsAvailable', 'smAvailLabel', tUI('common.live'), tUI('common.off'))">
              <span class="smb-avail-label smb-avail-label--on" id="smAvailLabel"><%= t('common.live') %></span>
            </label>
          </div>
          <div class="modal-toggle-item">
            <span class="modal-toggle-label"><%= t('modal.label_special') %></span>
            <label class="smb-avail-switch smb-avail-switch--brand">
              <input type="checkbox" id="smIsSpecial" name="is_special"
                     onchange="updateModalToggle('smIsSpecial', 'smSpecialLabel', tUI('common.special'), tUI('common.off'))">
              <span class="smb-avail-label" id="smSpecialLabel"><%= t('common.off') %></span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label"><%= t('modal.label_categories') %></label>
          <div class="check-list check-list--single">
            <% if (smLockedCat) { %>
              <% const smLockedSubs = (smLockedCat.children || []).slice().sort((a,b) => (a.display_order||0) - (b.display_order||0)); %>
              <div class="cat-group">
                <label class="form-check cat-group__parent" style="cursor:default;">
                  <input type="checkbox" checked disabled style="pointer-events:none;" />
                  <span class="form-check__label" style="color:var(--text-muted);">
                    <%= smCatName(smLockedCat) %>
                    <span class="badge badge--gray" style="margin-left:0.3rem;font-size:0.6rem;color:var(--text-secondary);"><%= t('modal.label_always_badge') %></span>
                  </span>
                </label>
                <% if (smLockedSubs.length > 0) { %>
                  <div class="cat-group__children">
                    <% smLockedSubs.forEach((sub, i) => { %>
                      <label class="form-check">
                        <input type="checkbox" name="category_ids" value="<%= sub.id %>"
                               class="sm-locked-sub-cb" <%= i === 0 ? 'checked' : '' %> />
                        <span class="form-check__label"><%= smCatName(sub) %></span>
                      </label>
                    <% }) %>
                  </div>
                <% } else { %>
                  <input type="hidden" name="category_ids" value="<%= smLockedCat.id %>" />
                <% } %>
              </div>
            <% } %>
            <% categories.filter(c => !c.parent_id && c.slug !== 'set-menus').forEach(cat => { %>
              <% const visibleSmChildren = (cat.children || []).filter(c => c.slug !== 'set-menus'); %>
              <div class="cat-group">
                <label class="form-check cat-group__parent">
                  <% if (visibleSmChildren.length > 0) { %>
                    <input type="checkbox" class="sm-cat-cb sm-cat-parent-cb" data-cat-id="<%= cat.id %>" />
                  <% } else { %>
                    <input type="checkbox" name="category_ids" value="<%= cat.id %>" class="sm-cat-cb sm-cat-leaf-cb" />
                  <% } %>
                  <span class="form-check__label"><%= smCatName(cat) %></span>
                </label>
                <% if (visibleSmChildren.length > 0) { %>
                  <div class="cat-group__children">
                    <% visibleSmChildren.forEach(child => { %>
                      <label class="form-check">
                        <input type="checkbox" name="category_ids" value="<%= child.id %>"
                               class="sm-cat-cb sm-cat-child-cb" data-parent-id="<%= cat.id %>" />
                        <span class="form-check__label"><%= smCatName(child) %></span>
                      </label>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>

      </div>
      <div class="modal__footer">
        <button type="button" onclick="_handleSmModalClose()" class="btn btn--secondary"><%= t('modal.btn_cancel') %></button>
        <button type="submit" class="btn btn--primary"><%= t('modal.btn_save') %></button>
      </div>
    </form>
  </div>
</div>

<script>
  function _handleSmModalClose() {
    closeModal('setMenuModal');
    const cb = window._onSmModalClose;
    window._onSmSaved      = null;
    window._onSmModalClose = null;
    if (cb) cb();
  }

  function toggleSmDiscount() {
    const checked = document.getElementById('smHasDiscount').checked;
    document.getElementById('smDiscountFields').classList.toggle('hidden', !checked);
    const label = document.getElementById('smDiscountLabel');
    label.textContent = checked ? tUI('common.on') : tUI('common.off');
    label.className   = `smb-avail-label smb-avail-label--${checked ? 'on' : 'off'}`;
  }

  document.getElementById('smImage').addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    document.getElementById('smCurrentImage').src = URL.createObjectURL(file);
    document.getElementById('smCurrentImageWrap').classList.remove('hidden');
  });

  function openSmLightbox(src) {
    document.getElementById('modalLightboxImg').src = src;
    document.getElementById('modalImageLightbox').classList.remove('hidden');
  }

  function openCreateModal() {
    document.getElementById('setMenuModalTitle').textContent = tUI('modal.title_create_set_menu');
    document.getElementById('setMenuId').value = '';
    document.getElementById('setMenuForm').reset();
    document.getElementById('smCurrentImageWrap').classList.add('hidden');
    document.getElementById('smDiscountFields').classList.add('hidden');
    updateModalToggle('smIsAvailable', 'smAvailLabel', tUI('common.live'), tUI('common.off'));
    updateModalToggle('smIsSpecial',   'smSpecialLabel', tUI('common.special'), tUI('common.off'));
    const lbl = document.getElementById('smDiscountLabel');
    lbl.textContent = tUI('common.off');
    lbl.className   = 'smb-avail-label smb-avail-label--off';
    document.querySelectorAll('.sm-cat-leaf-cb, .sm-cat-child-cb').forEach(cb => { cb.checked = false; });
    document.querySelectorAll('.sm-cat-parent-cb').forEach(cb => { cb.checked = false; });
    document.querySelectorAll('.sm-locked-sub-cb').forEach((cb, i) => { cb.checked = i === 0; });
    resetLangTabs(document.querySelector('#setMenuModal [data-lang-container]'), PRIMARY);
    openModal('setMenuModal');
  }

  function openEditModal() {
    if (!activeSmId) return;
    const sm = SM_DATA.find(s => s.id === activeSmId);
    if (!sm) return;

    document.getElementById('setMenuModalTitle').textContent = tUI('modal.title_edit_set_menu');
    document.getElementById('setMenuId').value               = sm.id;
    document.getElementById('smPrice').value                 = Number(sm.price).toFixed(2);
    document.getElementById('smIsAvailable').checked         = sm.is_available;
    document.getElementById('smIsSpecial').checked           = sm.is_special;
    document.getElementById('smHasDiscount').checked         = sm.has_discount;
    document.getElementById('smDiscountType').value          = sm.discount_type  || 'percent';
    document.getElementById('smDiscountValue').value         = sm.discount_value ? Number(sm.discount_value).toFixed(2) : '';
    document.getElementById('smDiscountFields').classList.toggle('hidden', !sm.has_discount);
    updateModalToggle('smIsAvailable', 'smAvailLabel',   tUI('common.live'),    tUI('common.off'));
    updateModalToggle('smIsSpecial',   'smSpecialLabel', tUI('common.special'), tUI('common.off'));
    const lbl = document.getElementById('smDiscountLabel');
    lbl.textContent = sm.has_discount ? tUI('common.on') : tUI('common.off');
    lbl.className   = `smb-avail-label smb-avail-label--${sm.has_discount ? 'on' : 'off'}`;

    const byLang = {};
    (sm.translations || []).forEach(t => byLang[t.lang] = t);
    LANGS.forEach(lang => {
      const t  = byLang[lang] || {};
      const n  = document.getElementById(`smName_${lang}`);        if (n)  n.value  = t.name         || '';
      const d  = document.getElementById(`smDesc_${lang}`);        if (d)  d.value  = t.description  || '';
      const pn = document.getElementById(`smPublicNotes_${lang}`); if (pn) pn.value = t.public_notes || '';
    });

    if (sm.image_url) {
      document.getElementById('smCurrentImage').src = sm.image_url;
      document.getElementById('smCurrentImageWrap').classList.remove('hidden');
    } else {
      document.getElementById('smCurrentImageWrap').classList.add('hidden');
    }

    const catIds = new Set((sm.categories || []).map(c => String(c.category_id)));
    document.querySelectorAll('.sm-cat-leaf-cb, .sm-cat-child-cb, .sm-locked-sub-cb').forEach(cb => {
      cb.checked = catIds.has(cb.value);
    });
    document.querySelectorAll('.sm-cat-parent-cb[data-cat-id]').forEach(parentCb => {
      parentCb.checked = [...document.querySelectorAll(`.sm-cat-child-cb[data-parent-id="${parentCb.dataset.catId}"]`)].some(c => c.checked);
    });

    resetLangTabs(document.querySelector('#setMenuModal [data-lang-container]'), PRIMARY);
    openModal('setMenuModal');
  }

  async function submitSetMenu(e) {
    e.preventDefault();
    const id     = document.getElementById('setMenuId').value;
    const fd     = new FormData(e.target);
    const url    = id ? `/api/set-menus/${id}` : '/api/set-menus';
    const method = id ? 'PUT' : 'POST';
    try {
      const { data } = await api(method, url, fd);
      showToast(tr(id ? 'set_menu_updated' : 'set_menu_created'));
      closeModal('setMenuModal');
      const cb = window._onSmSaved;
      window._onSmSaved    = null;
      window._onSmModalClose = null;
      if (cb) {
        await cb(parseInt(id));
      } else if (id) {
        await refreshAndRender(parseInt(id));
      } else {
        reloadAfter(300);
      }
    } catch (err) { showToast(apiError(err), 'error'); }
  }

  (function initSmCategoryCheckboxes() {
    document.querySelectorAll('.sm-cat-parent-cb[data-cat-id]').forEach(parentCb => {
      const children = [...document.querySelectorAll(`.sm-cat-child-cb[data-parent-id="${parentCb.dataset.catId}"]`)];
      if (!children.length) return;
      parentCb.addEventListener('change', function() {
        if (this.checked) {
          if (!children.some(c => c.checked)) children[0].checked = true;
        } else {
          children.forEach(c => { c.checked = false; });
        }
      });
      children.forEach(child => {
        child.addEventListener('change', function() {
          parentCb.checked = children.some(c => c.checked);
        });
      });
    });
  })();

  async function confirmDeleteSm() {
    if (!activeSmId) return;
    const sm = SM_DATA.find(s => s.id === activeSmId);
    confirmDelete(tUI('modal.confirm_delete_named', { name: getName(sm?.translations) }), async () => {
      try {
        await api('DELETE', `/api/set-menus/${activeSmId}`);
        showToast(tr('set_menu_deleted'));
        reloadAfter(300);
      } catch (err) { showToast(apiError(err), 'error'); }
    });
  }
</script>
