<!DOCTYPE html>
<html lang="<%= uiLang %>">
<%- include('../partials/head', { title: t('page.set_menus.title'), restaurantName, section: 'admin' }) %>
<body>

<%- include('./partials/sidebar', { current, user, restaurantName }) %>

<%
  const langs   = settings.enabled_languages || ['en', 'es'];
  const primary = uiLang;

  function tagName(translations) {
    const t = (translations || []).find(t => t.lang === uiLang)
           || (translations || []).find(t => t.lang === 'en')
           || (translations || [])[0];
    return t ? (t.name || '') : '';
  }
  function catName(cat) { return tagName(cat.translations); }

  function tName(translations) {
    if (!translations || !translations.length) return '—';
    const t = translations.find(t => t.lang === primary) || translations[0];
    return t ? (t.name || '—') : '—';
  }
  function tNote(translations) {
    if (!translations || !translations.length) return '';
    const t = translations.find(t => t.lang === primary) || translations[0];
    return t ? (t.notes || '') : '';
  }
  function isSmEjsUnreachable(sm) {
    if (!sm.is_available) return false;
    for (const c of (sm.categories || [])) {
      const cat = c.category;
      if (!cat || !cat.is_active) continue;
      if (!cat.parent_id) return false;
      const parent = categories.find(p => p.id === cat.parent_id);
      if (parent && parent.is_active) return false;
    }
    return true;
  }
%>

<div class="main">
  <header class="page-header page-header--minimal">
    <h2 class="page-header__title"><%= t('page.set_menus.title') %></h2>
    <%- include('./partials/lang-selector') %>
  </header>

  <main class="page-body page-body--minimal">
  <div class="card table-card smb-card">

    <div class="card__header card__header--brand">
      <h3 class="card__title"><%= t('page.set_menus.card_title') %></h3>
      <button onclick="openCreateModal()" class="btn btn--pill btn--outline-accent-on-dark btn--sm"><%= t('page.set_menus.btn_create') %></button>
    </div>

    <div class="smb-tabs">
      <button class="smb-tabs__btn smb-tabs__btn--active" id="smb-tab-list" onclick="showListTab()"><%= t('page.set_menus.tab_list') %></button>
      <button class="smb-tabs__btn" id="smb-tab-detail" onclick="showDetailTab()"><%= t('page.set_menus.tab_builder') %></button>
    </div>

    <div class="smb-split" id="smb-split">

    <!-- ── LEFT PANEL ─────────────────────────────────────────────── -->
    <div class="smb-panel">
      <div class="smb-panel__header">
        <span class="smb-panel__title"><%= t('page.set_menus.panel_title') %></span>
      </div>

      <div class="smb-panel__list" id="smb-list">
        <% if (setMenus.length === 0) { %>
          <div class="smb-panel__empty"><%= t('page.set_menus.panel_empty') %></div>
        <% } %>
        <% setMenus.forEach(sm => { %>
          <div class="smb-item<%= !sm.is_available ? ' smb-item--inactive' : '' %>" data-sm-id="<%= sm.id %>">
            <div class="smb-item__info" onclick="selectSetMenu(<%= sm.id %>)">
              <span class="smb-item__name"><%= tName(sm.translations) %></span>
              <%
                const smListPriceNote = (sm.translations || []).find(t => t.lang === primary)?.price_note || (sm.translations || [])[0]?.price_note || null;
              %>
              <span class="smb-item__price"><%= sm.price != null ? '€' + Number(sm.price).toFixed(2) : '—' %></span>
              <% if (smListPriceNote) { %><span class="smb-item__price view-section__value--muted"><%= smListPriceNote %></span><% } %>
              <span class="smb-dish__badge<%= isSmEjsUnreachable(sm) ? '' : ' hidden' %>"><%= t('common.unassigned') %></span>
            </div>
            <label class="smb-avail-switch" title="<%= t('common.tooltip_toggle_avail') %>">
              <input type="checkbox" <%= sm.is_available ? 'checked' : '' %>
                     onchange="toggleSmAvail(<%= sm.id %>, this.checked)">
              <span class="smb-avail-label smb-avail-label--<%= sm.is_available ? 'on' : 'off' %>"
                    id="smb-avail-label-<%= sm.id %>"><%= sm.is_available ? t('common.live') : t('common.off') %></span>
            </label>
          </div>
        <% }) %>
      </div>

      <!-- Courses Library -->
      <div class="smb-library" id="smb-library">
        <div class="smb-library__header" onclick="toggleLibrary()">
          <span><%= t('page.set_menus.course_library') %></span>
          <svg class="icon smb-library__chevron" id="smb-lib-chevron"><use href="/admin/icons/sprite.svg#chevron-down"></use></svg>
        </div>
        <div class="smb-library__body hidden" id="smb-library-body">
          <div class="smb-library__list" id="smb-library-list">
            <% if (courses.length === 0) { %>
              <div class="smb-panel__empty"><%= t('page.set_menus.library_empty') %></div>
            <% } %>
            <% courses.forEach(c => { %>
              <div class="smb-library__item">
                <span class="smb-library__item-name"><%= tName(c.translations) %></span>
                <div class="smb-course__actions">
                  <button class="btn-view" onclick='openEditCourseModal(<%- JSON.stringify(c) %>)' title="<%= t('common.tooltip_edit') %>">
                    <svg class="icon icon-closed"><use href="/admin/icons/sprite.svg#eye-closed"></use></svg>
                    <svg class="icon icon-open"><use href="/admin/icons/sprite.svg#eye-open"></use></svg>
                  </button>
                  <button class="btn-delete" onclick="deleteCourse(<%= c.id %>, '<%= tName(c.translations).replace(/'/g, "\\'") %>')" title="<%= t('common.tooltip_delete') %>">
                    <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                  </button>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="smb-library__footer">
            <button onclick="openAddCourseModal()" class="btn btn--pill btn--outline-accent-on-dark btn--sm"><%= t('page.courses.btn_add') %></button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── RIGHT BUILDER ──────────────────────────────────────────── -->
    <div class="smb-builder">

      <!-- Empty state -->
      <div class="smb-empty" id="smb-empty">
        <div class="empty-state__icon">
          <svg class="icon icon--empty-state"><use href="/admin/icons/sprite.svg#set-menus"></use></svg>
        </div>
        <p class="empty-state__text"><%= t('page.set_menus.empty_select') %></p>
        <button onclick="openCreateModal()" class="btn btn--pill btn--outline-brand btn--sm"><%= t('page.set_menus.btn_create') %></button>
      </div>

      <!-- Builder content (JS-rendered) -->
      <div class="smb-content hidden" id="smb-content">

        <!-- Sticky header -->
        <div class="smb-header">
          <div class="smb-header__row">
            <h3 class="smb-header__name" id="smb-name">—</h3>
            <span class="smb-header__price" id="smb-price"></span>
            <label class="smb-avail-switch" title="<%= t('common.tooltip_toggle_avail') %>">
              <input type="checkbox" id="smb-avail-chk" onchange="toggleAvailability()">
              <span class="smb-avail-label" id="smb-avail-label"><%= t('common.live') %></span>
            </label>
            <button class="btn-view" onclick="openSmViewModal(activeSmId)" title="<%= t('common.tooltip_view') %>">
              <svg class="icon icon-closed"><use href="/admin/icons/sprite.svg#eye-closed"></use></svg>
              <svg class="icon icon-open"><use href="/admin/icons/sprite.svg#eye-open"></use></svg>
            </button>
            <button class="btn-delete" onclick="confirmDeleteSm()" title="<%= t('common.tooltip_delete') %>">
              <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
            </button>
          </div>
          <div class="smb-header__bar">
            <img id="smb-img" src="" alt="" class="table-thumb table-thumb--clickable hidden"
                 onclick="openSmViewLightbox(this.src)" />
            <div id="smb-img-placeholder" class="table-thumb-placeholder">
              <svg class="icon"><use href="/admin/icons/sprite.svg#set-menus"></use></svg>
            </div>
            <div class="category-breadcrumbs smb-header__cats" id="smb-cats"></div>
            <button class="btn btn--pill link--slide" onclick="openAddCourseToSmModal()"><%= t('page.courses.btn_add') %></button>
            <button class="btn btn--pill link--slide" onclick="openSmAddItemModal(null)"><%= t('page.builder.btn_add_to_sub') %></button>
          </div>
        </div>

        <!-- Scrollable body -->
        <div class="smb-body" id="smb-body">
          <div id="smb-courses"></div>
          <div id="smb-uncat"></div>
        </div>

      </div>
    </div>

    </div><!-- /.smb-split -->
  </div><!-- /.smb-card -->
  </main><!-- /.page-body -->
</div><!-- /.main -->


<%- include('./partials/modals/view/set-menu', { langs, primary }) %>
<%- include('./partials/modals/create-edit/course', { langs }) %>
<%- include('./partials/modals/create-edit/set-menu', { langs, primary, categories }) %>
<%- include('./partials/modals/create-edit/note', { langs }) %>
<%- include('./partials/modals/add/add-course', { langs }) %>
<%- include('./partials/modals/add/add-item', { langs, primary }) %>
<%- include('./partials/modals/create-edit/menu-item', { langs, primary, categories, allergens, dietaryTags, catName, tagName }) %>

<%- include('./partials/scripts') %>
<script src="/admin/js/sortable.min.js"></script>
<script src="/admin/js/builder-sortable.js"></script>
<script>
// ── Data ─────────────────────────────────────────────────────────────────────
let SM_DATA    = <%- JSON.stringify(setMenus) %>;
let COURSES    = <%- JSON.stringify(courses) %>;
const LANGS    = <%- JSON.stringify(langs) %>;
const PRIMARY  = '<%= primary %>';
const ALL_DISHES = <%- JSON.stringify(dishes) %>;
const ALL_CATS   = <%- JSON.stringify(categories) %>;

let activeSmId = null;
let _sortables = [];

// ── Helpers ──────────────────────────────────────────────────────────────────
function isSmUnreachable(sm) {
  if (!sm.is_available) return false;
  for (const c of (sm.categories || [])) {
    const cat = c.category;
    if (!cat || !cat.is_active) continue;
    if (!cat.parent_id) return false;
    const parent = ALL_CATS.find(p => p.id === cat.parent_id);
    if (parent && parent.is_active) return false;
  }
  return true;
}

function getName(translations) {
  if (!translations || !translations.length) return '—';
  const t = translations.find(t => t.lang === PRIMARY) || translations[0];
  return t ? (t.name || '—') : '—';
}
function getNote(translations) {
  if (!translations || !translations.length) return '';
  const t = translations.find(t => t.lang === PRIMARY) || translations[0];
  return t ? (t.notes || '') : '';
}

function esc(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

// ── Mobile tab switching ──────────────────────────────────────────────────────
function showListTab() {
  document.getElementById('smb-split').classList.remove('smb-split--detail');
  document.getElementById('smb-tab-list').classList.add('smb-tabs__btn--active');
  document.getElementById('smb-tab-detail').classList.remove('smb-tabs__btn--active');
}

function showDetailTab() {
  document.getElementById('smb-split').classList.add('smb-split--detail');
  document.getElementById('smb-tab-detail').classList.add('smb-tabs__btn--active');
  document.getElementById('smb-tab-list').classList.remove('smb-tabs__btn--active');
}

// ── Panel selection ───────────────────────────────────────────────────────────
function selectSetMenu(id) {
  activeSmId = id;
  sessionStorage.setItem('smb-active', id);
  document.querySelectorAll('.smb-item').forEach(el =>
    el.classList.toggle('smb-item--active', parseInt(el.dataset.smId) === id)
  );
  const sm = SM_DATA.find(s => s.id === id);
  if (sm) renderBuilder(sm);
  showDetailTab();
}

function onCourseModalSaved() {
  if (activeSmId) refreshAndRender(activeSmId);
}

// ── Refresh from API ──────────────────────────────────────────────────────────
async function refreshAndRender(smId) {
  try {
    const res      = await fetch(`/api/set-menus/${smId}`);
    const { data } = await res.json();
    const idx      = SM_DATA.findIndex(s => s.id === smId);
    if (idx !== -1) SM_DATA[idx] = data.setMenu;
    else SM_DATA.push(data.setMenu);
    renderBuilder(data.setMenu);
    updatePanelItem(data.setMenu);
  } catch (e) { showToast(apiError(e), 'error'); }
}

function updatePanelItem(sm) {
  const el = document.querySelector(`.smb-item[data-sm-id="${sm.id}"]`);
  if (!el) return;
  el.querySelector('.smb-item__name').textContent = getName(sm.translations);
  const smPanelPriceNote = (sm.translations || []).find(t => t.lang === PRIMARY)?.price_note || (sm.translations || [])[0]?.price_note || null;
  el.querySelector('.smb-item__price').textContent = sm.price != null ? `€${Number(sm.price).toFixed(2)}` : '—';
  let smNoteEl = el.querySelector('.smb-item__price-note');
  if (smPanelPriceNote) {
    if (!smNoteEl) {
      smNoteEl = document.createElement('span');
      smNoteEl.className = 'smb-item__price smb-item__price-note view-section__value--muted';
      el.querySelector('.smb-item__info').insertBefore(smNoteEl, el.querySelector('.smb-dish__badge'));
    }
    smNoteEl.textContent = smPanelPriceNote;
  } else if (smNoteEl) {
    smNoteEl.remove();
  }
  el.classList.toggle('smb-item--inactive', !sm.is_available);
  const badge = el.querySelector('.smb-dish__badge');
  if (badge) badge.classList.toggle('hidden', !isSmUnreachable(sm));
  const cb  = el.querySelector('input[type="checkbox"]');
  const lbl = document.getElementById(`smb-avail-label-${sm.id}`);
  if (cb)  cb.checked      = sm.is_available;
  if (lbl) lbl.textContent = sm.is_available ? tUI('common.live') : tUI('common.off');
  if (lbl) lbl.className   = `smb-avail-label smb-avail-label--${sm.is_available ? 'on' : 'off'}`;
}

// ── Builder render ────────────────────────────────────────────────────────────
function renderBuilder(sm) {
  document.getElementById('smb-empty').classList.add('hidden');
  document.getElementById('smb-content').classList.remove('hidden');

  document.getElementById('smb-name').textContent  = getName(sm.translations);
  document.getElementById('smb-price').textContent = sm.price != null ? `€${Number(sm.price).toFixed(2)}` : '—';

  const chk = document.getElementById('smb-avail-chk');
  chk.checked = sm.is_available;
  const lbl = document.getElementById('smb-avail-label');
  lbl.textContent = sm.is_available ? tUI('common.live') : tUI('common.off');
  lbl.className   = `smb-avail-label smb-avail-label--${sm.is_available ? 'on' : 'off'}`;

  const smImg         = document.getElementById('smb-img');
  const smPlaceholder = document.getElementById('smb-img-placeholder');
  if (sm.image_url) {
    smImg.src = sm.image_url;
    smImg.classList.remove('hidden');
    smPlaceholder.classList.add('hidden');
  } else {
    smImg.src = '';
    smImg.classList.add('hidden');
    smPlaceholder.classList.remove('hidden');
  }

  const catsEl = document.getElementById('smb-cats');
  catsEl.innerHTML = (sm.categories || []).map(c => {
    const cat    = c.category;
    const parent = ALL_CATS.find(p => p.id === cat.parent_id);
    if (parent) {
      return `<div class="breadcrumb-text"><span class="breadcrumb-muted">${esc(getName(parent.translations))}<span class="breadcrumb-sep"> › </span></span>${esc(getName(cat.translations))}</div>`;
    }
    return `<div class="breadcrumb-text">${esc(getName(cat.translations))}</div>`;
  }).join('');

  document.getElementById('smb-courses').innerHTML =
    (sm.courses || []).map(smc => renderCourseSection(smc, sm.id)).join('');

  const hasCourses = (sm.courses || []).length > 0;
  document.getElementById('smb-uncat').innerHTML =
    hasCourses ? '' : renderUncatSection(sm.dishes || [], sm.id);

  initSortables(sm.id);
}

function renderCourseSection(smc, smId) {
  const note    = getNote(smc.translations);
  const noteBtn = note
    ? `<button class="btn btn--pill link--slide btn--sm" onclick="openNoteModal('course', ${smc.id}, null)">${tUI('common.btn_edit_note')}</button>`
    : `<button class="btn btn--pill link--slide btn--sm" onclick="openNoteModal('course', ${smc.id}, null)">${tUI('common.btn_add_note')}</button>`;
  const dishes = (smc.dishes || []).map(d => renderDishRow(d, smId)).join('');

  return `
    <div class="smb-course" data-smc-id="${smc.id}">
      <div class="smb-course__head">
        <span class="bl-handle bl-handle--sm" title="${tUI('common.tooltip_drag_reorder')}">&#8801;</span>
        <div class="smb-course__meta">
          <span class="smb-course__name">${esc(getName(smc.course.translations))}</span>
        </div>
        <div class="smb-course__actions">
          <button onclick="openSmAddItemModal(${smc.id})" class="btn btn--pill link--slide btn--sm">${tUI('page.builder.btn_add_to_sub')}</button>
          ${noteBtn}
          <button class="btn-remove" data-course-name="${esc(getName(smc.course.translations))}" data-sm-name="${esc(getName(SM_DATA.find(s => s.id === smId)?.translations || []))}" onclick="removeCourse(${smId}, ${smc.id}, this.dataset.courseName, this.dataset.smName)" title="${tUI('common.tooltip_remove_from_sm')}">
            <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="smb-dish-list" data-sm-id="${smId}" data-smc-id="${smc.id}" id="dish-list-${smc.id}">
        ${dishes}
      </div>
    </div>`;
}

function renderUncatSection(dishArr, smId) {
  const dishes = dishArr.map(d => renderDishRow(d, smId)).join('');
  return `<div class="smb-dish-list" data-sm-id="${smId}" data-smc-id="none" id="dish-list-none">${dishes}</div>`;
}

function renderDishRow(smd, smId) {
  const note    = getNote(smd.translations);
  const noteBtn = note
    ? `<button class="btn btn--pill link--slide btn--sm" onclick="openNoteModal('dish', ${smd.id}, null)">${tUI('common.btn_edit_note')}</button>`
    : `<button class="btn btn--pill link--slide btn--sm" onclick="openNoteModal('dish', ${smd.id}, null)">${tUI('common.btn_add_note')}</button>`;
  const smData  = SM_DATA.find(s => s.id === smId);
  const smName  = smData ? getName(smData.translations) : '';

  return `
    <div class="smb-dish" data-entry-id="${smd.id}">
      <span class="bl-handle bl-handle--dish" title="${tUI('common.tooltip_drag_move')}">&#8801;</span>
      <div class="smb-dish__info">
        <span class="smb-dish__name">${esc(getName(smd.dish.translations))}</span>
      </div>
      ${noteBtn}
      <button class="btn-remove" data-dish-name="${esc(getName(smd.dish.translations))}" data-sm-name="${esc(smName)}" onclick="removeDish(${smId}, ${smd.id}, this.dataset.dishName, this.dataset.smName)" title="${tUI('common.tooltip_remove_from_sm')}">
        <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
        </svg>
      </button>
    </div>`;
}

// ── Sortable ──────────────────────────────────────────────────────────────────
function initSortables(smId) {
  _sortables.forEach(s => { try { s.destroy(); } catch(e) {} });
  _sortables = initBuilderSortables({
    sectionContainer: document.getElementById('smb-courses'),
    sectionDataAttr:  'smcId',
    itemGroupName:    `dishes-${smId}`,
    scrollEl:         document.getElementById('smb-body'),
    onSectionReorder(items) {
      api('PATCH', `/api/set-menus/${smId}/courses/reorder`, { items })
        .then(() => {
          const sm = SM_DATA.find(s => s.id === smId);
          if (sm?.courses) {
            const order = new Map(items.map(({ id, display_order }) => [id, display_order]));
            sm.courses.sort((a, b) => (order.get(a.id) ?? 0) - (order.get(b.id) ?? 0));
          }
        })
        .catch(err => showToast(apiError(err), 'error'));
    },
    onItemEnd(evt) {
      const fromId  = evt.from.dataset.smcId;
      const toId    = evt.to.dataset.smcId;
      const entryId = parseInt(evt.item.dataset.entryId);

      if (fromId !== toId) {
        const newSmcId = (toId === 'none') ? null : parseInt(toId);
        api('PUT', `/api/set-menus/${smId}/dishes/${entryId}`, { set_menu_course_id: newSmcId })
          .then(() => reorderDishList(evt.to, smId))
          .catch(err => { showToast(apiError(err), 'error'); refreshAndRender(smId); });
      } else {
        reorderDishList(evt.to, smId);
      }
    },
  });
}

function reorderDishList(listEl, smId) {
  const smcId = listEl.dataset.smcId;
  const items = [...listEl.querySelectorAll(':scope > .smb-dish')].map((el, i) => ({
    id:            parseInt(el.dataset.entryId),
    display_order: i,
  }));
  if (!items.length) return;
  api('PATCH', `/api/set-menus/${smId}/dishes/reorder`, { items })
    .then(() => {
      const sm = SM_DATA.find(s => s.id === smId);
      if (!sm) return;
      const order = new Map(items.map(({ id, display_order }) => [id, display_order]));
      if (smcId === 'none') {
        if (sm.dishes) sm.dishes.sort((a, b) => (order.get(a.id) ?? 0) - (order.get(b.id) ?? 0));
      } else {
        const smc = (sm.courses || []).find(c => c.id === parseInt(smcId));
        if (smc?.dishes) smc.dishes.sort((a, b) => (order.get(a.id) ?? 0) - (order.get(b.id) ?? 0));
      }
    })
    .catch(err => showToast(apiError(err), 'error'));
}

// ── Availability toggles ──────────────────────────────────────────────────────
// Sidebar toggle — works for any set menu regardless of which is active
async function toggleSmAvail(smId, checked) {
  try {
    await api('PUT', `/api/set-menus/${smId}`, { is_available: checked });
    const lbl = document.getElementById(`smb-avail-label-${smId}`);
    if (lbl) {
      lbl.textContent = checked ? tUI('common.live') : tUI('common.off');
      lbl.className   = `smb-avail-label smb-avail-label--${checked ? 'on' : 'off'}`;
    }
    const sm = SM_DATA.find(s => s.id === smId);
    if (sm) {
      sm.is_available = checked;
      const itemEl = document.querySelector(`.smb-item[data-sm-id="${smId}"]`);
      if (itemEl) {
        itemEl.classList.toggle('smb-item--inactive', !checked);
        const badge = itemEl.querySelector('.smb-dish__badge');
        if (badge) badge.classList.toggle('hidden', !isSmUnreachable(sm));
      }
      // Keep builder header in sync if this is the currently selected set menu
      if (smId === activeSmId) {
        document.getElementById('smb-avail-chk').checked = checked;
        const headerLbl = document.getElementById('smb-avail-label');
        headerLbl.textContent = checked ? tUI('common.live') : tUI('common.off');
        headerLbl.className   = `smb-avail-label smb-avail-label--${checked ? 'on' : 'off'}`;
      }
    }
    showToast(tr(checked ? 'set_menu_live' : 'set_menu_hidden'));
  } catch (err) {
    const cb = document.querySelector(`.smb-item[data-sm-id="${smId}"] input[type="checkbox"]`);
    if (cb) cb.checked = !checked;
    showToast(apiError(err), 'error');
  }
}

// Builder header toggle — delegates to the sidebar function
async function toggleAvailability() {
  if (!activeSmId) return;
  const chk = document.getElementById('smb-avail-chk');
  await toggleSmAvail(activeSmId, chk.checked);
}

// ── Add item ──────────────────────────────────────────────────────────────────
function openSmAddItemModal(smcId) {
  if (!activeSmId) return;
  const sm        = SM_DATA.find(s => s.id === activeSmId);
  const hasCourses = (sm?.courses || []).length > 0;

  const items = ALL_DISHES.map(d => ({
    id:   d.id,
    name: getName(d.translations),
    meta: d.price != null ? `€${Number(d.price).toFixed(2)}` : '—',
    type: 'dish',
  }));

  // Determine section config based on call context
  const sections  = (smcId === null && hasCourses)
    ? sm.courses.map(smc => ({ id: smc.id, name: getName(smc.course.translations) }))
    : null;
  const sectionId = smcId !== null ? smcId : undefined;

  openAddItemModal({
    showNotes: true,
    items,
    sections,
    sectionId,
    onSubmit: async (itemId, itemType, { sectionId: courseId, notes }) => {
      const body = { dish_id: itemId, set_menu_course_id: courseId, ...notes };
      await api('POST', `/api/set-menus/${activeSmId}/dishes`, body);
      showToast(tr('item_added'));
      await refreshAndRender(activeSmId);
    },
  });
}

async function removeDish(smId, entryId, name, location) {
  confirmRemove(name, location, async () => {
    try {
      await api('DELETE', `/api/set-menus/${smId}/dishes/${entryId}`);
      showToast(tr('item_removed'));
      await refreshAndRender(smId);
    } catch (err) { showToast(apiError(err), 'error'); }
  });
}

// ── Course management ─────────────────────────────────────────────────────────
async function addCourseToSm(courseId, notes) {
  if (!activeSmId) return;
  try {
    const sm            = SM_DATA.find(s => s.id === activeSmId);
    const isFirstCourse = (sm?.courses || []).length === 0;
    const uncatItems    = sm?.dishes || [];

    const { data } = await api('POST', `/api/set-menus/${activeSmId}/courses`, { course_id: courseId });
    const newSmcId  = data.setMenuCourse.id;

    if (notes && Object.keys(notes).length) {
      await api('PATCH', `/api/set-menus/${activeSmId}/courses/${newSmcId}`, notes);
    }

    if (isFirstCourse && uncatItems.length > 0) {
      await Promise.all(uncatItems.map(d =>
        api('PUT', `/api/set-menus/${activeSmId}/dishes/${d.id}`, { set_menu_course_id: newSmcId })
      ));
      showToast(tr('course_added_items_moved', { count: uncatItems.length }));
    } else {
      showToast(tr('course_added'));
    }

    await refreshAndRender(activeSmId);
  } catch (err) { showToast(apiError(err), 'error'); }
}

async function removeCourse(smId, smcId, name, location) {
  confirmRemove(name, location, async () => {
    try {
      await api('DELETE', `/api/set-menus/${smId}/courses/${smcId}`);
      showToast(tr('course_removed'));
      await refreshAndRender(smId);
    } catch (err) { showToast(apiError(err), 'error'); }
  });
}

// ── Course library management ─────────────────────────────────────────────────
function toggleLibrary() {
  const body = document.getElementById('smb-library-body');
  const lib  = document.getElementById('smb-library');
  const open = !body.classList.contains('hidden');
  body.classList.toggle('hidden', open);
  lib.classList.toggle('smb-library--open', !open);
}

// ── Init ──────────────────────────────────────────────────────────────────────
(function init() {
  const lastId = parseInt(sessionStorage.getItem('smb-active'));
  if (lastId && SM_DATA.find(s => s.id === lastId)) {
    selectSetMenu(lastId);
  } else if (SM_DATA.length > 0) {
    selectSetMenu(SM_DATA[0].id);
  }
})();
</script>

</body>
