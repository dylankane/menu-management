<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head', { title: 'Gourmet Club', restaurantName }) %>
<body>

<%- include('../../partials/sidebar', { current, user, restaurantName }) %>

<div class="main">
  <header class="page-header">
    <h2 class="page-header__title">Gourmet Club</h2>
  </header>

  <main class="page-body">
    <div class="stats-grid">
      <div class="stat-card">
        <p class="stat-card__value"><%= stats.totalMembers %></p>
        <p class="stat-card__label">Total Members</p>
      </div>
      <div class="stat-card">
        <p class="stat-card__value"><%= stats.activeMembers %></p>
        <p class="stat-card__label">Active Members</p>
      </div>
      <div class="stat-card">
        <p class="stat-card__value"><%= stats.consentCount %></p>
        <p class="stat-card__label">Marketing Consent</p>
      </div>
    </div>
  </main>
</div>

<%- include('../../partials/scripts') %>
</body>
</html>
