<!DOCTYPE html>
<html lang="<%= uiLang %>">
<%- include('../../partials/head', { title: t('page.gc.members.title'), restaurantName, section: 'admin' }) %>
<body>

<%- include('../partials/sidebar', { current, user, restaurantName }) %>

<div class="main">
  <header class="page-header page-header--minimal">
    <h2 class="page-header__title"><%= t('page.gc.members.title') %></h2>
    <%- include('../partials/lang-selector') %>
  </header>

  <main class="page-body page-body--minimal">
  <div class="dash-tab-panel">

    <!-- ── Add Member Form ──────────────────────────────────────────────────── -->
    <div class="card gc-form-card">
      <div class="card__header card__header--accent">
        <h3 class="card__title"><%= t('page.gc.members.card_add') %></h3>
      </div>
      <div class="card__body form-stack">
        <div class="form-group">
          <label class="form-label" for="gcName"><%= t('page.gc.members.label_name') %> <span class="form-required">*</span></label>
          <input type="text" id="gcName" class="form-input" placeholder="<%= t('page.gc.members.placeholder_name') %>" />
        </div>
        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="gcEmail"><%= t('page.gc.members.label_email') %></label>
            <input type="email" id="gcEmail" class="form-input" placeholder="<%= t('page.gc.members.placeholder_email') %>" />
          </div>
          <div class="form-group">
            <label class="form-label" for="gcPhone"><%= t('page.gc.members.label_phone') %></label>
            <input type="tel" id="gcPhone" class="form-input" placeholder="<%= t('page.gc.members.placeholder_phone') %>" />
          </div>
        </div>
        <label class="smb-avail-switch" onclick="gcToggleAddConsent(event)">
          <input type="checkbox" id="gcConsent" checked tabindex="-1" />
          <span class="smb-avail-label smb-avail-label--on" id="gcConsentLabel"><%= t('page.gc.members.label_consent') %></span>
        </label>

        <button type="button" class="gc-advanced-toggle" id="gcAdvancedToggle" onclick="toggleAdvanced()">
          <svg class="icon gc-advanced-toggle__chevron" id="gcAdvancedChevron"><use href="/admin/icons/sprite.svg#chevron-down"></use></svg>
          <%= t('page.gc.members.btn_add_advanced') %>
        </button>
        <div class="gc-advanced" id="gcAdvanced">
          <div class="form-stack">
            <div class="form-group">
              <label class="form-label"><%= t('page.gc.members.label_birthday') %></label>
              <div class="gc-birthday">
                <select id="gcBirthdayMonth" class="form-select">
                  <option value=""><%= t('page.gc.members.label_month') %></option>
                  <option value="1">January</option>
                  <option value="2">February</option>
                  <option value="3">March</option>
                  <option value="4">April</option>
                  <option value="5">May</option>
                  <option value="6">June</option>
                  <option value="7">July</option>
                  <option value="8">August</option>
                  <option value="9">September</option>
                  <option value="10">October</option>
                  <option value="11">November</option>
                  <option value="12">December</option>
                </select>
                <select id="gcBirthdayDay" class="form-select">
                  <option value=""><%= t('page.gc.members.label_day') %></option>
                  <% for (let d = 1; d <= 31; d++) { %>
                    <option value="<%= d %>"><%= d %></option>
                  <% } %>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="gcNotes"><%= t('page.gc.members.label_notes') %></label>
              <textarea id="gcNotes" class="form-textarea" rows="2" placeholder="<%= t('page.gc.members.placeholder_notes') %>"></textarea>
            </div>
          </div>
        </div>
      </div>
      <div class="card__footer form-footer">
        <button type="button" onclick="addMember()" class="btn btn--primary"><%= t('page.gc.members.btn_add_member') %></button>
      </div>
    </div>

    <!-- ── Sign-up QR card ───────────────────────────────────────────────────── -->
    <div class="card dash-card qr-section">
      <img src="<%= gcJoinQrDataUrl %>" alt="Gourmet Club Sign-up QR Code" />
      <div>
        <h3 class="qr-section__title"><%= t('page.gc.members.qr_title') %></h3>
        <p class="qr-section__desc"><%= t('page.gc.members.qr_desc') %></p>
        <p class="qr-section__url"><%= gcJoinUrl %></p>
        <div class="qr-section__actions">
          <a href="<%= gcJoinUrl %>" target="_blank" class="btn btn--pill btn--outline-accent btn--sm"><%= t('page.gc.members.btn_preview_page') %></a>
          <a href="<%= gcJoinQrDataUrl %>" download="gourmet-club-qr.png" class="btn btn--pill btn--outline-brand btn--sm"><%= t('page.gc.members.btn_download_qr') %></a>
        </div>
      </div>
    </div>

    <!-- ── Paper Form card ──────────────────────────────────────────────────── -->
    <% const hasFront = !!gcPaperFormFrontUrl; const hasBack = !!gcPaperFormBackUrl; %>
    <div class="card dash-card qr-section">
      <% if (hasFront || hasBack) { %>
        <div class="gc-form-thumbs">
          <% if (hasFront) { %>
            <div class="gc-form-thumb">
              <img src="<%= gcPaperFormFrontUrl %>" alt="Front of sign-up form" class="gc-form-thumb__img" onclick="openPaperLightbox('<%= gcPaperFormFrontUrl %>')" />
              <span class="gc-form-thumb__label">Front</span>
            </div>
          <% } %>
          <% if (hasBack) { %>
            <div class="gc-form-thumb">
              <img src="<%= gcPaperFormBackUrl %>" alt="Back of sign-up form" class="gc-form-thumb__img" onclick="openPaperLightbox('<%= gcPaperFormBackUrl %>')" />
              <span class="gc-form-thumb__label">Back</span>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="qr-section__visual">
          <svg class="icon"><use href="/admin/icons/sprite.svg#file-text"></use></svg>
        </div>
      <% } %>
      <div>
        <h3 class="qr-section__title"><%= t('page.gc.members.paper_title') %></h3>
        <p class="qr-section__desc"><%= t('page.gc.members.paper_desc') %></p>
        <% if (!hasFront && !hasBack) { %>
          <p class="qr-section__url"><%= t('page.gc.members.paper_none') %></p>
        <% } %>
        <div class="qr-section__actions">
          <% if (hasFront) { %>
            <a href="<%= gcPaperFormFrontUrl %>" download class="btn btn--pill btn--outline-brand btn--sm"><%= t('page.gc.members.btn_download_front') %></a>
          <% } else { %>
            <label class="btn btn--pill btn--outline-accent btn--sm gc-upload-label">
              <%= t('page.gc.members.btn_upload_front') %>
              <input type="file" accept="image/*" class="gc-form-file-hidden" onchange="uploadPaperForm('front', this)" />
            </label>
          <% } %>
          <% if (hasBack) { %>
            <a href="<%= gcPaperFormBackUrl %>" download class="btn btn--pill btn--outline-brand btn--sm"><%= t('page.gc.members.btn_download_back') %></a>
          <% } else { %>
            <label class="btn btn--pill btn--outline-accent btn--sm gc-upload-label">
              <%= t('page.gc.members.btn_upload_back') %>
              <input type="file" accept="image/*" class="gc-form-file-hidden" onchange="uploadPaperForm('back', this)" />
            </label>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ── Members Table ──────────────────────────────────────────────────────── -->
    <div class="card table-card">
      <div class="card__header card__header--brand">
        <h3 class="card__title"><%= t('page.gc.members.card_all_members') %></h3>
        <button type="button" class="filter-toggle" id="filterToggle" onclick="toggleFilterBar()" title="<%= t('common.tooltip_search') %>">
          <svg class="icon"><use href="/admin/icons/sprite.svg#search"></use></svg>
        </button>
        <a href="/admin/gourmet-club/communications" class="card__header-icon" title="<%= t('common.tooltip_mailing') %>">
          <svg class="icon"><use href="/admin/icons/sprite.svg#download"></use></svg>
        </a>
      </div>
      <div class="filter-bar" id="filterBar">
        <input type="text" id="searchInput" placeholder="<%= t('page.menu_items.filter_search_placeholder') %>" oninput="filterMembers()" class="form-input filter-bar__search" />
        <div class="filter-radios">
          <label class="form-check">
            <input type="radio" name="statusFilter" value="all" onchange="filterMembers()" checked />
            <span class="form-check__label"><%= t('page.menu_items.filter_all') %></span>
          </label>
          <label class="form-check">
            <input type="radio" name="statusFilter" value="active" onchange="filterMembers()" />
            <span class="form-check__label"><%= t('page.menu_items.filter_active') %></span>
          </label>
          <label class="form-check">
            <input type="radio" name="statusFilter" value="inactive" onchange="filterMembers()" />
            <span class="form-check__label"><%= t('page.menu_items.filter_inactive') %></span>
          </label>
        </div>
        <span id="memberCount" class="filter-bar__count"></span>
      </div>

      <div class="table-scroll">
      <% if (members.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state__icon">
            <svg class="icon icon--empty-state"><use href="/admin/icons/sprite.svg#users"></use></svg>
          </div>
          <p class="empty-state__text"><%= t('page.gc.members.table_empty') %></p>
        </div>
      <% } else { %>
        <table class="data-table" id="membersTable">
          <thead>
            <tr>
              <th class="col-align-left"><%= t('page.gc.members.col_number') %></th>
              <th class="col-align-left"><%= t('page.gc.members.label_name') %></th>
              <th class="col-align-left"><%= t('page.gc.members.label_email') %></th>
              <th class="col-align-left"><%= t('page.gc.members.label_phone') %></th>
              <th class="col-align-center"><%= t('page.gc.members.col_joined') %></th>
              <th class="col-align-center"><%= t('page.gc.members.col_visits') %></th>
              <th class="col-align-center"><%= t('page.gc.members.col_consent') %></th>
              <th class="col-align-center"></th>
              <th class="col-align-center"></th>
            </tr>
          </thead>
          <tbody id="membersBody">
            <% members.forEach(m => { %>
              <tr class="item-row"
                  data-id="<%= m.id %>"
                  data-name="<%= (m.name || '').toLowerCase() %>"
                  data-email="<%= (m.email || '').toLowerCase() %>"
                  data-phone="<%= (m.phone || '').toLowerCase() %>"
                  data-active="<%= m.is_active %>">
                <td class="col-align-left">
                  <span class="gc-member-number">GC-<%= String(m.id).padStart(3, '0') %></span>
                </td>
                <td class="col-align-left col-max-width">
                  <p class="table-item__name"><%= m.name %></p>
                </td>
                <td class="col-align-left">
                  <% if (m.email) { %>
                    <a href="mailto:<%= m.email %>" class="table-link"><%= m.email %></a>
                  <% } else { %>
                    <span class="cell-empty">—</span>
                  <% } %>
                </td>
                <td class="col-align-left">
                  <% if (m.phone) { %>
                    <span><%= m.phone %></span>
                  <% } else { %>
                    <span class="cell-empty">—</span>
                  <% } %>
                </td>
                <td class="col-align-center">
                  <span class="cell-date"><%= new Date(m.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                </td>
                <td class="col-align-center">
                  <span class="gc-visit-count"><%= m._count?.visits ?? 0 %></span>
                </td>
                <td class="col-toggle col-align-center">
                  <label class="smb-avail-switch" onclick="toggleConsent(<%= m.id %>, <%= m.marketing_consent %>)">
                    <input type="checkbox" <%= m.marketing_consent ? 'checked' : '' %> readonly tabindex="-1" />
                    <span class="smb-avail-label <%= m.marketing_consent ? 'smb-avail-label--on' : 'smb-avail-label--off' %>">
                      <%= m.marketing_consent ? t('common.live') : t('common.off') %>
                    </span>
                  </label>
                </td>
                <td class="col-align-center">
                  <button class="btn-view" onclick="openGcView(<%= m.id %>)" title="<%= t('common.tooltip_view_member') %>">
                    <svg class="icon icon-closed"><use href="/admin/icons/sprite.svg#eye-closed"></use></svg>
                    <svg class="icon icon-open"><use href="/admin/icons/sprite.svg#eye-open"></use></svg>
                  </button>
                </td>
                <td class="col-delete col-align-center">
                  <button class="btn-delete" onclick="deleteMember(<%= m.id %>, '<%= m.name.replace(/'/g, "\\'") %>')" title="<%= t('common.tooltip_delete') %>">
                    <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="15" y1="9" x2="9" y2="15"/>
                      <line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
      </div><!-- /.table-scroll -->
    </div>

  </div><!-- /.dash-tab-panel -->
  </main>
</div>

<!-- ── View Member Modal ───────────────────────────────────────────────────── -->
<div id="gcViewModal" class="modal-overlay hidden">
  <div class="modal modal--lg" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 id="gcViewName" class="modal__title">—</h3>
      <button onclick="closeModal('gcViewModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body modal__body--view">

      <div class="gc-view-hero">
        <div class="gc-view-avatar" id="gcViewAvatar"></div>
        <div class="gc-view-meta">
          <span class="gc-view-number" id="gcViewNumber">GC-000</span>
          <div class="gc-view-badges" id="gcViewBadges"></div>
        </div>
        <label class="smb-avail-switch" onclick="gcToggleActive(event)">
          <input type="checkbox" id="gcViewActiveCheck" tabindex="-1" />
          <span class="smb-avail-label smb-avail-label--off" id="gcViewActiveLabel"><%= t('page.gc.members.inactive_label') %></span>
        </label>
        <label class="smb-avail-switch" onclick="gcToggleConsent(event)">
          <input type="checkbox" id="gcViewConsentCheck" tabindex="-1" />
          <span class="smb-avail-label smb-avail-label--off" id="gcViewConsentLabel"><%= t('common.no_consent') %></span>
        </label>
      </div>

      <div class="gc-view-details">
        <div class="gc-view-detail-row">
          <span class="form-label"><%= t('page.gc.members.label_email') %></span>
          <span id="gcViewEmail" class="gc-view-detail-val">—</span>
        </div>
        <div class="gc-view-detail-row">
          <span class="form-label"><%= t('page.gc.members.label_phone') %></span>
          <span id="gcViewPhone" class="gc-view-detail-val">—</span>
        </div>
        <div class="gc-view-detail-row">
          <span class="form-label"><%= t('page.gc.members.label_birthday') %></span>
          <span id="gcViewBirthday" class="gc-view-detail-val">—</span>
        </div>
        <div class="gc-view-detail-row">
          <span class="form-label"><%= t('page.gc.members.label_joined') %></span>
          <span id="gcViewJoined" class="gc-view-detail-val">—</span>
        </div>
        <div class="gc-view-detail-row">
          <span class="form-label"><%= t('page.gc.members.label_source') %></span>
          <span id="gcViewSource" class="gc-view-detail-val">—</span>
        </div>
        <div class="gc-view-detail-row hidden" id="gcViewNotesRow">
          <span class="form-label"><%= t('page.gc.members.label_notes') %></span>
          <span id="gcViewNotes" class="gc-view-detail-val view-section__value--muted"></span>
        </div>
      </div>

      <div class="gc-view-visits">
        <div class="gc-view-visits__head">
          <h4 class="gc-view-visits__title"><%= t('page.gc.members.visit_history') %></h4>
          <span class="gc-visit-count" id="gcViewVisitCount">0</span>
        </div>
        <div id="gcViewVisitList" class="gc-visit-list">
          <p class="gc-visit-list__empty"><%= t('page.gc.members.no_visits') %></p>
        </div>
        <div class="gc-log-form">
          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="gcLogDate"><%= t('common.date') %> <span class="form-required">*</span></label>
              <input type="date" id="gcLogDate" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label" for="gcLogNotes"><%= t('common.notes') %></label>
              <input type="text" id="gcLogNotes" class="form-input" placeholder="<%= t('page.gc.members.placeholder_visit_note') %>" />
            </div>
          </div>
          <button type="button" class="btn btn--pill btn--outline-brand btn--sm" onclick="gcLogVisit()"><%= t('page.gc.members.btn_log_visit') %></button>
        </div>
      </div>

    </div>
    <div class="modal__footer">
      <button type="button" class="btn btn--secondary" onclick="closeModal('gcViewModal')"><%= t('page.gc.members.btn_close') %></button>
      <button type="button" class="btn btn--primary" onclick="openGcEdit()"><%= t('page.gc.members.btn_edit_member') %></button>
    </div>
  </div>
</div>

<!-- ── Edit Member Modal ───────────────────────────────────────────────────── -->
<div id="gcEditModal" class="modal-overlay hidden">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal__header">
      <h3 class="modal__title"><%= t('page.gc.members.modal_edit_title') %></h3>
      <button onclick="closeModal('gcEditModal')" class="modal__close">&times;</button>
    </div>
    <div class="modal__body">
      <input type="hidden" id="gcEditId" />
      <div class="form-group">
        <label class="form-label" for="gcEditName"><%= t('page.gc.members.label_name') %> <span class="form-required">*</span></label>
        <input type="text" id="gcEditName" class="form-input" />
      </div>
      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label" for="gcEditEmail"><%= t('page.gc.members.label_email') %></label>
          <input type="email" id="gcEditEmail" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label" for="gcEditPhone"><%= t('page.gc.members.label_phone') %></label>
          <input type="tel" id="gcEditPhone" class="form-input" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label"><%= t('page.gc.members.label_birthday') %></label>
        <div class="gc-birthday">
          <select id="gcEditBirthdayMonth" class="form-select">
            <option value=""><%= t('page.gc.members.label_month') %></option>
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
          </select>
          <select id="gcEditBirthdayDay" class="form-select">
            <option value=""><%= t('page.gc.members.label_day') %></option>
            <% for (let d = 1; d <= 31; d++) { %>
              <option value="<%= d %>"><%= d %></option>
            <% } %>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="gcEditNotes"><%= t('page.gc.members.label_notes') %></label>
        <textarea id="gcEditNotes" class="form-textarea" rows="2"></textarea>
      </div>
      <label class="form-check">
        <input type="checkbox" id="gcEditConsent" />
        <span class="form-check__label"><%= t('page.gc.members.label_marketing_consent') %></span>
      </label>
      <label class="form-check">
        <input type="checkbox" id="gcEditActive" />
        <span class="form-check__label"><%= t('page.gc.members.label_active_member') %></span>
      </label>
    </div>
    <div class="modal__footer">
      <button type="button" class="btn btn--secondary" onclick="closeModal('gcEditModal')"><%= t('modal.btn_cancel') %></button>
      <button type="button" class="btn btn--primary" onclick="saveGcEdit()"><%= t('modal.btn_save_changes') %></button>
    </div>
  </div>
</div>

<!-- ── Paper Form Lightbox ────────────────────────────────────────────────── -->
<div id="paperLightbox" class="lightbox hidden" onclick="closePaperLightbox()">
  <img id="paperLightboxImg" src="" alt="" class="lightbox__img" onclick="event.stopPropagation()" />
  <button class="lightbox__close" onclick="closePaperLightbox()">&times;</button>
</div>

<%- include('../partials/scripts') %>
<script>
  const MEMBERS_DATA = <%- JSON.stringify(members) %>;
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  let gcCurrentMemberId = null;

  // ── Advanced section toggle ──────────────────────────────────────────────────
  function toggleAdvanced() {
    const panel   = document.getElementById('gcAdvanced');
    const chevron = document.getElementById('gcAdvancedChevron');
    const open    = panel.classList.toggle('gc-advanced--open');
    chevron.classList.toggle('gc-advanced-toggle__chevron--open', open);
  }

  // ── Filter bar ───────────────────────────────────────────────────────────────
  function toggleFilterBar() {
    const bar    = document.getElementById('filterBar');
    const toggle = document.getElementById('filterToggle');
    const open   = bar.classList.toggle('filter-bar--open');
    toggle.classList.toggle('filter-toggle--active', open);
    if (open) document.getElementById('searchInput')?.focus();
  }

  function filterMembers() {
    const q      = document.getElementById('searchInput').value.toLowerCase();
    const status = document.querySelector('input[name="statusFilter"]:checked')?.value || 'all';
    const rows   = document.querySelectorAll('#membersBody .item-row');
    let visible  = 0;
    rows.forEach(row => {
      const matchSearch = !q ||
        row.dataset.name.includes(q)  ||
        row.dataset.email.includes(q) ||
        row.dataset.phone.includes(q);
      const isActive    = row.dataset.active === 'true';
      const matchStatus = status === 'all' || (status === 'active' && isActive) || (status === 'inactive' && !isActive);
      const show = matchSearch && matchStatus;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    const countEl = document.getElementById('memberCount');
    if (countEl) countEl.textContent = `${visible} of ${rows.length}`;
  }

  (function initCount() {
    const rows    = document.querySelectorAll('#membersBody .item-row');
    const countEl = document.getElementById('memberCount');
    if (countEl && rows.length) countEl.textContent = `${rows.length} of ${rows.length}`;
  })();

  // ── Add member ───────────────────────────────────────────────────────────────
  async function addMember() {
    const name = document.getElementById('gcName').value.trim();
    if (!name) { showToast(tr('name_required'), 'error'); return; }
    const body = {
      name,
      email:             document.getElementById('gcEmail').value.trim()  || null,
      phone:             document.getElementById('gcPhone').value.trim()  || null,
      marketing_consent: document.getElementById('gcConsent').checked,
      birthday_month:    document.getElementById('gcBirthdayMonth').value || null,
      birthday_day:      document.getElementById('gcBirthdayDay').value   || null,
      notes:             document.getElementById('gcNotes').value.trim()  || null,
    };
    try {
      await api('POST', '/api/gourmet-club/members', body);
      showToast(tr('member_added'));
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  // ── Toggle consent (table row) ────────────────────────────────────────────────
  async function toggleConsent(id, current) {
    try {
      await api('PUT', `/api/gourmet-club/members/${id}`, { marketing_consent: !current });
      const m = MEMBERS_DATA.find(x => x.id === id);
      if (m) m.marketing_consent = !current;
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  // ── Delete member ─────────────────────────────────────────────────────────────
  async function deleteMember(id, name) {
    if (!confirm(`Delete member "${name}"? This cannot be undone.`)) return;
    try {
      await api('DELETE', `/api/gourmet-club/members/${id}`);
      showToast(tr('member_deleted'));
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  // ── View member modal ─────────────────────────────────────────────────────────
  function openGcView(id) {
    const m = MEMBERS_DATA.find(x => x.id === id);
    if (!m) return;
    gcCurrentMemberId = id;

    document.getElementById('gcViewName').textContent  = m.name;
    document.getElementById('gcViewNumber').textContent = `GC-${String(m.id).padStart(3, '0')}`;
    document.getElementById('gcViewAvatar').textContent = m.name.charAt(0).toUpperCase();

    document.getElementById('gcViewBadges').innerHTML = m.marketing_consent
      ? `<span class="gc-badge gc-badge--consent">${tUI('common.consented')}</span>`
      : `<span class="gc-badge gc-badge--muted">${tUI('common.no_consent')}</span>`;

    const check = document.getElementById('gcViewActiveCheck');
    const label = document.getElementById('gcViewActiveLabel');
    check.checked     = m.is_active;
    label.textContent = m.is_active ? tUI('page.gc.members.active_label') : tUI('page.gc.members.inactive_label');
    label.className   = `smb-avail-label ${m.is_active ? 'smb-avail-label--on' : 'smb-avail-label--off'}`;

    const consentCheck = document.getElementById('gcViewConsentCheck');
    const consentLabel = document.getElementById('gcViewConsentLabel');
    consentCheck.checked     = m.marketing_consent;
    consentLabel.textContent = m.marketing_consent ? tUI('common.consent') : tUI('common.no_consent');
    consentLabel.className   = `smb-avail-label ${m.marketing_consent ? 'smb-avail-label--on' : 'smb-avail-label--off'}`;

    document.getElementById('gcViewEmail').innerHTML = m.email
      ? `<a href="mailto:${esc(m.email)}" class="table-link">${esc(m.email)}</a>`
      : '<span class="cell-empty">—</span>';
    document.getElementById('gcViewPhone').textContent    = m.phone || '—';
    document.getElementById('gcViewBirthday').textContent = (m.birthday_month && m.birthday_day)
      ? `${MONTHS[m.birthday_month - 1]} ${m.birthday_day}` : '—';
    document.getElementById('gcViewJoined').textContent   =
      new Date(m.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    document.getElementById('gcViewSource').textContent   =
      ({ admin: tUI('page.gc.members.source_admin'), qr_menu: tUI('page.gc.members.source_qr'), reservation: tUI('page.gc.members.source_reservation') })[m.source] || m.source || '—';

    const notesRow = document.getElementById('gcViewNotesRow');
    if (m.notes) {
      document.getElementById('gcViewNotes').textContent = m.notes;
      notesRow.classList.remove('hidden');
    } else {
      notesRow.classList.add('hidden');
    }

    document.getElementById('gcLogDate').value  = new Date().toISOString().slice(0, 10);
    document.getElementById('gcLogNotes').value = '';

    loadGcVisits(id);
    openModal('gcViewModal');
  }

  async function loadGcVisits(id) {
    const list    = document.getElementById('gcViewVisitList');
    const countEl = document.getElementById('gcViewVisitCount');
    list.innerHTML = `<p class="gc-visit-list__empty">${tUI('common.loading')}</p>`;
    try {
      const res    = await api('GET', `/api/gourmet-club/members/${id}/visits`);
      const visits = res.data.visits;
      countEl.textContent = visits.length;
      if (visits.length === 0) {
        list.innerHTML = `<p class="gc-visit-list__empty">${tUI('page.gc.members.no_visits')}</p>`;
      } else {
        list.innerHTML = visits.map(v => `
          <div class="gc-visit-item" data-id="${v.id}">
            <span class="gc-visit-item__date">${new Date(v.date + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
            ${v.notes ? `<span class="gc-visit-item__notes">${esc(v.notes)}</span>` : ''}
            ${v.user  ? `<span class="gc-visit-item__by">by ${esc(v.user.name)}</span>` : ''}
            <button class="btn-delete gc-visit-item__del" onclick="gcDeleteVisit(${v.id})" title="${tUI('common.tooltip_remove')}">
              <svg class="icon icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </button>
          </div>
        `).join('');
      }
    } catch {
      list.innerHTML = `<p class="gc-visit-list__empty">${tUI('modal.failed_load_visits')}</p>`;
    }
  }

  async function gcLogVisit() {
    const date  = document.getElementById('gcLogDate').value;
    const notes = document.getElementById('gcLogNotes').value.trim();
    if (!date) { showToast(tr('error_select_date'), 'error'); return; }
    if (!gcCurrentMemberId) return;
    try {
      await api('POST', `/api/gourmet-club/members/${gcCurrentMemberId}/visits`, { date, notes: notes || null });
      showToast(tr('visit_added'));
      document.getElementById('gcLogNotes').value = '';
      const row = document.querySelector(`#membersBody tr[data-id="${gcCurrentMemberId}"]`);
      if (row) {
        const el = row.querySelector('.gc-visit-count');
        if (el) el.textContent = (parseInt(el.textContent, 10) || 0) + 1;
      }
      loadGcVisits(gcCurrentMemberId);
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function gcDeleteVisit(visitId) {
    if (!confirm(tUI('modal.confirm_delete'))) return;
    try {
      await api('DELETE', `/api/gourmet-club/visits/${visitId}`);
      showToast(tr('visit_deleted'));
      const row = document.querySelector(`#membersBody tr[data-id="${gcCurrentMemberId}"]`);
      if (row) {
        const el = row.querySelector('.gc-visit-count');
        if (el) el.textContent = Math.max(0, (parseInt(el.textContent, 10) || 0) - 1);
      }
      loadGcVisits(gcCurrentMemberId);
    } catch (err) { showToast(err.message, 'error'); }
  }

  async function gcToggleActive(event) {
    event.preventDefault();
    const m = MEMBERS_DATA.find(x => x.id === gcCurrentMemberId);
    if (!m) return;
    const newVal = !m.is_active;
    try {
      await api('PUT', `/api/gourmet-club/members/${gcCurrentMemberId}`, { is_active: newVal });
      m.is_active = newVal;
      const check = document.getElementById('gcViewActiveCheck');
      const label = document.getElementById('gcViewActiveLabel');
      check.checked     = newVal;
      label.textContent = newVal ? tUI('page.gc.members.active_label') : tUI('page.gc.members.inactive_label');
      label.className   = `smb-avail-label ${newVal ? 'smb-avail-label--on' : 'smb-avail-label--off'}`;
      const row = document.querySelector(`#membersBody tr[data-id="${gcCurrentMemberId}"]`);
      if (row) row.dataset.active = String(newVal);
      showToast(tr(newVal ? 'member_activated' : 'member_deactivated'));
    } catch (err) { showToast(err.message, 'error'); }
  }

  function gcToggleAddConsent(event) {
    event.preventDefault();
    const check = document.getElementById('gcConsent');
    const label = document.getElementById('gcConsentLabel');
    check.checked     = !check.checked;
    label.textContent = check.checked ? tUI('common.consent') : tUI('common.no_consent');
    label.className   = `smb-avail-label ${check.checked ? 'smb-avail-label--on' : 'smb-avail-label--off'}`;
  }

  async function gcToggleConsent(event) {
    event.preventDefault();
    const m = MEMBERS_DATA.find(x => x.id === gcCurrentMemberId);
    if (!m) return;
    const newVal = !m.marketing_consent;
    try {
      await api('PUT', `/api/gourmet-club/members/${gcCurrentMemberId}`, { marketing_consent: newVal });
      m.marketing_consent = newVal;
      const check = document.getElementById('gcViewConsentCheck');
      const label = document.getElementById('gcViewConsentLabel');
      check.checked     = newVal;
      label.textContent = newVal ? tUI('common.consent') : tUI('common.no_consent');
      label.className   = `smb-avail-label ${newVal ? 'smb-avail-label--on' : 'smb-avail-label--off'}`;
      document.getElementById('gcViewBadges').innerHTML = newVal
        ? `<span class="gc-badge gc-badge--consent">${tUI('common.consented')}</span>`
        : `<span class="gc-badge gc-badge--muted">${tUI('common.no_consent')}</span>`;
      showToast(tr(newVal ? 'consent_granted' : 'consent_removed'));
    } catch (err) { showToast(err.message, 'error'); }
  }

  // ── Edit member modal ─────────────────────────────────────────────────────────
  function openGcEdit() {
    const m = MEMBERS_DATA.find(x => x.id === gcCurrentMemberId);
    if (!m) return;
    document.getElementById('gcEditId').value            = m.id;
    document.getElementById('gcEditName').value          = m.name;
    document.getElementById('gcEditEmail').value         = m.email          || '';
    document.getElementById('gcEditPhone').value         = m.phone          || '';
    document.getElementById('gcEditBirthdayMonth').value = m.birthday_month || '';
    document.getElementById('gcEditBirthdayDay').value   = m.birthday_day   || '';
    document.getElementById('gcEditNotes').value         = m.notes          || '';
    document.getElementById('gcEditConsent').checked     = m.marketing_consent;
    document.getElementById('gcEditActive').checked      = m.is_active;
    closeModal('gcViewModal');
    openModal('gcEditModal');
  }

  async function saveGcEdit() {
    const id   = parseInt(document.getElementById('gcEditId').value, 10);
    const name = document.getElementById('gcEditName').value.trim();
    if (!name) { showToast(tr('name_required'), 'error'); return; }
    const body = {
      name,
      email:             document.getElementById('gcEditEmail').value.trim() || null,
      phone:             document.getElementById('gcEditPhone').value.trim() || null,
      birthday_month:    document.getElementById('gcEditBirthdayMonth').value || null,
      birthday_day:      document.getElementById('gcEditBirthdayDay').value   || null,
      notes:             document.getElementById('gcEditNotes').value.trim()  || null,
      marketing_consent: document.getElementById('gcEditConsent').checked,
      is_active:         document.getElementById('gcEditActive').checked,
    };
    try {
      await api('PUT', `/api/gourmet-club/members/${id}`, body);
      showToast(tr('member_updated'));
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  // ── Paper form upload ─────────────────────────────────────────────────────────
  async function uploadPaperForm(side, input) {
    const file = input.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('image', file);
    try {
      const res = await fetch(`/api/gourmet-club/paper-form/${side}`, { method: 'POST', body: fd });
      if (!res.ok) { const e = await res.json(); throw new Error(e.error || 'Upload failed'); }
      showToast(`Form ${side} uploaded`);
      reloadAfter();
    } catch (err) { showToast(err.message, 'error'); }
  }

  // ── Paper form lightbox ───────────────────────────────────────────────────────
  function openPaperLightbox(src) {
    document.getElementById('paperLightboxImg').src = src;
    document.getElementById('paperLightbox').classList.remove('hidden');
  }
  function closePaperLightbox() {
    document.getElementById('paperLightbox').classList.add('hidden');
    document.getElementById('paperLightboxImg').src = '';
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePaperLightbox(); });
</script>

</body>
</html>
