<div id="infoModal" class="info-modal" role="dialog" aria-labelledby="infoModalTitle" aria-hidden="true">
  <div class="info-modal-overlay" data-close-modal></div>
  <div class="info-modal-content">
    <div class="info-modal-header">
      <h3 id="infoModalTitle" class="info-modal-title"></h3>
      <button type="button" class="info-modal-close" data-close-modal aria-label="Close">
        <svg class="icon">
          <use href="/customer/icons/sprite.svg#close"></use>
        </svg>
      </button>
    </div>
    <div class="info-modal-body">
      <div class="info-modal-section" id="dietarySection" style="display: none;">
        <h4 class="info-modal-section-title"><%= mt('info.dietary_title') %></h4>
        <div class="info-modal-tags" id="dietaryTags"></div>
      </div>
      <div class="info-modal-section" id="allergenSection" style="display: none;">
        <h4 class="info-modal-section-title"><%= mt('info.allergens_title') %></h4>
        <div class="info-modal-tags" id="allergenTags"></div>
      </div>
      <div id="noInfoMessage" style="display: none;">
        <p class="info-modal-empty"><%= mt('info.no_info') %></p>
      </div>
    </div>
  </div>
</div>
